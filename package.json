{
  "name": "fazendinha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:server": "pnpm --filter rionovo-server run dev",
    "dev:client": "pnpm --filter rionovo-client run dev",
    "build": "pnpm -r run build",
    "prisma:generate": "pnpm --filter rionovo-server run prisma:generate",
    "prisma:migrate": "pnpm --filter rionovo-server run prisma:migrate",
    "prisma:studio": "pnpm --filter rionovo-server run prisma:studio",
    "gen:nav-doc": "pnpm --filter rionovo-server exec tsx ../scripts/gen-nav-doc.ts",
    "db:local:up": "docker compose up -d postgres",
    "db:local:down": "docker compose down",
    "cf:build": "pnpm --filter rionovo-client run build",
    "cf:dev": "pnpm cf:build && wrangler dev",
    "cf:deploy": "pnpm cf:build && wrangler deploy"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd"]
  }
}
