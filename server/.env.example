# Cole aqui a connection string do projeto Neon (formato pooled recomendado).
# Exemplo: postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/rionovo?sslmode=require
#
# Alternativa sem depender de conta Neon: suba o Postgres local do
# docker-compose.yml (`pnpm db:local:up`, na raiz) e use:
#   DATABASE_URL="postgresql://fazendinha:fazendinha@localhost:54332/fazendinha_seedatev3"
# db.ts escolhe o driver do Prisma pelo runtime (server/src/lib/runtime.ts), não
# pela URL — local ou Neon funcionam do mesmo jeito em dev/testes (Node puro).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Conexão DIRETA (não-pooled), exigida por `prisma migrate dev` e `prisma db push`.
# No Neon: mesma URL sem o sufixo "-pooler" no host. Em dev local: igual à DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

PORT=41873

# Troque por uma string aleatória forte em produção.
JWT_SECRET="dev-secret-trocar-em-producao"

# --- Identidade Clerk / Google ---
# Publique a chave pública no client como VITE_CLERK_PUBLISHABLE_KEY.
# No Worker, configure estas chaves como secrets/variáveis do ambiente; não versione valores reais.
# CLERK_PUBLISHABLE_KEY="pk_..."
# CLERK_SECRET_KEY="sk_..."
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."
# Origens públicas permitidas, separadas por vírgula (obrigatório em produção).
# CLERK_AUTHORIZED_PARTIES="https://app.exemplo.com"

# --- Assistente de consulta do Terrano ---
# Consultas rápidas e guias não precisam de chave. Perguntas livres usam OpenAI.
# Configurar a chave não reativa o bot antigo nem o WhatsApp (featureFlags).
# Desative somente o novo canal com ASSISTENTE_CONSULTA_ENABLED=false.
ASSISTENTE_CONSULTA_ENABLED=true
# OPENAI_API_KEY="procure com o time"
# Modelo de menor preço por token compatível com o chat, verificado em 14/10/2026.
# Reavaliar antes da desativação anunciada do GPT-5 nano (11/12/2026).
OPENAI_MODEL="gpt-5-nano"
# Transcrição econômica; áudio vira texto revisável antes da consulta.
OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"

# Canal WhatsApp via Meta Cloud API (todos necessários para o webhook funcionar):
# WHATSAPP_VERIFY_TOKEN="procure com o time"
# WHATSAPP_ACCESS_TOKEN="procure com o time"
# WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# WHATSAPP_APP_SECRET="procure com o time"

# ───── Storage de documentos: Cloudflare R2 ─────
# Dados e credenciais do bucket. Procure com o time.
R2_ACCOUNT_ID="procure com o time"
R2_ACCESS_KEY_ID="procure com o time"
R2_SECRET_ACCESS_KEY="procure com o time"
R2_BUCKET_NOTAS="procure com o time"
# Prefixo obrigatório das chaves neste ambiente: dev, staging, prod ou test.
STORAGE_NAMESPACE="dev"

# --- Usuário interno inicial ---
# Usado pelo comando bootstrap:dono quando a tabela Usuario está vazia.
# Não executa automaticamente ao iniciar o servidor. O dono entra depois pelo
# Google com este mesmo e-mail, e o Clerk é vinculado na primeira sessão válida.
# AUTH_BOOTSTRAP_EMAIL="dono@example.test"
AUTH_BOOTSTRAP_NOME=Proprietário
