# Cole aqui a connection string do projeto Neon (formato pooled recomendado).
# Exemplo: postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/rionovo?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Conexão DIRETA (não-pooled), exigida por `prisma migrate dev` e `prisma db push`.
# No Neon: mesma URL sem o sufixo "-pooler" no host. Em dev local: igual à DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

PORT=41873

# Troque por uma string aleatória forte em produção.
JWT_SECRET="dev-secret-trocar-em-producao"

# --- OpenAI (provider único: bot + IA do rebanho) ---
# Sem a chave, o bot fica desligado e a IA do rebanho roda em "modo demonstração".
# OPENAI_API_KEY="sk-proj-..."
# OPENAI_MODEL="gpt-4o"

# Canal WhatsApp via Meta Cloud API (todos necessários para o webhook funcionar):
# WHATSAPP_VERIFY_TOKEN="uma-string-arbitraria-que-voce-inventa"
# WHATSAPP_ACCESS_TOKEN="EAAG... (token permanente da Meta)"
# WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# WHATSAPP_APP_SECRET="app-secret-do-app-meta (valida X-Hub-Signature-256)"

# Conexão SOMENTE-LEITURA (role Neon com GRANT SELECT) para a ferramenta consulta_sql.
# Sem ela, o escape hatch de SQL fica desabilitado; as ferramentas curadas seguem ok.
# DATABASE_URL_READONLY="postgresql://readonly_user:PASSWORD@HOST/DB?sslmode=require"

# ───── Storage de notas fiscais ─────
# "local" = grava em server/.uploads/ (dev sem nuvem).
# "r2"    = grava no bucket Cloudflare R2; exige as 4 chaves R2_ abaixo.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".uploads"
# Segredo HMAC para assinar URLs de download em modo local. Trocar em produção.
LOCAL_DOWNLOAD_SECRET="dev-local-download-secret-trocar-em-producao"

# Cloudflare R2 — provisionar conforme server/docs/r2-setup.md
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NOTAS=""

# Liga OCR via Tesseract.js (gratuito, roda em Node).
# Em dev mantenha "false" para evitar download de ~70MB de language data no primeiro uso.
OCR_ENABLED="false"
