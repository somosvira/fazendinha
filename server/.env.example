# Cole aqui a connection string do projeto Neon (formato pooled recomendado).
# Exemplo: postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/rionovo?sslmode=require
#
# Alternativa sem depender de conta Neon: suba o Postgres local do
# docker-compose.yml (`pnpm db:local:up`, na raiz) e use:
#   DATABASE_URL="postgresql://fazendinha:fazendinha@localhost:54332/fazendinha_seedatev3"
# db.ts escolhe o driver do Prisma pelo runtime (server/src/lib/runtime.ts), não
# pela URL — local ou Neon funcionam do mesmo jeito em dev/testes (Node puro).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Conexão DIRETA (não-pooled), exigida por `prisma migrate dev` e `prisma db push`.
# No Neon: mesma URL sem o sufixo "-pooler" no host. Em dev local: igual à DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

PORT=41873

# Troque por uma string aleatória forte em produção.
JWT_SECRET="dev-secret-trocar-em-producao"

# --- OpenAI (provider único: bot + IA do rebanho) ---
# Sem a chave, o bot fica desligado e a IA do rebanho roda em "modo demonstração".
# OPENAI_API_KEY="procure com o time"
# OPENAI_MODEL="gpt-4o"

# Canal WhatsApp via Meta Cloud API (todos necessários para o webhook funcionar):
# WHATSAPP_VERIFY_TOKEN="procure com o time"
# WHATSAPP_ACCESS_TOKEN="procure com o time"
# WHATSAPP_PHONE_NUMBER_ID="123456789012345"
# WHATSAPP_APP_SECRET="procure com o time"

# ───── Storage de documentos: Cloudflare R2 ─────
# Dados e credenciais do bucket. Procure com o time.
R2_ACCOUNT_ID="procure com o time"
R2_ACCESS_KEY_ID="procure com o time"
R2_SECRET_ACCESS_KEY="procure com o time"
R2_BUCKET_NOTAS="procure com o time"
# Prefixo obrigatório das chaves neste ambiente: dev, staging, prod ou test.
STORAGE_NAMESPACE="dev"

# --- Contas / login ---
# Cria o dono no primeiro boot (tabela Usuario vazia). Deixe vazio depois de criado.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_NOME=Proprietário
# Base p/ links de convite/reset (host sem esquema recebe https://; vazio = link relativo)
APP_BASE_URL=
AUTH_SESSAO_DIAS=30

# Em dev/teste, provider ausente ou "log" imprime o link no terminal.
# Em produção use Resend com domínio remetente verificado; "log" é rejeitado.
# AUTH_EMAIL_PROVIDER=log
# AUTH_EMAIL_PROVIDER=resend
# AUTH_EMAIL_FROM="Terrano <acesso@seu-dominio.com.br>"
# RESEND_API_KEY="procure com o time"
AUTH_RESET_RATE_WINDOW_MINUTES=15
AUTH_RESET_MAX_PER_EMAIL=3
AUTH_RESET_MAX_PER_IP=10
