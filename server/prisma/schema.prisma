// Modelo de dados — Sistema de Gestão Financeira Rio Novo
// Reproduz o relatório gerencial de fluxo de caixa (regime de CAIXA) da fazenda.
// situacao=LIQUIDADO alimenta o Realizado; ABERTO alimenta a Projeção.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Natureza {
  CREDITO // entrada (receita)
  DEBITO // saída (despesa)
}

enum Situacao {
  ABERTO // a vencer -> Projeção
  LIQUIDADO // realizado -> Resultado Operacional
  LIQUIDADO_PARCIAL
}

enum StatusValidacaoNF {
  PENDENTE
  VALIDA
  ATENCAO
  REJEITADA
}

enum StatusUploadPendente {
  AGUARDANDO
  CONFIRMADO
  CANCELADO
  EXPIRADO
}

enum StatusConfirmacaoWA {
  AGUARDANDO
  CONFIRMADA
  CANCELADA
  EXPIRADA
  ERRO_EXTRACAO
}

// Centro de custo: Atividade Leiteira, Plantio Café, e variantes de Investimento.
model CentroCusto {
  id             Int          @id @default(autoincrement())
  nome           String       @unique
  ehInvestimento Boolean      @default(false)
  ordem          Int          @default(0)
  lancamentos    Lancamento[]
  produtos       Produto[]
}

// Plano de contas gerencial: Grupo -> Categoria.
model GrupoCategoria {
  id         Int         @id @default(autoincrement())
  nome       String      @unique
  ordem      Int         @default(0)
  categorias Categoria[]
}

// Override gerencial da classificação de uma categoria (custeio × investimento).
// null = pendente (deriva da regra padrão); decidido pelo usuário no dashboard.
enum ClassificacaoCategoria {
  CUSTEIO
  INVESTIMENTO
}

model Categoria {
  id               Int                     @id @default(autoincrement())
  nome             String
  grupoCategoria   GrupoCategoria          @relation(fields: [grupoCategoriaId], references: [id])
  grupoCategoriaId Int
  classificacao    ClassificacaoCategoria?
  lancamentos      Lancamento[]
  produtos         Produto[]

  @@unique([grupoCategoriaId, nome])
}

model ContaBancaria {
  id           Int          @id @default(autoincrement())
  nome         String       @unique
  banco        String?
  saldoInicial Decimal      @default(0) @db.Decimal(14, 2)
  lancamentos  Lancamento[]
}

enum TipoProduto {
  MEDICAMENTO
  RACAO
  INSUMO
  MINERAL
  OUTRO
}

enum TipoPessoa {
  CLIENTE
  FORNECEDOR
  AMBOS
}

model Produto {
  id            Int                @id @default(autoincrement())
  nome          String             @unique
  tipo          TipoProduto        @default(INSUMO)
  unidade       String             @default("un")
  custoUnitario Decimal?           @db.Decimal(12, 2)
  carencia      Int?
  percentualMS  Decimal?           @db.Decimal(5, 2)
  estocavel     Boolean            @default(true)
  minimoEstoque Decimal?           @db.Decimal(12, 2)
  ativo         Boolean            @default(true)
  // Mapeamento contábil (ponte com o financeiro): default da categoria/centro de custo
  // que a compra (ENTRADA) deste produto deve lançar.
  categoria     Categoria?         @relation(fields: [categoriaId], references: [id])
  categoriaId   Int?
  centroCusto   CentroCusto?       @relation(fields: [centroCustoId], references: [id])
  centroCustoId Int?
  movimentos    MovimentoEstoque[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([tipo])
}

model ClienteFornecedor {
  id                Int                @id @default(autoincrement())
  nome              String             @unique
  documento         String?
  tipo              TipoPessoa         @default(FORNECEDOR)
  telefone          String?
  email             String?
  ativo             Boolean            @default(true)
  lancamentos       Lancamento[]
  movimentosEstoque MovimentoEstoque[]
}

// Meses contábeis fechados: lançamentos cuja data de caixa cai num mês fechado
// não podem ser criados/editados/excluídos.
model FechamentoMensal {
  id         Int      @id @default(autoincrement())
  ano        Int
  mes        Int // 1-12
  fechadoEm  DateTime @default(now())
  observacao String?

  @@unique([ano, mes])
}

model Lancamento {
  id              Int       @id @default(autoincrement())
  natureza        Natureza
  // valor sempre positivo; o sinal no relatório vem da natureza
  valor           Decimal   @db.Decimal(14, 2)
  dataCompetencia DateTime  @db.Date
  dataVencimento  DateTime  @db.Date
  dataLiquidacao  DateTime? @db.Date
  situacao        Situacao  @default(ABERTO)
  estornado       Boolean   @default(false)

  numeroDocumento String?
  numeroParcela   Int?
  totalParcelas   Int?
  descricao       String?

  categoria           Categoria          @relation(fields: [categoriaId], references: [id])
  categoriaId         Int
  centroCusto         CentroCusto        @relation(fields: [centroCustoId], references: [id])
  centroCustoId       Int
  contaBancaria       ContaBancaria?     @relation(fields: [contaBancariaId], references: [id])
  contaBancariaId     Int?
  clienteFornecedor   ClienteFornecedor? @relation(fields: [clienteFornecedorId], references: [id])
  clienteFornecedorId Int?
  // Movimento de estoque que gerou este lançamento (ponte compra→financeiro), se houver.
  movimentoEstoque    MovimentoEstoque?

  notasFiscais         NotaFiscalArquivo[]
  uploadsPendentes     NotaFiscalUploadPendente[]
  confirmacoesWhatsapp WhatsAppConfirmacaoPendente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([situacao, dataLiquidacao])
  @@index([situacao, dataVencimento])
  @@index([centroCustoId])
}

enum ModoProducao {
  ORDENHA
  TOTAL_DIARIO
  TANQUE_LOTE
}

// Configuração da fazenda (linha única / singleton).
model Configuracao {
  id           Int          @id @default(1)
  producaoModo ModoProducao @default(ORDENHA)
  // Preço médio do litro de leite recebido. Usado pra estimar receita por animal.
  // Quando NULL, o cálculo cai em fallback fixo no service (R$ 2,40/L).
  precoLeite   Decimal?     @db.Decimal(10, 4)
  atualizadoEm DateTime     @updatedAt
}

// Controle leiteiro por animal (modos ORDENHA / TOTAL_DIARIO).
model ControleLeiteiro {
  id        Int      @id @default(autoincrement())
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId  Int
  data      DateTime @db.Date
  peso1     Decimal? @db.Decimal(6, 2) // ordenha manhã
  peso2     Decimal? @db.Decimal(6, 2) // tarde
  peso3     Decimal? @db.Decimal(6, 2) // noite
  pesoTotal Decimal  @db.Decimal(6, 2) // total do dia (soma das ordenhas ou total diário)
  origem    String   @default("manual") // manual | integracao
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId, data])
}

// Produção por lote/tanque (modo TANQUE_LOTE) — per-animal vem por rateio.
model ProducaoLote {
  id        Int      @id @default(autoincrement())
  grupo     Grupo?   @relation(fields: [grupoId], references: [id])
  grupoId   Int? // null = tanque da fazenda inteira
  data      DateTime @db.Date
  litros    Decimal  @db.Decimal(10, 2)
  origem    String   @default("manual")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([grupoId, data])
  @@index([data])
}

enum SexoAnimal {
  F
  M
}

enum CategoriaAnimal {
  BEZERRA
  NOVILHA
  VACA
  BEZERRO
  TOURO
  CABRITA
  CABRA
  CABRITO
  BODE
}

enum StatusAnimal {
  ATIVO
  BAIXADO
}

enum StatusReprodutivo {
  PEV
  VAZIA
  INSEMINADA
  PRENHE
}

enum EspecieAnimal {
  BOVINO
  CAPRINO
}

model Raca {
  id      Int           @id @default(autoincrement())
  nome    String        @unique
  // Código curto usado na string de grau de sangue (ex.: HO = Holandês, GL = Girolando).
  codigo  String?       @unique
  especie EspecieAnimal @default(BOVINO)
  animais Animal[]
}

model Grupo {
  id                Int                @id @default(autoincrement())
  nome              String             @unique
  animais           Animal[]
  dieta             Dieta?             @relation(fields: [dietaId], references: [id])
  dietaId           Int?
  producoesLote     ProducaoLote[]
  movimentosEstoque MovimentoEstoque[]
}

model Dieta {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  descricao String?
  pb        Decimal? @db.Decimal(4, 1) // % proteína bruta
  edMcal    Decimal? @db.Decimal(4, 2) // energia (Mcal/kg)
  ativo     Boolean  @default(true)
  grupos    Grupo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Animal {
  id                  Int                 @id @default(autoincrement())
  numero              String              @unique
  nome                String?
  sexo                SexoAnimal
  categoria           CategoriaAnimal
  raca                Raca?               @relation(fields: [racaId], references: [id])
  racaId              Int?
  grauSangue          String?
  dataNascimento      DateTime?           @db.Date
  dataEntrada         DateTime            @db.Date
  brincoEletronico    String?
  sisbov              String?
  mae                 Animal?             @relation("Maternidade", fields: [maeId], references: [id])
  maeId               Int?
  pai                 Animal?             @relation("Paternidade", fields: [paiId], references: [id])
  paiId               Int?
  paiNome             String?
  filhosMae           Animal[]            @relation("Maternidade")
  filhosPai           Animal[]            @relation("Paternidade")
  grupo               Grupo?              @relation(fields: [grupoId], references: [id])
  grupoId             Int?
  setor               String?
  status              StatusAnimal        @default(ATIVO)
  dataBaixa           DateTime?           @db.Date
  motivoBaixa         String?
  resumo              ResumoAnimal?
  numPartosEntrada    Int                 @default(0)
  eventosReprodutivos EventoReprodutivo[]
  eventosSanitarios   EventoSanitario[]
  lactacoes           Lactacao[]
  controlesLeiteiros  ControleLeiteiro[]
  pesagens            Pesagem[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status])
  @@index([grupoId])
}

model ResumoAnimal {
  animal            Animal            @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId          Int               @id
  statusReprodutivo StatusReprodutivo @default(VAZIA)
  del               Int?
  ordemLactacao     Int?
  producaoMediaDia  Decimal?          @db.Decimal(6, 2)
  producao305       Int?
  producaoTendencia String?
  ccs               Int?
  ccsTendencia      String?
  ultimoDgData      DateTime?         @db.Date
  ultimoDgResultado String?
  iepProjetado      Int?
  diasGestacao      Int?
  previsaoSecagem   DateTime?         @db.Date
  atualizadoEm      DateTime          @updatedAt
}

enum TipoEventoReprodutivo {
  CIO
  INSEMINACAO
  DIAGNOSTICO
  PARTO
  SECAGEM
}

model EventoReprodutivo {
  id              Int                   @id @default(autoincrement())
  animal          Animal                @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId        Int
  tipo            TipoEventoReprodutivo
  data            DateTime              @db.Date
  observacao      String?
  reprodutor      String?
  protocolo       String?
  resultado       String?
  dtPartoPrevista DateTime?             @db.Date
  tipoParto       String?
  numCrias        Int?
  sexoCria        String?
  motivoSecagem   String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([animalId, data])
}

model Lactacao {
  id       Int       @id @default(autoincrement())
  animal   Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId Int
  numero   Int
  dtInicio DateTime  @db.Date
  dtFim    DateTime? @db.Date

  @@index([animalId])
}

// Pesagens corporais (Ideagri PESO) — peso e ganho médio diário (GMD) por data.
model Pesagem {
  id       Int      @id @default(autoincrement())
  animal   Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId Int
  data     DateTime @db.Date
  peso     Decimal  @db.Decimal(7, 2)
  gmd      Decimal? @db.Decimal(6, 3)

  @@index([animalId, data])
}

enum TipoEventoSanitario {
  OCORRENCIA
  APLICACAO
  EXAME
  MASTITE
  VACINA
}

model EventoSanitario {
  id               Int                 @id @default(autoincrement())
  animal           Animal              @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId         Int
  tipo             TipoEventoSanitario
  data             DateTime            @db.Date
  observacao       String?
  doenca           String?
  dtFim            DateTime?           @db.Date
  diasTratamento   Int?
  produto          String?
  dose             String?
  carencia         Int?
  loteProduto      String?
  ccs              Int?
  gordura          Decimal?            @db.Decimal(4, 2)
  proteina         Decimal?            @db.Decimal(4, 2)
  quarto           String?
  severidade       String?
  resultadoCultivo String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([animalId, data])
}

enum TipoMovimento {
  ENTRADA
  SAIDA
  AJUSTE
}

model MovimentoEstoque {
  id            Int                @id @default(autoincrement())
  produto       Produto            @relation(fields: [produtoId], references: [id])
  produtoId     Int
  tipo          TipoMovimento
  data          DateTime           @db.Date
  quantidade    Decimal            @db.Decimal(12, 2)
  custoUnitario Decimal            @db.Decimal(12, 2)
  valorTotal    Decimal            @db.Decimal(14, 2)
  grupo         Grupo?             @relation(fields: [grupoId], references: [id])
  grupoId       Int?
  fornecedor    ClienteFornecedor? @relation(fields: [fornecedorId], references: [id])
  fornecedorId  Int?
  // Lançamento financeiro gerado pela ENTRADA (compra), se houver (ponte compra→financeiro).
  lancamento    Lancamento?        @relation(fields: [lancamentoId], references: [id])
  lancamentoId  Int?               @unique
  observacao    String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([produtoId, data])
  @@index([tipo, data])
}

model NotaFiscalArquivo {
  id           Int        @id @default(autoincrement())
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  lancamentoId Int

  storageDriver String
  bucket        String?
  storageKey    String  @unique
  mimeType      String
  tamanhoBytes  Int
  sha256        String  @unique

  statusValidacao   StatusValidacaoNF @default(PENDENTE)
  mensagemValidacao String?
  ocrTexto          String?           @db.Text
  cnpjEmissor       String?
  chaveAcessoNfe    String?           @db.VarChar(44)

  criadoEm   DateTime  @default(now())
  validadoEm DateTime?

  @@index([lancamentoId, statusValidacao])
}

model NotaFiscalUploadPendente {
  id Int @id @default(autoincrement())

  storageDriver String
  bucket        String?
  storageKey    String  @unique
  sha256        String  @unique
  mimeType      String
  tamanhoBytes  Int

  ocrTexto String? @db.Text

  status       StatusUploadPendente @default(AGUARDANDO)
  lancamentoId Int?
  lancamento   Lancamento?          @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  criadoEm   DateTime  @default(now())
  expiraEm   DateTime
  decididoEm DateTime?

  @@index([status, expiraEm])
}

model WhatsAppConfirmacaoPendente {
  id Int @id @default(autoincrement())

  telefone   String
  jid        String
  mensagemId String

  storageDriver String
  bucket        String?
  storageKey    String
  sha256        String  @unique
  mimeType      String
  tamanhoBytes  Int

  dadosExtraidos Json
  modeloIa       String
  tokensInput    Int?
  tokensOutput   Int?

  status       StatusConfirmacaoWA @default(AGUARDANDO)
  lancamentoId Int?
  lancamento   Lancamento?         @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  criadoEm   DateTime  @default(now())
  expiraEm   DateTime
  decididoEm DateTime?

  @@index([telefone, status])
  @@index([status, expiraEm])
  @@index([mensagemId])
}

// =============================================================================
// MÓDULO CORTE — Gado de corte (cria-recria-terminação)
// =============================================================================
// A unidade primária é o LOTE (não a cabeça individual): manejo de gado de
// corte acontece por grupo. Cabeças individuais só são modeladas quando
// têm valor reprodutivo (matrizes/touros) — para os demais, o lote agrega
// peso médio + GMD + sanidade.
//
// Referencial: Embrapa Gado de Corte (Campo Grande/MS), Manual de Boas
// Práticas de Vacinação, cronograma 11 (calendário sanitário Sul de Minas),
// Cepea/B3 (preço da arroba). Decimais financeiros @db.Decimal(14,2); peso
// em kg @db.Decimal(7,2); percentuais @db.Decimal(5,2).
//
// Mesma regra de FechamentoMensal aplica: operações comerciais (venda) cuja
// data caia num mês fechado não podem ser editadas/excluídas.

enum CategoriaLote {
  VACA_MATRIZ
  TOURO
  BEZERRO_MAMA
  BEZERRA_MAMA
  BEZERRO_DESMAMA
  BEZERRA_DESMAMA
  GAROTE
  NOVILHA
  NOVILHO
  BOI_GORDO
  VACA_DESCARTE
}

enum FaseCiclo {
  CRIA
  RECRIA
  TERMINACAO
  REPRODUCAO
}

enum EstadoLote {
  ATIVO
  VENDIDO
  EXTINTO
}

enum EstadoPiquete {
  DISPONIVEL
  OCUPADO
  DESCANSO
  REFORMA
}

enum TipoSanitario {
  VACINA_AFTOSA
  VACINA_BRUCELOSE_B19
  VACINA_CLOSTRIDIOSE
  VACINA_RAIVA
  VACINA_CARBUNCULO
  VACINA_LEPTOSPIROSE
  VACINA_IBR_BVD
  VERMIFUGACAO_5811
  VERMIFUGACAO_ESTRATEGICA
  CONTROLE_CARRAPATO
  CONTROLE_MOSCA
  CONTROLE_BERNE
  MARCACAO
  DESCORNA
  CASTRACAO
  BRINCO_ELETRONICO
}

enum TipoSuplemento {
  MINERAL
  PROTEICO_SECA
  ENERGETICO_AGUAS
  RACAO_CONFINAMENTO
  SAL_BRANCO
}

enum TipoComercial {
  VENDA_ABATE
  VENDA_REPRODUCAO
  DESCARTE
  COMPRA
  TRANSFERENCIA_ATIVIDADE
}

enum MetodoPesagem {
  BALANCA_INDIVIDUAL
  BALANCA_LOTE
  FITA_TORACICA
  VISUAL_ESTIMADO
}

// Lote — unidade primária do gado de corte.
model LoteCorte {
  id                  Int                 @id @default(autoincrement())
  codigo              String              @unique
  nome                String
  categoria           CategoriaLote
  fase                FaseCiclo
  raca                String
  numCabecas          Int
  numCabecasEntrada   Int // mortalidade = (entrada - atual) / entrada
  dataFormacao        DateTime            @db.Date
  origem              String?
  piquete             Piquete?            @relation(fields: [piqueteId], references: [id])
  piqueteId           Int?
  estado              EstadoLote          @default(ATIVO)
  observacao          String?
  resumo              ResumoLote?
  pesagens            PesagemLote[]
  manejosSanitarios   ManejoSanitario[]
  suplementacoes      Suplementacao[]
  operacoesComerciais OperacaoComercial[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([estado])
  @@index([categoria, fase])
}

// Read-model pré-computado por lote.
model ResumoLote {
  lote                 LoteCorte @relation(fields: [loteId], references: [id], onDelete: Cascade)
  loteId               Int       @id
  pesoMedio            Decimal?  @db.Decimal(7, 2)
  pesoMedioEntrada     Decimal?  @db.Decimal(7, 2)
  gmd                  Decimal?  @db.Decimal(5, 3)
  gmdAcumulado         Decimal?  @db.Decimal(5, 3)
  ultimaPesagem        DateTime? @db.Date
  diasSemPesar         Int?
  ua                   Decimal?  @db.Decimal(8, 2)
  proximaVacina        String?
  proximoVermifugo     String?
  ultimoManejo         String?
  pesoAlvoVenda        Decimal?  @db.Decimal(7, 2)
  diasParaAlvo         Int?
  arrobasEstimadas     Decimal?  @db.Decimal(7, 2)
  mortalidadeAcumulada Decimal?  @db.Decimal(5, 2)
  proximaAcao          String?
  proximaAcaoEm        DateTime? @db.Date
  atualizadoEm         DateTime  @updatedAt
}

// Piquete = divisão física do pasto. Um lote ocupa um piquete por vez.
model Piquete {
  id            Int           @id @default(autoincrement())
  codigo        String        @unique
  nome          String
  capim         String // espécie + cultivar — armazenado como texto
  areaHa        Decimal       @db.Decimal(7, 2)
  lotacaoMaxUA  Decimal       @db.Decimal(6, 2)
  cercaTipo     String?
  ultimaReforma DateTime?     @db.Date
  estado        EstadoPiquete @default(DISPONIVEL)
  diasDescanso  Int?
  observacao    String?
  lotes         LoteCorte[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Pesagem do lote — KPI central do corte.
model PesagemLote {
  id             Int           @id @default(autoincrement())
  lote           LoteCorte     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  loteId         Int
  data           DateTime      @db.Date
  pesoMedio      Decimal       @db.Decimal(7, 2)
  numCabecas     Int
  pesoTotal      Decimal       @db.Decimal(10, 2)
  metodo         MetodoPesagem
  responsavel    String?
  observacao     String?
  gmdDesdeUltima Decimal?      @db.Decimal(5, 3)
  createdAt      DateTime      @default(now())

  @@index([loteId, data])
}

// Manejo sanitário aplicado ao lote inteiro (ou parcial).
model ManejoSanitario {
  id           Int           @id @default(autoincrement())
  lote         LoteCorte     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  loteId       Int
  data         DateTime      @db.Date
  tipo         TipoSanitario
  produto      String?
  doseMl       Decimal?      @db.Decimal(7, 2)
  numCabecas   Int
  responsavel  String?
  carenciaDias Int?
  proximaDose  DateTime?     @db.Date
  observacao   String?
  // Ponte financeira opcional — compra do produto pode gerar Lancamento.
  lancamentoId Int?          @unique
  createdAt    DateTime      @default(now())

  @@index([loteId, data])
  @@index([tipo, data])
}

// Suplementação por período. Pode coexistir mais de uma simultânea
// (ex.: mineral + proteico) — dataFim null = ainda ativa.
model Suplementacao {
  id                Int            @id @default(autoincrement())
  lote              LoteCorte      @relation(fields: [loteId], references: [id], onDelete: Cascade)
  loteId            Int
  dataInicio        DateTime       @db.Date
  dataFim           DateTime?      @db.Date
  tipo              TipoSuplemento
  produto           String
  consumoCabecaDiaG Decimal        @db.Decimal(8, 2)
  custoKg           Decimal?       @db.Decimal(7, 2)
  observacao        String?
  createdAt         DateTime       @default(now())

  @@index([loteId, dataInicio])
}

// Operação comercial — venda, descarte, compra, transferência.
model OperacaoComercial {
  id           Int           @id @default(autoincrement())
  lote         LoteCorte?    @relation(fields: [loteId], references: [id])
  loteId       Int?
  data         DateTime      @db.Date
  tipo         TipoComercial
  numCabecas   Int
  pesoMedio    Decimal       @db.Decimal(7, 2)
  pesoTotal    Decimal       @db.Decimal(10, 2)
  arrobas      Decimal?      @db.Decimal(8, 2)
  precoArroba  Decimal?      @db.Decimal(8, 2)
  receitaTotal Decimal?      @db.Decimal(14, 2)
  comprador    String?
  observacao   String?
  lancamentoId Int?          @unique
  createdAt    DateTime      @default(now())

  @@index([loteId, data])
  @@index([tipo, data])
}
