// Modelo de dados — Sistema de Gestão Financeira Rio Novo
// Reproduz o relatório gerencial de fluxo de caixa (regime de CAIXA) da fazenda.
// situacao=LIQUIDADO alimenta o Realizado; ABERTO alimenta a Projeção.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Natureza {
  CREDITO // entrada (receita)
  DEBITO // saída (despesa)
}

enum Situacao {
  ABERTO // a vencer -> Projeção
  LIQUIDADO // realizado -> Resultado Operacional
  LIQUIDADO_PARCIAL
}

enum StatusValidacaoNF {
  PENDENTE // aguardando validação assíncrona (OCR)
  VALIDA // bate >= 2 critérios (CNPJ, chave NFe, termos "NOTA FISCAL"/"DANFE"...)
  ATENCAO // bate 1 critério — registrado mas pede revisão humana
  REJEITADA // 0 critérios ou falhou validação síncrona
}

// Estados de uma confirmação pendente vinda do WhatsApp.
// Lançamento só é criado quando o usuário confirma — antes disso só a imagem
// está no storage e a extração da IA fica em JSON.
enum StatusConfirmacaoWA {
  AGUARDANDO    // esperando resposta do usuário no WhatsApp
  CONFIRMADA    // virou Lancamento
  CANCELADA     // usuário cancelou OU foi substituída por foto nova (override)
  EXPIRADA      // passou expiraEm sem resposta
  ERRO_EXTRACAO // Claude Vision falhou — sem cartão enviado
}

// Centro de custo: Atividade Leiteira, Plantio Café, e variantes de Investimento.
model CentroCusto {
  id            Int          @id @default(autoincrement())
  nome          String       @unique
  ehInvestimento Boolean     @default(false)
  ordem         Int          @default(0)
  lancamentos   Lancamento[]
}

// Plano de contas gerencial: Grupo -> Categoria.
model GrupoCategoria {
  id         Int         @id @default(autoincrement())
  nome       String      @unique
  ordem      Int         @default(0)
  categorias Categoria[]
}

model Categoria {
  id               Int            @id @default(autoincrement())
  nome             String
  grupoCategoria   GrupoCategoria @relation(fields: [grupoCategoriaId], references: [id])
  grupoCategoriaId Int
  lancamentos      Lancamento[]

  @@unique([grupoCategoriaId, nome])
}

model ContaBancaria {
  id           Int          @id @default(autoincrement())
  nome         String       @unique
  banco        String?
  saldoInicial Decimal      @default(0) @db.Decimal(14, 2)
  lancamentos  Lancamento[]
}

model ClienteFornecedor {
  id          Int          @id @default(autoincrement())
  nome        String       @unique
  documento   String?
  lancamentos Lancamento[]
}

// Meses contábeis fechados: lançamentos cuja data de caixa cai num mês fechado
// não podem ser criados/editados/excluídos.
model FechamentoMensal {
  id         Int      @id @default(autoincrement())
  ano        Int
  mes        Int // 1-12
  fechadoEm  DateTime @default(now())
  observacao String?

  @@unique([ano, mes])
}

model Lancamento {
  id              Int       @id @default(autoincrement())
  natureza        Natureza
  // valor sempre positivo; o sinal no relatório vem da natureza
  valor           Decimal   @db.Decimal(14, 2)
  dataCompetencia DateTime  @db.Date
  dataVencimento  DateTime  @db.Date
  dataLiquidacao  DateTime? @db.Date
  situacao        Situacao  @default(ABERTO)
  estornado       Boolean   @default(false)

  numeroDocumento String?
  numeroParcela   Int?
  totalParcelas   Int?
  descricao       String?

  categoria           Categoria          @relation(fields: [categoriaId], references: [id])
  categoriaId         Int
  centroCusto         CentroCusto        @relation(fields: [centroCustoId], references: [id])
  centroCustoId       Int
  contaBancaria       ContaBancaria?     @relation(fields: [contaBancariaId], references: [id])
  contaBancariaId     Int?
  clienteFornecedor   ClienteFornecedor? @relation(fields: [clienteFornecedorId], references: [id])
  clienteFornecedorId Int?

  notasFiscais         NotaFiscalArquivo[]
  confirmacoesWhatsapp WhatsAppConfirmacaoPendente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([situacao, dataLiquidacao])
  @@index([situacao, dataVencimento])
  @@index([centroCustoId])
}

// Anexos de nota fiscal (foto ou PDF) atrelados a um Lançamento.
// Relação 1-N para suportar DANFE+XML, complementares e re-uploads sem perder histórico.
// Storage físico em S3 (ou local em dev). Lifecycle tier-down: Standard -> IA -> Glacier IR -> Deep Archive.
model NotaFiscalArquivo {
  id           Int        @id @default(autoincrement())
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  lancamentoId Int

  // localização física
  storageDriver String // "r2" | "local"
  bucket        String?
  storageKey    String  @unique // ex.: notas/123/<sha256>.pdf
  mimeType      String
  tamanhoBytes  Int
  sha256        String  @unique // bloqueia duplicata global (mesmo arquivo subido 2x)

  // resultado da validação
  statusValidacao   StatusValidacaoNF @default(PENDENTE)
  mensagemValidacao String?
  ocrTexto          String?           @db.Text
  cnpjEmissor       String?
  chaveAcessoNfe    String?           @db.VarChar(44)

  criadoEm    DateTime  @default(now())
  validadoEm  DateTime?

  @@index([lancamentoId, statusValidacao])
}

// Fluxo do bot WhatsApp: foto recebida -> imagem persistida no storage + extração
// pela Claude Vision -> cartão de confirmação enviado -> usuário responde
// Confirmar/Cancelar -> vira (ou não) Lancamento.
//
// O Lancamento não é criado antecipadamente: categoriaId/centroCustoId são FKs
// obrigatórias e o "Ajustar" futuro seria mais limpo se o lançamento real só
// nasce após o "Confirmar". A imagem fica no storage com key "notas/_wa/<sha>.<ext>"
// até a confirmação; depois disso o NotaFiscalArquivo aponta pra essa mesma key.
model WhatsAppConfirmacaoPendente {
  id Int @id @default(autoincrement())

  telefone   String // E.164 sem "+" (ex.: "5532991234567")
  jid        String // remoteJid do Baileys (ex.: "5532991234567@s.whatsapp.net")
  mensagemId String // key.id da mensagem que trouxe a foto — idempotência

  // localização da imagem no storage (mesmo formato do NotaFiscalArquivo)
  storageDriver String
  bucket        String?
  storageKey    String
  sha256        String @unique
  mimeType      String
  tamanhoBytes  Int

  // resultado da Claude Vision: ExtracaoNF serializada
  dadosExtraidos Json
  modeloIa       String
  tokensInput    Int?
  tokensOutput   Int?

  status       StatusConfirmacaoWA @default(AGUARDANDO)
  lancamentoId Int?
  lancamento   Lancamento?         @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  criadoEm   DateTime  @default(now())
  expiraEm   DateTime
  decididoEm DateTime?

  @@index([telefone, status])
  @@index([status, expiraEm])
  @@index([mensagemId])
}
