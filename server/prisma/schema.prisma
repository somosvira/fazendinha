// Modelo de dados — Sistema de Gestão Financeira Rio Novo
// Reproduz o relatório gerencial de fluxo de caixa (regime de CAIXA) da fazenda.
// situacao=LIQUIDADO alimenta o Realizado; ABERTO alimenta a Projeção.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Natureza {
  CREDITO // entrada (receita)
  DEBITO // saída (despesa)
}

enum Situacao {
  ABERTO // a vencer -> Projeção
  LIQUIDADO // realizado -> Resultado Operacional
  LIQUIDADO_PARCIAL
}

enum StatusValidacaoNF {
  PENDENTE
  VALIDA
  ATENCAO
  REJEITADA
}

enum StatusUploadPendente {
  AGUARDANDO
  CONFIRMADO
  CANCELADO
  EXPIRADO
}

enum StatusConfirmacaoWA {
  AGUARDANDO
  CONFIRMADA
  CANCELADA
  EXPIRADA
  ERRO_EXTRACAO
}

// Centro de custo: Atividade Leiteira, Plantio Café, e variantes de Investimento.
model CentroCusto {
  id             Int          @id @default(autoincrement())
  nome           String       @unique
  ehInvestimento Boolean      @default(false)
  ordem          Int          @default(0)
  lancamentos    Lancamento[]
  produtos       Produto[]
  safras         Safra[]
}

// Plano de contas gerencial: Grupo -> Categoria.
model GrupoCategoria {
  id         Int         @id @default(autoincrement())
  nome       String      @unique
  ordem      Int         @default(0)
  categorias Categoria[]
}

// Override gerencial da classificação de uma categoria (custeio × investimento).
// null = pendente (deriva da regra padrão); decidido pelo usuário no dashboard.
enum ClassificacaoCategoria {
  CUSTEIO
  INVESTIMENTO
}

model Categoria {
  id               Int                     @id @default(autoincrement())
  nome             String
  grupoCategoria   GrupoCategoria          @relation(fields: [grupoCategoriaId], references: [id])
  grupoCategoriaId Int
  classificacao    ClassificacaoCategoria?
  lancamentos      Lancamento[]
  produtos         Produto[]

  @@unique([grupoCategoriaId, nome])
}

model ContaBancaria {
  id           Int          @id @default(autoincrement())
  nome         String       @unique
  banco        String?
  saldoInicial Decimal      @default(0) @db.Decimal(14, 2)
  lancamentos  Lancamento[]
}

enum TipoProduto {
  MEDICAMENTO
  RACAO
  INSUMO
  MINERAL
  OUTRO
}

// Setor operacional (atividade/centro produtivo) a que o produto pertence —
// dimensão SEPARADA da categoria/centro de custo contábil. Usada para filtrar e
// agrupar o estoque e refletir o custo por atividade. Espelha os módulos reais
// da fazenda (rebanho-leite / plantio-café / corte / cultivo-milho). GERAL =
// insumo compartilhado. Opcional: produto sem setor é exibido como GERAL.
enum SetorEstoque {
  LEITE
  CAFE
  CORTE
  MILHO
  GERAL
}

// Subtipo agrícola de um Produto usado no Plantio (café). Só preenchido nos
// insumos da lavoura; null nos produtos do rebanho. A aba Estoque do Plantio
// filtra Produto por este campo (não polui o estoque do rebanho).
enum TipoInsumoPlantio {
  FERTILIZANTE
  DEFENSIVO
  HERBICIDA
  CORRETIVO
  BIOLOGICO
  FOLIAR
  MUDA
  OUTRO
}

enum TipoPessoa {
  CLIENTE
  FORNECEDOR
  AMBOS
}

model Produto {
  id                 Int                     @id @default(autoincrement())
  nome               String                  @unique
  tipo               TipoProduto             @default(INSUMO)
  // Subtipo agrícola (só nos insumos do Plantio; null no rebanho).
  subtipoPlantio     TipoInsumoPlantio?
  unidade            String                  @default("un")
  custoUnitario      Decimal?                @db.Decimal(12, 2)
  carencia           Int?
  percentualMS       Decimal?                @db.Decimal(5, 2)
  estocavel          Boolean                 @default(true)
  minimoEstoque      Decimal?                @db.Decimal(12, 2)
  ativo              Boolean                 @default(true)
  // Setor operacional (Leite/Café/Corte/Milho/Geral) — dimensão SEPARADA da
  // categoria contábil abaixo. Null = não classificado (exibido como GERAL).
  setor              SetorEstoque?
  // Mapeamento contábil (ponte com o financeiro): default da categoria/centro de custo
  // que a compra (ENTRADA) deste produto deve lançar.
  categoria          Categoria?              @relation(fields: [categoriaId], references: [id])
  categoriaId        Int?
  centroCusto        CentroCusto?            @relation(fields: [centroCustoId], references: [id])
  centroCustoId      Int?
  movimentos         MovimentoEstoque[]
  eventosSanitarios  EventoSanitario[]
  dietaItens         DietaItem[]
  principiosAtivos   ProdutoPrincipioAtivo[]
  // Receita (ração formulada): itens onde este produto é a ração-mãe, e onde é ingrediente.
  composicao         ComposicaoProdutoItem[] @relation("ComposicaoDaRacao")
  usadoEmComposicoes ComposicaoProdutoItem[] @relation("IngredienteEmComposicao")
  lotes              LoteProduto[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([tipo])
}

// Um ingrediente da receita de um produto (ração formulada): produto-mãe → ingrediente + proporção.
// Espelha "Composição de produto" do IDEagri; mesmo padrão do ProdutoPrincipioAtivo (#174).
model ComposicaoProdutoItem {
  id            Int      @id @default(autoincrement())
  produto       Produto  @relation("ComposicaoDaRacao", fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId     Int
  ingrediente   Produto  @relation("IngredienteEmComposicao", fields: [ingredienteId], references: [id], onDelete: Cascade)
  ingredienteId Int
  proporcao     Decimal  @db.Decimal(6, 3) // % do ingrediente na receita
  createdAt     DateTime @default(now())

  @@unique([produtoId, ingredienteId])
  @@index([produtoId])
  @@index([ingredienteId])
}

// Local físico de armazenamento (galpão, farmácia…). Espelha "local de armazenamento" do IDEagri.
model LocalArmazenamento {
  id            Int           @id @default(autoincrement())
  nome          String
  ativo         Boolean       @default(true)
  lotes         LoteProduto[]
  propriedade   Propriedade?  @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([propriedadeId])
}

// Lote de um produto (código + validade + local). Cadastro/registro paralelo — NÃO é o razão de
// estoque (o saldo continua em MovimentoEstoque). Espelha "Lote de produto" do IDEagri.
model LoteProduto {
  id            Int                 @id @default(autoincrement())
  produto       Produto             @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId     Int
  codigo        String
  validade      DateTime?           @db.Date
  local         LocalArmazenamento? @relation(fields: [localId], references: [id])
  localId       Int?
  quantidade    Decimal?            @db.Decimal(12, 2)
  propriedade   Propriedade?        @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([produtoId])
  @@index([validade])
  @@index([localId])
  @@index([propriedadeId])
}

// Registro de chuva (pluviômetro) — mm por dia. Só o pluviômetro: sem estação meteorológica,
// sem API de clima, sem temperatura. Alimenta o acumulado mensal. Espelha "Clima / registro de
// chuva" (Análise) do IDEagri.
model RegistroChuva {
  id            Int          @id @default(autoincrement())
  data          DateTime     @db.Date
  mm            Decimal      @db.Decimal(6, 1) // milímetros de chuva no dia
  observacao    String?
  propriedade   Propriedade? @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([data])
  @@index([propriedadeId])
}

// Princípio ativo (fármaco) — catálogo. Base para carência/antibiótico: um medicamento é
// composto por um ou mais princípios ativos, e a carência efetiva do leite/carne deriva da
// composição. Espelha PRINCIPIOATIVO (665) do IDEagri.
model PrincipioAtivo {
  id                 Int                     @id @default(autoincrement())
  nome               String                  @unique
  ehAntibiotico      Boolean                 @default(false) // antibiótico → leite em carência não pode ser vendido
  carenciaLeiteHoras Int? // carência de leite sugerida (horas), quando conhecida
  carenciaCarneDias  Int? // carência de carne sugerida (dias), quando conhecida
  ativo              Boolean                 @default(true)
  produtos           ProdutoPrincipioAtivo[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([ehAntibiotico])
}

// Composição: quais princípios ativos um Produto (medicamento) contém. Join N:N com
// concentração opcional. Espelha PRODUTOPRINCIPIOATIVO (12445) do IDEagri.
model ProdutoPrincipioAtivo {
  id               Int            @id @default(autoincrement())
  produto          Produto        @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId        Int
  principioAtivo   PrincipioAtivo @relation(fields: [principioAtivoId], references: [id], onDelete: Cascade)
  principioAtivoId Int
  concentracao     String? // ex.: "150 mg/mL" — texto livre (a unidade varia por fármaco)
  createdAt        DateTime       @default(now())

  @@unique([produtoId, principioAtivoId])
  @@index([produtoId])
  @@index([principioAtivoId])
}

model ClienteFornecedor {
  id                Int                @id @default(autoincrement())
  nome              String             @unique
  documento         String?
  tipo              TipoPessoa         @default(FORNECEDOR)
  telefone          String?
  email             String?
  ativo             Boolean            @default(true)
  lancamentos       Lancamento[]
  movimentosEstoque MovimentoEstoque[]
}

// Meses contábeis fechados: lançamentos cuja data de caixa cai num mês fechado
// não podem ser criados/editados/excluídos.
model FechamentoMensal {
  id         Int      @id @default(autoincrement())
  ano        Int
  mes        Int // 1-12
  fechadoEm  DateTime @default(now())
  observacao String?

  @@unique([ano, mes])
}

model Lancamento {
  id              Int       @id @default(autoincrement())
  natureza        Natureza
  // valor sempre positivo; o sinal no relatório vem da natureza
  valor           Decimal   @db.Decimal(14, 2)
  dataCompetencia DateTime  @db.Date
  dataVencimento  DateTime  @db.Date
  dataLiquidacao  DateTime? @db.Date
  situacao        Situacao  @default(ABERTO)
  estornado       Boolean   @default(false)

  numeroDocumento String?
  numeroParcela   Int?
  totalParcelas   Int?
  descricao       String?

  categoria           Categoria          @relation(fields: [categoriaId], references: [id])
  categoriaId         Int
  centroCusto         CentroCusto        @relation(fields: [centroCustoId], references: [id])
  centroCustoId       Int
  contaBancaria       ContaBancaria?     @relation(fields: [contaBancariaId], references: [id])
  contaBancariaId     Int?
  clienteFornecedor   ClienteFornecedor? @relation(fields: [clienteFornecedorId], references: [id])
  clienteFornecedorId Int?
  // Escopo de propriedade (Fatia 3). Nullable + default principal. O plano de
  // contas segue compartilhado (tenant) — o consolidado sai de graça; a partição
  // por sítio permite custo/relatório por propriedade sem duplicar categorias.
  propriedade         Propriedade?       @relation(fields: [propriedadeId], references: [id])
  propriedadeId       Int?
  // Movimento de estoque que gerou este lançamento (ponte compra→financeiro), se houver.
  movimentoEstoque    MovimentoEstoque?

  notasFiscais         NotaFiscalArquivo[]
  uploadsPendentes     NotaFiscalUploadPendente[]
  confirmacoesWhatsapp WhatsAppConfirmacaoPendente[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([situacao, dataLiquidacao])
  @@index([situacao, dataVencimento])
  @@index([centroCustoId])
}

enum ModoProducao {
  ORDENHA
  TOTAL_DIARIO
  TANQUE_LOTE
}

// Configuração da fazenda (linha única / singleton).
model Configuracao {
  id           Int          @id @default(1)
  producaoModo ModoProducao @default(ORDENHA)
  // Preço médio do litro de leite recebido. Usado pra estimar receita por animal.
  // Quando NULL, o cálculo cai em fallback fixo no service (R$ 2,40/L).
  precoLeite   Decimal?     @db.Decimal(10, 4)
  atualizadoEm DateTime     @updatedAt
}

// Parâmetros de manejo do rebanho (metas Embrapa, referências de peso, produção
// mínima por categoria, regras de desmame). Modelo key/value: cada chave é um
// parâmetro; o serviço parametros.ts sabe interpretar cada uma.
//
// - valorNumero: valor efetivo aplicado (ou "ideal" nas metas com faixa dupla).
// - valorNumeroAceitavel: 2º threshold das metas Embrapa (semáforo amarelo).
// - referenciaNumero / referenciaNumeroAceitavel: valor original da Embrapa,
//   imutável, exibido junto do efetivo pra comparação.
// - modo: usado em parâmetros que suportam mais de uma regra (ex.: DESMAME_MODO
//   = "DIAS" | "PESO"). null nos demais.
// - direcao: só nas metas com semáforo — "maior_melhor" | "menor_melhor".
// - categoria: agrupador na UI (PRODUCAO, REPRODUCAO, MANEJO, SANITARIO, GESTAO).
model ParametroManejo {
  chave                     String   @id
  categoria                 String
  descricao                 String
  unidade                   String?
  valorNumero               Decimal? @db.Decimal(14, 4)
  valorNumeroAceitavel      Decimal? @db.Decimal(14, 4)
  valorTexto                String?
  modo                      String?
  direcao                   String?
  referenciaNumero          Decimal? @db.Decimal(14, 4)
  referenciaNumeroAceitavel Decimal? @db.Decimal(14, 4)
  ordem                     Int      @default(0)
  atualizadoEm              DateTime @updatedAt

  @@index([categoria, ordem])
}

// Controle leiteiro por animal (modos ORDENHA / TOTAL_DIARIO).
model ControleLeiteiro {
  id        Int      @id @default(autoincrement())
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId  Int
  data      DateTime @db.Date
  peso1     Decimal? @db.Decimal(6, 2) // ordenha manhã
  peso2     Decimal? @db.Decimal(6, 2) // tarde
  peso3     Decimal? @db.Decimal(6, 2) // noite
  pesoTotal Decimal  @db.Decimal(6, 2) // total do dia (soma das ordenhas ou total diário)
  origem    String   @default("manual") // manual | integracao
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId, data])
}

// Produção por lote/tanque (modo TANQUE_LOTE) — per-animal vem por rateio.
model ProducaoLote {
  id            Int          @id @default(autoincrement())
  grupo         Grupo?       @relation(fields: [grupoId], references: [id])
  grupoId       Int? // null = tanque da propriedade inteira
  propriedade   Propriedade? @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  data          DateTime     @db.Date
  litros        Decimal      @db.Decimal(10, 2)
  origem        String       @default("manual")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([grupoId, data])
  @@index([propriedadeId, data])
  @@index([data])
}

// Tanque de resfriamento (cadastro). Espelha "Tanque" do IDEagri.
model Tanque {
  id               Int             @id @default(autoincrement())
  nome             String
  capacidadeLitros Int?
  ativo            Boolean         @default(true)
  analises         AnaliseTanque[]
  propriedade      Propriedade?    @relation(fields: [propriedadeId], references: [id])
  propriedadeId    Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([propriedadeId])
}

// Análise de tanque (qualidade do leite bulk). Espelha "Análise de tanque" do IDEagri.
model AnaliseTanque {
  id          Int      @id @default(autoincrement())
  tanque      Tanque   @relation(fields: [tanqueId], references: [id], onDelete: Cascade)
  tanqueId    Int
  data        DateTime @db.Date
  ccs         Int? // células somáticas do tanque (mil/mL)
  cbt         Int? // contagem bacteriana total (mil UFC/mL)
  gordura     Decimal? @db.Decimal(4, 2)
  proteina    Decimal? @db.Decimal(4, 2)
  temperatura Decimal? @db.Decimal(4, 1) // °C na coleta
  observacao  String?
  createdAt   DateTime @default(now())

  @@index([tanqueId, data])
}

enum SexoAnimal {
  F
  M
}

enum CategoriaAnimal {
  BEZERRA
  NOVILHA
  VACA
  BEZERRO
  TOURO
  CABRITA
  CABRA
  CABRITO
  BODE
}

enum StatusAnimal {
  ATIVO
  BAIXADO
}

enum StatusReprodutivo {
  PEV
  VAZIA
  INSEMINADA
  PRENHE
}

enum EspecieAnimal {
  BOVINO
  CAPRINO
}

model Raca {
  id           Int           @id @default(autoincrement())
  nome         String        @unique
  // Código curto usado na string de grau de sangue (ex.: HO = Holandês, GL = Girolando).
  codigo       String?       @unique
  especie      EspecieAnimal @default(BOVINO)
  animais      Animal[]
  reprodutores Reprodutor[]
}

// Central de sêmen (origem do sêmen dos reprodutores). Espelha CENTRALSEMEN do IDEagri.
model CentralSemen {
  id            Int          @id @default(autoincrement())
  nome          String
  ativo         Boolean      @default(true)
  reprodutores  Reprodutor[]
  propriedade   Propriedade? @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propriedadeId])
}

// Biblioteca de reprodutores (touros) com origem e índices genéticos (PTAs). Espelha
// ANIMALINFO_REPRODUTOR + GENCATALOGOINDICADOR do IDEagri (índices operacionais como colunas).
model Reprodutor {
  id               Int                        @id @default(autoincrement())
  ideagriId        Int?                       @unique
  nome             String
  codigo           String? // registro/código do touro
  raca             Raca?                      @relation(fields: [racaId], references: [id])
  racaId           Int?
  centralSemen     CentralSemen?              @relation(fields: [centralSemenId], references: [id])
  centralSemenId   Int?
  ptaLeite         Decimal?                   @db.Decimal(8, 2) // PTA leite (kg)
  ptaGordura       Decimal?                   @db.Decimal(6, 2) // PTA gordura (kg ou %)
  ptaProteina      Decimal?                   @db.Decimal(6, 2) // PTA proteína
  tpi              Int? // índice composto (TPI/mérito líquido)
  ativo            Boolean                    @default(true)
  propriedade      Propriedade?               @relation(fields: [propriedadeId], references: [id])
  propriedadeId    Int?
  valoresIndicador ValorIndicadorReprodutor[]
  valoresMarcador  ValorMarcadorReprodutor[]
  valoresCaseina   ValorCaseinaReprodutor[]
  pedigree             PedigreeReprodutor?
  estoquesSemen        EstoqueSemen[]
  escolhasAcasalamento LinhaPlanoAcasalamento[]
  fertilizacoes        FertilizacaoColeta[]
  createdAt            DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([propriedadeId])
  @@index([racaId])
  @@index([centralSemenId])
}

// Catálogo genético flexível (GENCATALOGOINDICADOR do IDEAGRI, 271). Compartilhado entre
// propriedades. `colunaLegada` espelha siglas conhecidas nas colunas PTA de Reprodutor (retrocompat).
model IndicadorGenetico {
  id           Int                        @id @default(autoincrement())
  ideagriId    Int?                       @unique
  sigla        String                     @unique
  nome         String
  unidade      String?
  direcao      String                     @default("maior_melhor") // maior_melhor | menor_melhor
  colunaLegada String? // ptaLeite | ptaGordura | ptaProteina | tpi | null
  ranking      Boolean                    @default(false)
  ativo        Boolean                    @default(true)
  valores      ValorIndicadorReprodutor[]
  itensMedida  ItemMedidaAcasalamento[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

model ValorIndicadorReprodutor {
  id           Int               @id @default(autoincrement())
  reprodutor   Reprodutor        @relation(fields: [reprodutorId], references: [id], onDelete: Cascade)
  reprodutorId Int
  indicador    IndicadorGenetico @relation(fields: [indicadorId], references: [id], onDelete: Cascade)
  indicadorId  Int
  valor        Decimal           @db.Decimal(12, 3)

  @@unique([reprodutorId, indicadorId])
  @@index([indicadorId])
}

// Dicionário de marcadores genéticos (20). Compartilhado. Resultado por touro é texto (ex.: TT/TC/CC).
model MarcadorGenetico {
  id        Int                       @id @default(autoincrement())
  ideagriId Int?                      @unique
  sigla     String                    @unique
  nome      String
  valores   ValorMarcadorReprodutor[]
}

model ValorMarcadorReprodutor {
  id           Int              @id @default(autoincrement())
  reprodutor   Reprodutor       @relation(fields: [reprodutorId], references: [id], onDelete: Cascade)
  reprodutorId Int
  marcador     MarcadorGenetico @relation(fields: [marcadorId], references: [id], onDelete: Cascade)
  marcadorId   Int
  resultado    String

  @@unique([reprodutorId, marcadorId])
  @@index([marcadorId])
}

// Dicionário de variantes de caseína (15). Compartilhado. Genótipo por touro é texto (ex.: A2A2).
model Caseina {
  id        Int                      @id @default(autoincrement())
  ideagriId Int?                     @unique
  sigla     String                   @unique
  nome      String
  valores   ValorCaseinaReprodutor[]
}

model ValorCaseinaReprodutor {
  id           Int        @id @default(autoincrement())
  reprodutor   Reprodutor @relation(fields: [reprodutorId], references: [id], onDelete: Cascade)
  reprodutorId Int
  caseina      Caseina    @relation(fields: [caseinaId], references: [id], onDelete: Cascade)
  caseinaId    Int
  genotipo     String

  @@unique([reprodutorId, caseinaId])
  @@index([caseinaId])
}

// Pedigree do reprodutor (1:1). Genealogia textual (pai/mãe/avós), sem FK a Animal.
model PedigreeReprodutor {
  id               Int        @id @default(autoincrement())
  reprodutor       Reprodutor @relation(fields: [reprodutorId], references: [id], onDelete: Cascade)
  reprodutorId     Int        @unique
  ideagriId        Int?       @unique
  paiNome          String?
  paiCodigo        String?
  maeNome          String?
  maeCodigo        String?
  avoMaternoNome   String?
  avoMaternoCodigo String?
  avoPaternoNome   String?
  avoPaternoCodigo String?
}

// Dicionário de tipos de sêmen (3: convencional/sexado/etc.). Compartilhado.
model TipoSemen {
  id        Int            @id @default(autoincrement())
  ideagriId Int?           @unique
  sigla     String         @unique
  nome      String
  estoques  EstoqueSemen[]
}

// Estoque de doses de sêmen por reprodutor (fato de sítio). `dosesDisponiveis` nunca fica negativo.
model EstoqueSemen {
  id               Int                 @id @default(autoincrement())
  reprodutor       Reprodutor          @relation(fields: [reprodutorId], references: [id], onDelete: Cascade)
  reprodutorId     Int
  tipoSemen        TipoSemen?          @relation(fields: [tipoSemenId], references: [id], onDelete: SetNull)
  tipoSemenId      Int?
  lote             String?
  localizacao      String?
  dosesDisponiveis Int                 @default(0)
  ideagriId        Int?                @unique
  propriedade      Propriedade?        @relation(fields: [propriedadeId], references: [id], onDelete: SetNull)
  propriedadeId    Int?
  eventos          EventoReprodutivo[]
  fertilizacoes    FertilizacaoColeta[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([reprodutorId])
  @@index([tipoSemenId])
  @@index([propriedadeId])
}

model MedidaAcasalamento {
  id                  Int                       @id @default(autoincrement())
  ideagriId           Int?                      @unique
  nome                String                    @unique
  tipo                String
  consanguinidadeMax  Decimal?                  @db.Decimal(5, 4)
  exigePedigree       Boolean                   @default(false)
  ativo               Boolean                   @default(true)
  itens               ItemMedidaAcasalamento[]
  combinacoes         ItemCombinacaoMedida[]
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
}

model ItemMedidaAcasalamento {
  id          Int                 @id @default(autoincrement())
  medida      MedidaAcasalamento @relation(fields: [medidaId], references: [id], onDelete: Cascade)
  medidaId    Int
  indicador   IndicadorGenetico   @relation(fields: [indicadorId], references: [id])
  indicadorId Int
  peso        Decimal             @default(1) @db.Decimal(8, 4)
  minimo      Decimal?            @db.Decimal(12, 3)
  maximo      Decimal?            @db.Decimal(12, 3)

  @@unique([medidaId, indicadorId])
  @@index([indicadorId])
}

model CombinacaoMedidaAcasalamento {
  id        Int                      @id @default(autoincrement())
  ideagriId Int?                     @unique
  nome      String                   @unique
  ativo     Boolean                  @default(true)
  itens     ItemCombinacaoMedida[]
  planos    PlanoAcasalamento[]
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
}

model ItemCombinacaoMedida {
  id           Int                           @id @default(autoincrement())
  combinacao   CombinacaoMedidaAcasalamento @relation(fields: [combinacaoId], references: [id], onDelete: Cascade)
  combinacaoId Int
  medida       MedidaAcasalamento            @relation(fields: [medidaId], references: [id])
  medidaId     Int
  peso         Decimal                       @default(1) @db.Decimal(8, 4)
  obrigatoria  Boolean                       @default(false)
  ordem        Int                           @default(0)

  @@unique([combinacaoId, medidaId])
  @@index([medidaId])
}

model PlanoAcasalamento {
  id            Int                           @id @default(autoincrement())
  grupo         Grupo                         @relation(fields: [grupoId], references: [id])
  grupoId       Int
  combinacao    CombinacaoMedidaAcasalamento @relation(fields: [combinacaoId], references: [id])
  combinacaoId  Int
  nome          String
  propriedade   Propriedade?                  @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  versoes       VersaoPlanoAcasalamento[]
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  @@index([grupoId])
  @@index([combinacaoId])
  @@index([propriedadeId])
}

model VersaoPlanoAcasalamento {
  id             Int                      @id @default(autoincrement())
  plano          PlanoAcasalamento        @relation(fields: [planoId], references: [id], onDelete: Cascade)
  planoId        Int
  versao         Int
  configSnapshot Json
  linhas         LinhaPlanoAcasalamento[]
  createdAt      DateTime                 @default(now())

  @@unique([planoId, versao])
}

model LinhaPlanoAcasalamento {
  id                       Int                      @id @default(autoincrement())
  versao                   VersaoPlanoAcasalamento @relation(fields: [versaoId], references: [id], onDelete: Cascade)
  versaoId                 Int
  femea                    Animal                   @relation(fields: [femeaId], references: [id])
  femeaId                  Int
  rankingSnapshot          Json
  reprodutorEscolhido      Reprodutor?              @relation(fields: [reprodutorEscolhidoId], references: [id])
  reprodutorEscolhidoId    Int?
  confirmadoNaoVerificavel Boolean                  @default(false)

  @@unique([versaoId, femeaId])
  @@index([femeaId])
  @@index([reprodutorEscolhidoId])
}

// Dicionário oficial compartilhado das classificações de embrião do IDEAGRI.
model EmbriaoClassificacao {
  id        Int              @id @default(autoincrement())
  ideagriId Int?             @unique
  sigla     String           @unique
  nome      String
  ordem     Int              @default(0)
  ativo     Boolean          @default(true)
  embrioes  EmbriaoColeta[]
}

// Coleta FIV/TE por doadora. Fato de sítio; resultados ficam separados por animal.
model Coleta {
  id                 Int                     @id @default(autoincrement())
  ideagriId          Int?                    @unique
  doadora            Animal                  @relation("DoadoraColeta", fields: [doadoraId], references: [id], onDelete: Restrict)
  doadoraId          Int
  data               DateTime                @db.Date
  tecnico            String?
  metodo             String
  laboratorio        String?
  status             String                  @default("RASCUNHO")
  canceladaEm        DateTime?
  motivoCancelamento String?
  observacao         String?
  aplicacaoPool      AplicacaoPoolDoadora?   @relation(fields: [aplicacaoPoolId], references: [id], onDelete: SetNull)
  aplicacaoPoolId    Int?
  propriedade        Propriedade?            @relation(fields: [propriedadeId], references: [id], onDelete: SetNull)
  propriedadeId      Int?
  oocitos            OocitoColeta[]
  fertilizacoes      FertilizacaoColeta[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([doadoraId])
  @@index([propriedadeId])
  @@index([aplicacaoPoolId])
}

model OocitoColeta {
  id         Int     @id @default(autoincrement())
  coleta    Coleta  @relation(fields: [coletaId], references: [id], onDelete: Cascade)
  coletaId  Int
  qualidade String
  viavel    Boolean
  quantidade Int

  @@unique([coletaId, qualidade, viavel])
}

model FertilizacaoColeta {
  id                 Int              @id @default(autoincrement())
  ideagriId          Int?             @unique
  coleta             Coleta           @relation(fields: [coletaId], references: [id], onDelete: Cascade)
  coletaId           Int
  reprodutor         Reprodutor       @relation(fields: [reprodutorId], references: [id], onDelete: Restrict)
  reprodutorId       Int
  estoqueSemen       EstoqueSemen?    @relation(fields: [estoqueSemenId], references: [id], onDelete: SetNull)
  estoqueSemenId     Int?
  doseBaixada        Boolean          @default(false)
  data               DateTime?        @db.Date
  tecnica            String?
  status             String           @default("ATIVA")
  canceladaEm        DateTime?
  motivoCancelamento String?
  embrioes           EmbriaoColeta[]

  @@index([coletaId])
  @@index([reprodutorId])
  @@index([estoqueSemenId])
}

model EmbriaoColeta {
  id              Int                   @id @default(autoincrement())
  ideagriId       Int?                  @unique
  fertilizacao    FertilizacaoColeta    @relation(fields: [fertilizacaoId], references: [id], onDelete: Cascade)
  fertilizacaoId  Int
  classificacao   EmbriaoClassificacao? @relation(fields: [classificacaoId], references: [id], onDelete: SetNull)
  classificacaoId Int?
  codigoInterno   String?
  estagio         String?
  viavel          Boolean               @default(true)
  estado          String                @default("DISPONIVEL")
  propriedade     Propriedade?          @relation(fields: [propriedadeId], references: [id], onDelete: SetNull)
  propriedadeId   Int?
  evento          EventoReprodutivo?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([fertilizacaoId])
  @@index([classificacaoId])
  @@index([estado])
  @@index([propriedadeId])
}

model GrupoPoolDoadora {
  id            Int                    @id @default(autoincrement())
  ideagriId     Int?                   @unique
  nome          String
  ativo         Boolean                @default(true)
  propriedade   Propriedade?           @relation(fields: [propriedadeId], references: [id], onDelete: SetNull)
  propriedadeId Int?
  itens         ItemGrupoPoolDoadora[]
  aplicacoes    AplicacaoPoolDoadora[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([propriedadeId])
}

model ItemGrupoPoolDoadora {
  id        Int              @id @default(autoincrement())
  grupo     GrupoPoolDoadora @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  grupoId   Int
  doadora   Animal           @relation("DoadoraPool", fields: [doadoraId], references: [id], onDelete: Cascade)
  doadoraId Int
  ativo     Boolean          @default(true)

  @@unique([grupoId, doadoraId])
}

model AplicacaoPoolDoadora {
  id            Int              @id @default(autoincrement())
  grupo         GrupoPoolDoadora @relation(fields: [grupoId], references: [id], onDelete: Restrict)
  grupoId       Int
  data          DateTime         @db.Date
  tecnico       String?
  propriedade   Propriedade?     @relation(fields: [propriedadeId], references: [id], onDelete: SetNull)
  propriedadeId Int?
  coletas       Coleta[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([grupoId, data])
  @@index([grupoId])
  @@index([propriedadeId])
}

model Grupo {
  id                Int                   @id @default(autoincrement())
  nome              String                @unique
  animais           Animal[]
  dieta             Dieta?                @relation(fields: [dietaId], references: [id])
  dietaId           Int?
  propriedade       Propriedade?          @relation(fields: [propriedadeId], references: [id])
  propriedadeId     Int?
  producoesLote     ProducaoLote[]
  movimentosEstoque MovimentoEstoque[]
  consumosPeriodo    ConsumoPeriodo[]
  programacoesIATF   ProgramacaoIATFLote[]
  planosAcasalamento PlanoAcasalamento[]

  @@index([propriedadeId])
}

// Sítio físico da fazenda-cliente (multi-propriedade). Default single-tenant: 1
// linha (principal). O mesmo seam serve de base p/ multi-tenant (Organizacao) depois.
model Propriedade {
  id                   Int                           @id @default(autoincrement())
  nome                 String                        @unique
  apelido              String? // rótulo curto p/ o seletor ("Sede", "Recria")
  cidade               String?
  uf                   String?
  principal            Boolean                       @default(false) // a default quando não há filtro
  ativo                Boolean                       @default(true)
  ordem                Int                           @default(0)
  animais              Animal[]
  grupos               Grupo[]
  producoesLote        ProducaoLote[]
  movimentosEstoque    MovimentoEstoque[]
  lancamentos          Lancamento[]
  lotesCorte           LoteCorte[]
  piquetes             Piquete[]
  talhoes              Talhao[]
  lavouras             Lavoura[]
  funcionarios         Funcionario[]
  safrasCultivo        SafraCultivo[]
  silos                Silo[]
  caixinhas            Caixinha[]
  vacinasAgendadas     VacinaAgendada[]
  protocolosIATF       ProtocoloIATF[]
  aplicacoesIATF       AplicacaoProtocoloIATF[]
  programacoesIATF     ProgramacaoIATFLote[]
  movimentacoesAnimais MovimentacaoAnimal[]
  filtrosAnimais       FiltroAnimal[]
  tanques              Tanque[]
  protocolosSanitarios ProtocoloSanitario[]
  aplicacoesSanitarias AplicacaoProtocoloSanitario[]
  centraisSemen        CentralSemen[]
  reprodutores         Reprodutor[]
  estoquesSemen        EstoqueSemen[]
  locaisArmazenamento  LocalArmazenamento[]
  lotesProduto         LoteProduto[]
  examesQuarto         ExameQuarto[]
  registrosChuva       RegistroChuva[]
  aptidoes              AptidaoAnimal[]
  planosAcasalamento    PlanoAcasalamento[]
  modelosFormularioCampo ModeloFormularioCampo[]
  folhasCampo            FolhaCampo[]
  coletas               Coleta[]
  embrioesColeta        EmbriaoColeta[]
  gruposPoolDoadora     GrupoPoolDoadora[]
  aplicacoesPoolDoadora AplicacaoPoolDoadora[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
}

model Dieta {
  id              Int              @id @default(autoincrement())
  nome            String           @unique
  descricao       String?
  pb              Decimal?         @db.Decimal(4, 1) // % proteína bruta
  edMcal          Decimal?         @db.Decimal(4, 2) // energia (Mcal/kg)
  ativo           Boolean          @default(true)
  grupos          Grupo[]
  itens           DietaItem[] // composição: quanto de cada produto por cabeça/dia
  consumosPeriodo ConsumoPeriodo[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Composição de uma dieta: quanto de cada produto por cabeça por dia.
// Alimenta o motor de consumo (dieta × cabeças × dias → baixa de estoque).
model DietaItem {
  id              Int      @id @default(autoincrement())
  dieta           Dieta    @relation(fields: [dietaId], references: [id], onDelete: Cascade)
  dietaId         Int
  produto         Produto  @relation(fields: [produtoId], references: [id])
  produtoId       Int
  // Quantidade por cabeça por dia, na unidade abaixo (= Produto.unidade em v1).
  qtdPorCabecaDia Decimal  @db.Decimal(12, 4)
  unidade         String // "kg", "g", "L" — informativa; em v1 igual à do produto
  ordem           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([dietaId, produtoId])
  @@index([dietaId])
}

model Animal {
  id                   Int                           @id @default(autoincrement())
  numero               String                        @unique
  nome                 String?
  sexo                 SexoAnimal
  categoria            CategoriaAnimal
  raca                 Raca?                         @relation(fields: [racaId], references: [id])
  racaId               Int?
  grauSangue           String?
  dataNascimento       DateTime?                     @db.Date
  dataEntrada          DateTime                      @db.Date
  brincoEletronico     String?
  sisbov               String?
  mae                  Animal?                       @relation("Maternidade", fields: [maeId], references: [id])
  maeId                Int?
  pai                  Animal?                       @relation("Paternidade", fields: [paiId], references: [id])
  paiId                Int?
  paiNome              String?
  filhosMae            Animal[]                      @relation("Maternidade")
  filhosPai            Animal[]                      @relation("Paternidade")
  grupo                Grupo?                        @relation(fields: [grupoId], references: [id])
  grupoId              Int?
  // Escopo de propriedade (multi-propriedade). Nullable + default=principal na
  // aplicação; fazenda de 1 sítio nunca percebe a camada.
  propriedade          Propriedade?                  @relation(fields: [propriedadeId], references: [id])
  propriedadeId        Int?
  setor                String?
  status               StatusAnimal                  @default(ATIVO)
  dataBaixa            DateTime?                     @db.Date
  motivoBaixa          String?
  // Papel de receptora (barriga de aluguel na TE). Marcado quando recebe um evento
  // TRANSFERENCIA_EMBRIAO; a genética das crias que ela carrega vem da doadora.
  ehReceptora          Boolean                       @default(false)
  resumo               ResumoAnimal?
  numPartosEntrada     Int                           @default(0)
  eventosReprodutivos  EventoReprodutivo[]
  // Eventos de TE em que este animal é a DOADORA do embrião (genética dos bezerros).
  embrioesDoados       EventoReprodutivo[]           @relation("Doadora")
  // Parto que gerou esta cria (lado inverso de EventoReprodutivo.cria). Opcional.
  partoDeOrigem        EventoReprodutivo?            @relation("CriaDoParto")
  aptidoes             AptidaoAnimal[]
  eventosSanitarios    EventoSanitario[]
  examesQuarto         ExameQuarto[]
  vacinasAgendadas     VacinaAgendada[]
  aplicacoesIATF       AplicacaoProtocoloIATF[]
  aplicacoesSanitarias AplicacaoProtocoloSanitario[]
  coletasComoDoadora   Coleta[]                      @relation("DoadoraColeta")
  poolsComoDoadora     ItemGrupoPoolDoadora[]        @relation("DoadoraPool")
  lactacoes            Lactacao[]
  controlesLeiteiros   ControleLeiteiro[]
  pesagens             Pesagem[]
  movimentacoes        MovimentacaoAnimal[]
  linhasAcasalamento   LinhaPlanoAcasalamento[]
  linhasFolhaCampo     LinhaFolhaCampo[]
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@index([status])
  @@index([grupoId])
  @@index([propriedadeId])
}

// Se a movimentação foi de lote (grupo de manejo) ou de setor (local físico).
enum TipoMovimentacaoAnimal {
  GRUPO
  SETOR
}

// Fato histórico de troca de lote/setor de um animal ("onde a vaca esteve").
// Espelha MOVGRUPOANIMAL (1504) / MOVSETORANIMAL (289) do IDEagri, unificados num só
// fato com `tipo`. Guarda rótulos de origem/destino (snapshot — sobrevive a rename/exclusão
// do grupo) + o id do grupo quando aplicável. `origem` null = primeira alocação (entrada no lote/setor).
model MovimentacaoAnimal {
  id             Int                    @id @default(autoincrement())
  animal         Animal                 @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId       Int
  tipo           TipoMovimentacaoAnimal
  data           DateTime               @db.Date // dia da movimentação
  origem         String? // rótulo de origem (nome do grupo/setor), null = primeira alocação
  destino        String // rótulo de destino
  grupoOrigemId  Int? // id do grupo de origem (só p/ tipo GRUPO; snapshot em `origem` cobre rename)
  grupoDestinoId Int? // id do grupo de destino (só p/ tipo GRUPO)
  motivo         String?
  propriedade    Propriedade?           @relation(fields: [propriedadeId], references: [id])
  propriedadeId  Int?
  createdAt      DateTime               @default(now())

  @@index([animalId])
  @@index([tipo])
  @@index([data])
  @@index([propriedadeId])
}

// Filtro de animais salvo (nomeado) — o produtor guarda um conjunto de critérios simples e
// reaplica com um clique. Espelha FILTRO do IDEagri (52). Critérios como colunas tipadas.
model FiltroAnimal {
  id            Int          @id @default(autoincrement())
  nome          String
  status        String       @default("ATIVO") // ATIVO | BAIXADO | TODOS
  grupoId       Int?
  setor         String?
  categoria     String? // CategoriaAnimal (VACA/NOVILHA/...); string livre p/ não acoplar ao enum
  busca         String? // termo de busca (número/nome/brinco)
  propriedade   Propriedade? @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([propriedadeId])
}

enum StatusFolhaCampo {
  RASCUNHO
  EM_CAMPO
  AGUARDANDO_LANCAMENTO
  CONCLUIDA
  CANCELADA
}

enum StatusLinhaFolha {
  PENDENTE
  PREENCHIDA
  NAO_REALIZADO
  REGISTRADA
}

model ModeloFormularioCampo {
  id            Int          @id @default(autoincrement())
  nome          String
  templateId    String
  config        Json
  propriedade   Propriedade? @relation(fields: [propriedadeId], references: [id], onDelete: SetNull)
  propriedadeId Int?
  folhas        FolhaCampo[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([propriedadeId, templateId])
}

model FolhaCampo {
  id              Int               @id @default(autoincrement())
  nome            String
  templateId      String
  status          StatusFolhaCampo  @default(EM_CAMPO)
  filtrosSnapshot Json
  configSnapshot  Json
  modelo          ModeloFormularioCampo? @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  modeloId        Int?
  totalLinhas     Int
  linhasProntas   Int               @default(0)
  propriedade     Propriedade?      @relation(fields: [propriedadeId], references: [id], onDelete: SetNull)
  propriedadeId   Int?
  geradoEm        DateTime          @default(now())
  concluidoEm     DateTime?
  linhas          LinhaFolhaCampo[]

  @@index([propriedadeId, status])
  @@index([templateId])
}

model LinhaFolhaCampo {
  id                  Int                @id @default(autoincrement())
  folha               FolhaCampo         @relation(fields: [folhaId], references: [id], onDelete: Cascade)
  folhaId             Int
  ordem               Int
  animal              Animal             @relation(fields: [animalId], references: [id], onDelete: Restrict)
  animalId            Int
  eventoOrigem        EventoReprodutivo? @relation("EventoOrigemFolha", fields: [eventoOrigemId], references: [id], onDelete: SetNull)
  eventoOrigemId      Int?
  snapshot            Json
  status              StatusLinhaFolha   @default(PENDENTE)
  respostas           Json?
  motivoNaoRealizado  String?
  eventoGerado        EventoReprodutivo? @relation("EventoGeradoFolha", fields: [eventoGeradoId], references: [id], onDelete: SetNull)
  eventoGeradoId      Int?               @unique
  updatedAt           DateTime            @updatedAt

  @@unique([folhaId, ordem])
  @@index([folhaId, status])
  @@index([animalId])
  @@index([eventoOrigemId])
}

model ResumoAnimal {
  animal            Animal            @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId          Int               @id
  statusReprodutivo StatusReprodutivo @default(VAZIA)
  del               Int?
  ordemLactacao     Int?
  producaoMediaDia  Decimal?          @db.Decimal(6, 2)
  producao305       Int?
  producaoTendencia String?
  ccs               Int?
  ccsTendencia      String?
  quartosCronicos   Int               @default(0)
  quartosPerdidos   Int               @default(0)
  ultimoDgData      DateTime?         @db.Date
  ultimoDgResultado String?
  iepProjetado      Int?
  diasGestacao      Int?
  previsaoSecagem   DateTime?         @db.Date
  ultimaInseminacao DateTime?         @db.Date // cobertura mais recente: IA ou TE (nome legado consumido pelo client)
  protocoloAtual    String? // protocolo informado na cobertura mais recente
  atualizadoEm      DateTime          @updatedAt
}

// Quarto mamário: anterior esq/dir, posterior esq/dir. Alinhado ao import legado (Fatia 19, MAMITE AD/AE/PD/PE).
enum QuartoMamario {
  AE
  AD
  PE
  PD
}

// Escore do teste CMT (California Mastitis Test) por quarto: negativo → 3 cruzes.
enum ScoreCmt {
  NEGATIVO
  TRACOS
  UMA_CRUZ
  DUAS_CRUZES
  TRES_CRUZES
}

// Exame por quarto mamário (fato próprio): CMT/CCS subclínico e/ou episódio de mastite clínica.
// Um teste CMT de uma vaca vira até 4 linhas (uma por teta). A cronicidade por quarto é derivada
// em quarto.recompute.ts e agregada em ResumoAnimal.quartosCronicos/quartosPerdidos. Escopo de
// propriedade nullable (multi-propriedade) — fazenda de 1 sítio não percebe a camada.
model ExameQuarto {
  id               Int           @id @default(autoincrement())
  animal           Animal        @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId         Int
  data             DateTime      @db.Date
  quarto           QuartoMamario
  scoreCmt         ScoreCmt? // rastreio subclínico; null se registro só clínico
  ccs              Int? // CCS individual do quarto, se houver
  clinica          Boolean       @default(false) // episódio de mastite clínica neste quarto
  severidade       String? // leve/moderada/grave (só clínica)
  resultadoCultivo String? // agente isolado (só clínica)
  perdido          Boolean       @default(false) // quarto seco/perdido (agênese funcional)
  escoreTeto       Int? // escore da ponta do teto (hiperqueratose), 1–4; null = não avaliado
  observacao       String?
  propriedade      Propriedade?  @relation(fields: [propriedadeId], references: [id])
  propriedadeId    Int?
  createdAt        DateTime      @default(now())

  @@index([animalId, quarto, data])
  @@index([propriedadeId])
}

// Origem de um registro de aptidão: lançado à mão ou derivado da regra automática de novilhas.
enum OrigemAptidao {
  MANUAL
  AUTOMATICA
}

// Aptidão reprodutiva do animal (novilha apta a entrar em reprodução). Espelha
// frmLancarAptidaoAnimal + frmAptidaoAutomatica do IDEAGRI. Fato próprio (não só PEV derivado).
model AptidaoAnimal {
  id            Int           @id @default(autoincrement())
  animal        Animal        @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId      Int
  data          DateTime      @db.Date
  apta          Boolean
  motivo        String? // por que está apta/inapta (idade/peso/decisão)
  origem        OrigemAptidao @default(MANUAL)
  propriedade   Propriedade?  @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime      @default(now())

  @@unique([animalId, data, origem])
  @@index([animalId])
  @@index([propriedadeId])
}

// Dicionário oficial de resultados de exame ginecológico (RESULTADOEXAMEGINECOLOGICO do IDEAGRI,
// 44 resultados por útero/ovário). Compartilhado entre propriedades (propriedadeId ausente de propósito).
model ResultadoExameGinecologico {
  id            Int                 @id @default(autoincrement())
  codigo        Int                 @unique // CDRESULTADOEXAMEGINECOLOGICO de origem
  nomeResumido  String
  nomeCompleto  String?
  tipo          String? // útero/ovário/…
  padrao        Boolean             @default(false)
  eventos       EventoReprodutivo[]
}

enum TipoEventoReprodutivo {
  CIO
  INSEMINACAO
  COBERTURA // monta natural (IDEAGRI CDTIPOREPRODUCAO=2)
  DIAGNOSTICO
  PARTO
  SECAGEM
  TRANSFERENCIA_EMBRIAO // TE: embrião implantado numa receptora; genética vem da doadora
  EXAME_GINECOLOGICO // palpação/US do trato: achado clínico em `resultado` (diagnóstico, não fato estrutural)
  DESMAME // desmame/desaleitamento do bezerro: fato de ciclo com data; peso opcional em `resultado`
}

model EventoReprodutivo {
  id              Int                   @id @default(autoincrement())
  animal          Animal                @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId        Int
  tipo            TipoEventoReprodutivo
  data            DateTime              @db.Date
  observacao      String?
  reprodutor      String? // IA: touro/sêmen. TE: touro/sêmen do embrião.
  protocolo       String?
  resultado       String?
  dtPartoPrevista DateTime?             @db.Date
  tipoParto       String? // código IDEAGRI TIPOPARTO (1..7) ou rótulo canônico
  auxilioParto    String? // código IDEAGRI AUXILIOPARTO (1..4) quando tipo=Auxiliado
  numCrias        Int?
  criasVivas      Int?
  criasNatimortas Int?
  sexoCria        String?
  motivoSecagem   String?
  // Identidade do fato no REPRODUCAO do IDEAGRI — garante import/reconciliação 1:1.
  ideagriId        Int?                  @unique
  // Etapa terminal de IATF/TETF que gerou este evento. Unique = reconcluir não duplica o fato.
  origemExecucaoId Int?                  @unique
  // IA: lote de sêmen consumido (baixa opcional-com-aviso). Nullable — IA por texto livre não referencia lote.
  estoqueSemen            EstoqueSemen? @relation(fields: [estoqueSemenId], references: [id], onDelete: SetNull)
  estoqueSemenId          Int?
  // true só quando a baixa efetivamente decrementou o estoque (saldo ≥ 1). Estorno devolve a dose sse true.
  estoqueSemenDoseBaixada Boolean       @default(false)
  // EXAME_GINECOLOGICO: resultado oficial do dicionário IDEAGRI (além do achado condensado em `resultado`).
  resultadoGinecologico   ResultadoExameGinecologico? @relation(fields: [resultadoGinecologicoId], references: [id])
  resultadoGinecologicoId Int?
  // PARTO: cria criada/vinculada por este parto (genealogia). Nullable — nem todo parto cadastra a cria.
  cria            Animal?               @relation("CriaDoParto", fields: [criaId], references: [id])
  criaId          Int?                  @unique
  // TE operacional: um embrião interno só pode originar um evento de transferência.
  embriaoColeta   EmbriaoColeta? @relation(fields: [embriaoColetaId], references: [id], onDelete: SetNull)
  embriaoColetaId Int?            @unique
  // TE: preserva o embrião e a doadora externos mesmo quando não pertencem ao rebanho 777.
  ideagriEmbriaoId Int?
  doadoraNumero    String?
  doadoraNome      String?
  // TE: doadora do embrião — a genética do bezerro vem dela, não da barriga (animal).
  doadora         Animal?               @relation("Doadora", fields: [doadoraId], references: [id])
  doadoraId       Int?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  linhasFolhaOrigem LinhaFolhaCampo[] @relation("EventoOrigemFolha")
  linhaFolhaGerada  LinhaFolhaCampo?  @relation("EventoGeradoFolha")

  @@index([animalId, data])
  @@index([ideagriEmbriaoId])
  @@index([estoqueSemenId])
}

model Lactacao {
  id              Int       @id @default(autoincrement())
  animal          Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId        Int
  numero          Int // ordem da lactação (ORDEMLACTACAO ou cronológica)
  dtInicio        DateTime  @db.Date
  dtFim           DateTime? @db.Date // null = em curso
  motivoSecagem   String? // MOTIVOSECAGEM.DESCRICAO
  tipoAleitamento String? // TIPOALEITAMENTO ('A'…)
  induzida        Boolean   @default(false)
  producaoTotal   Decimal?  @db.Decimal(10, 2) // litros no ciclo — só a última lactação do animal (aberta ou seca) traz produção
  producao305     Decimal?  @db.Decimal(10, 2)
  duracaoDias     Int? // DEL do Ideagri (hoje sempre null; a duração exibida é recalculada)
  // Sem propriedadeId: como ControleLeiteiro/Pesagem, é fato-filho de Animal e herda o escopo do animal.

  @@index([animalId, numero])
}

// Pesagens corporais (Ideagri PESO) — peso e ganho médio diário (GMD) por data.
model Pesagem {
  id       Int      @id @default(autoincrement())
  animal   Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId Int
  data     DateTime @db.Date
  peso     Decimal  @db.Decimal(7, 2)
  gmd      Decimal? @db.Decimal(6, 3)

  @@index([animalId, data])
}

enum TipoEventoSanitario {
  OCORRENCIA
  APLICACAO
  EXAME
  MASTITE
  VACINA
}

model EventoSanitario {
  id                 Int                 @id @default(autoincrement())
  animal             Animal              @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId           Int
  tipo               TipoEventoSanitario
  data               DateTime            @db.Date
  observacao         String?
  doenca             String?
  dtFim              DateTime?           @db.Date
  diasTratamento     Int?
  produto            String?
  dose               String?
  carencia           Int?
  loteProduto        String?
  ccs                Int?
  gordura            Decimal?            @db.Decimal(4, 2)
  proteina           Decimal?            @db.Decimal(4, 2)
  quarto             String?
  severidade         String?
  resultadoCultivo   String?
  // Vínculo opcional com o estoque: quando a APLICACAO/VACINA consome um Produto cadastrado,
  // produtoRef + quantidadeUsada geram uma SAIDA automática (movimentoEstoque). O texto livre
  // `produto` acima continua para retrocompatibilidade/exibição.
  produtoRef         Produto?            @relation(fields: [produtoId], references: [id])
  produtoId          Int?
  quantidadeUsada    Decimal?            @db.Decimal(12, 2)
  movimentoEstoque   MovimentoEstoque?   @relation(fields: [movimentoEstoqueId], references: [id])
  movimentoEstoqueId Int?                @unique
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([animalId, data])
  @@index([produtoId])
}

// Vacinação AGENDADA (lembrete por data). Distinta do evento VACINA (histórico do que foi feito):
// aqui é o que está por vir. Quando aplicadaEm != null, a vacina saiu do lembrete (foi aplicada);
// o evento sanitário VACINA correspondente pode ser registrado à parte. Escopo de propriedade
// nullable (multi-propriedade) — fazenda de 1 sítio não percebe a camada.
model VacinaAgendada {
  id            Int          @id @default(autoincrement())
  animal        Animal       @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId      Int
  propriedade   Propriedade? @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  vacina        String // nome/tipo da vacina (ex.: "Aftosa", "Brucelose B19")
  dataPrevista  DateTime     @db.Date
  aplicadaEm    DateTime?    @db.Date // null enquanto pendente; preenchido ao marcar aplicada
  observacao    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([animalId])
  @@index([propriedadeId])
  @@index([dataPrevista])
}

// Finalidade do protocolo: IATF termina em inseminação; TETF, em transferência de embrião.
enum FinalidadeIATF {
  IATF
  TETF
}

// Catálogo de protocolos IATF (inseminação artificial em tempo fixo). Antes o
// protocolo era só texto livre em EventoReprodutivo.protocolo; agora é um catálogo
// configurável de etapas (D0/D7/D9/D11…) que se aplica a um animal com uma data de
// início, gerando a agenda (calc puro em iatf.calc.ts).
model ProtocoloIATF {
  id               Int                      @id @default(autoincrement())
  nome             String // rótulo do protocolo (ex.: "IATF 11 dias — P4 + ECP")
  descricao        String?
  hormonioBase     String? // hormônio-base/linha do protocolo (ex.: "P4 + ECP")
  finalidade       FinalidadeIATF            @default(IATF)
  ideagriId        Int?                      @unique // CDPROTOCOLOIATF de origem
  ativo            Boolean                  @default(true) // catálogo: inativar em vez de apagar
  propriedade      Propriedade?             @relation(fields: [propriedadeId], references: [id])
  propriedadeId    Int?
  etapas           EtapaProtocoloIATF[]
  principios       PrincipioProtocoloIATF[]
  aplicacoes       AplicacaoProtocoloIATF[]
  programacoesLote ProgramacaoIATFLote[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([propriedadeId])
  @@index([ativo])
}

// Uma etapa do protocolo: o que fazer no dia `dia` (offset a partir do D0).
model EtapaProtocoloIATF {
  id          Int           @id @default(autoincrement())
  protocolo   ProtocoloIATF @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  protocoloId Int
  dia         Int // offset em dias a partir do D0 (0, 7, 9, 11…)
  acao        String // o que fazer nessa etapa
  hormonio    String? // hormônio/fármaco aplicado, quando houver
  ordem       Int           @default(0) // desempate quando duas etapas caem no mesmo dia

  @@index([protocoloId])
}

// Produto/princípio/dose/uso oficial de uma etapa do protocolo (catálogo IDEAGRI).
model PrincipioProtocoloIATF {
  id          Int           @id @default(autoincrement())
  protocolo   ProtocoloIATF @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  protocoloId Int
  dia         Int           @default(0)
  principio   String?
  produto     String?
  dose        String?
  uso         String?

  @@unique([protocoloId, dia, principio, produto, uso])
  @@index([protocoloId])
}

// Status real de uma etapa materializada na aplicação do protocolo a um animal.
enum StatusExecucaoEtapaIATF {
  PENDENTE
  CONCLUIDA
  PULADA
}

// Aplicação de um protocolo a um animal, a partir de uma data de início (o D0).
// As etapas passam a ser materializadas em ExecucaoEtapaIATF (snapshot + status real).
model AplicacaoProtocoloIATF {
  id            Int                  @id @default(autoincrement())
  animal        Animal               @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId      Int
  protocolo     ProtocoloIATF        @relation(fields: [protocoloId], references: [id])
  protocoloId   Int
  dataInicio    DateTime             @db.Date // D0 da aplicação neste animal
  observacao    String?
  // Dimensões operacionais espelhadas de PROGRAMACAOIATFASSOCIACAO (quando vierem do lote).
  usoCidr       Boolean              @default(false)
  estimulo      String? // ex.: eCG, texto livre da fonte
  perdaImplante Boolean              @default(false)
  ideagriId     Int?                 @unique // CDPROGRAMACAOIATFASSOCIACAO de origem
  // Programação de lote que criou esta aplicação (quando aplicada em massa). Nullable:
  // null = aplicação avulsa (animal a animal, do #163); preenchido = veio de um lote.
  programacao   ProgramacaoIATFLote? @relation(fields: [programacaoId], references: [id], onDelete: Cascade)
  programacaoId Int?
  propriedade   Propriedade?         @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  execucoes     ExecucaoEtapaIATF[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([animalId])
  @@index([protocoloId])
  @@index([programacaoId])
  @@index([propriedadeId])
  @@index([dataInicio])
}

// Execução real de uma etapa do protocolo neste animal. Snapshot de dia/ação/hormônio
// (não FK no catálogo) — editar o protocolo depois não reescreve o histórico.
model ExecucaoEtapaIATF {
  id            Int                    @id @default(autoincrement())
  aplicacao     AplicacaoProtocoloIATF @relation(fields: [aplicacaoId], references: [id], onDelete: Cascade)
  aplicacaoId   Int
  dia           Int // offset D0
  acao          String
  hormonio      String?
  ordem         Int                    @default(0)
  dataPlanejada DateTime               @db.Date
  status        StatusExecucaoEtapaIATF @default(PENDENTE)
  dataExecucao  DateTime?              @db.Date // quando foi marcada feita/pulada
  produto       String? // produto aplicado na etapa (quando houver)
  dose          String?
  observacao    String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([aplicacaoId, dia, ordem])
  @@index([aplicacaoId, status])
  @@index([dataPlanejada])
}

// Catálogo de protocolos sanitários (sequências de manejos: vacinas/tratamentos com offset de
// dias a partir do D0). Espelha a estrutura do IATF (#163) para o domínio sanitário.
model ProtocoloSanitario {
  id            Int                           @id @default(autoincrement())
  nome          String
  descricao     String?
  ativo         Boolean                       @default(true) // catálogo: inativar em vez de apagar
  propriedade   Propriedade?                  @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  etapas        EtapaProtocoloSanitario[]
  aplicacoes    AplicacaoProtocoloSanitario[]
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  @@index([propriedadeId])
  @@index([ativo])
}

model EtapaProtocoloSanitario {
  id          Int                @id @default(autoincrement())
  protocolo   ProtocoloSanitario @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  protocoloId Int
  dia         Int // offset em dias a partir do D0
  acao        String // o que fazer nessa etapa
  produto     String? // produto/vacina aplicado, quando houver
  ordem       Int                @default(0)

  @@index([protocoloId])
}

model AplicacaoProtocoloSanitario {
  id            Int                @id @default(autoincrement())
  animal        Animal             @relation(fields: [animalId], references: [id], onDelete: Cascade)
  animalId      Int
  protocolo     ProtocoloSanitario @relation(fields: [protocoloId], references: [id])
  protocoloId   Int
  dataInicio    DateTime           @db.Date // D0 da aplicação neste animal
  observacao    String?
  propriedade   Propriedade?       @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([animalId])
  @@index([protocoloId])
  @@index([propriedadeId])
  @@index([dataInicio])
}

// Programação de um protocolo IATF para um LOTE inteiro num mesmo D0. Materializa,
// numa transação, uma AplicacaoProtocoloIATF por animal do lote (todas com o mesmo
// protocolo e dataInicio). A agenda D0/D7/D9/D11 é derivada (não materializada),
// igual à aplicação individual. Espelha PROGRAMACAOIATF/PROGRAMACAOIATFASSOCIACAO do IDEagri.
model ProgramacaoIATFLote {
  id            Int                      @id @default(autoincrement())
  protocolo     ProtocoloIATF            @relation(fields: [protocoloId], references: [id])
  protocoloId   Int
  grupo         Grupo?                   @relation(fields: [grupoId], references: [id])
  grupoId       Int? // lote de origem (opcional — pode ser seleção manual de animais)
  nome          String? // rótulo livre ("IATF novilhas — jul/26")
  ideagriId     Int?                     @unique // CDPROGRAMACAOIATF de origem
  dataInicio    DateTime                 @db.Date // D0 comum do lote
  observacao    String?
  aplicacoes    AplicacaoProtocoloIATF[] // as aplicações individuais criadas por esta programação
  propriedade   Propriedade?             @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([propriedadeId])
  @@index([grupoId])
  @@index([dataInicio])
}

enum TipoMovimento {
  ENTRADA
  SAIDA
  AJUSTE
}

// Origem de uma SAIDA/movimento — distingue baixa de consumo automático (NUTRICAO)
// de digitação manual, perda ou ajuste de inventário. Espelha OrigemMovimentoSilo.
enum OrigemMovimentoEstoque {
  MANUAL // digitado à mão (default → comportamento atual)
  NUTRICAO // baixa gerada pelo motor de consumo de dieta
  SANIDADE // baixa automática gerada por evento sanitário (APLICACAO/VACINA)
  PERDA
  AJUSTE_INVENTARIO
}

model MovimentoEstoque {
  id               Int                    @id @default(autoincrement())
  produto          Produto                @relation(fields: [produtoId], references: [id])
  produtoId        Int
  tipo             TipoMovimento
  origem           OrigemMovimentoEstoque @default(MANUAL)
  data             DateTime               @db.Date
  quantidade       Decimal                @db.Decimal(12, 2)
  custoUnitario    Decimal                @db.Decimal(12, 2)
  valorTotal       Decimal                @db.Decimal(14, 2)
  grupo            Grupo?                 @relation(fields: [grupoId], references: [id])
  grupoId          Int?
  fornecedor       ClienteFornecedor?     @relation(fields: [fornecedorId], references: [id])
  fornecedorId     Int?
  // Escopo de propriedade (estoque físico é por sítio). Nullable + default principal.
  propriedade      Propriedade?           @relation(fields: [propriedadeId], references: [id])
  propriedadeId    Int?
  // Lançamento financeiro gerado pela ENTRADA (compra), se houver (ponte compra→financeiro).
  lancamento       Lancamento?            @relation(fields: [lancamentoId], references: [id])
  lancamentoId     Int?                   @unique
  // Fechamento de consumo (Fatia 2) que gerou esta SAIDA, se automática.
  consumoPeriodo   ConsumoPeriodo?        @relation(fields: [consumoPeriodoId], references: [id], onDelete: Cascade)
  consumoPeriodoId Int?
  // Evento sanitário que gerou esta SAIDA (origem SANIDADE), se automática. Back-ref da FK
  // EventoSanitario.movimentoEstoqueId.
  eventoSanitario  EventoSanitario?
  observacao       String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([produtoId, data])
  @@index([tipo, data])
  @@index([consumoPeriodoId])
  @@index([propriedadeId])
}

// Um fechamento de consumo de dieta por lote por período. Agrupa as N SAIDAs
// (uma por produto da dieta), dá idempotência (unique por lote+janela) e permite
// estornar o período inteiro numa transação.
model ConsumoPeriodo {
  id         Int                @id @default(autoincrement())
  grupo      Grupo              @relation(fields: [grupoId], references: [id])
  grupoId    Int
  dieta      Dieta?             @relation(fields: [dietaId], references: [id]) // snapshot de qual dieta valia
  dietaId    Int?
  dataInicio DateTime           @db.Date
  dataFim    DateTime           @db.Date
  numCabecas Int // efetivo usado no cálculo (auditoria)
  diasBase   Int // dias do período (auditoria)
  custoTotal Decimal            @db.Decimal(14, 2) // soma das SAIDAs geradas
  observacao String?
  movimentos MovimentoEstoque[] // as SAIDAs geradas por este fechamento
  criadoEm   DateTime           @default(now())

  @@unique([grupoId, dataInicio, dataFim]) // idempotência: mesmo lote+janela não fecha 2×
  @@index([grupoId])
}

model NotaFiscalArquivo {
  id           Int        @id @default(autoincrement())
  lancamento   Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade)
  lancamentoId Int

  storageDriver String
  bucket        String?
  storageKey    String  @unique
  mimeType      String
  tamanhoBytes  Int
  sha256        String  @unique

  statusValidacao   StatusValidacaoNF @default(PENDENTE)
  mensagemValidacao String?
  ocrTexto          String?           @db.Text
  cnpjEmissor       String?
  chaveAcessoNfe    String?           @db.VarChar(44)

  criadoEm   DateTime  @default(now())
  validadoEm DateTime?

  @@index([lancamentoId, statusValidacao])
}

model NotaFiscalUploadPendente {
  id Int @id @default(autoincrement())

  storageDriver String
  bucket        String?
  storageKey    String  @unique
  sha256        String  @unique
  mimeType      String
  tamanhoBytes  Int

  ocrTexto String? @db.Text

  status       StatusUploadPendente @default(AGUARDANDO)
  lancamentoId Int?
  lancamento   Lancamento?          @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  criadoEm   DateTime  @default(now())
  expiraEm   DateTime
  decididoEm DateTime?

  @@index([status, expiraEm])
}

// =============================================================================
// MÓDULO PLANTIO — Café arábica (Sul de Minas)
// =============================================================================
// Espelha 1-para-1 a arquitetura do Rebanho: Talhão é a "unidade individual"
// (como Animal), Lavoura é o agregador (como Grupo), PlanoAdubacao é a receita
// (como Dieta) e EventoCultural é o evento da timeline (como EventoSanitario).
//
// Referencial técnico: Embrapa Café (sistemas de produção arábica), Manual do
// Café (Emater-MG), Coleção SENAR 189/191, Conab (custos) e Cepea (preços).
// Decimais financeiros usam Decimal(14,2); percentuais fitossanitários e
// químicos usam Decimal(5,2). Mesmas regras do Lancamento já aplicam:
// movimentos cuja data caia num mês fechado em FechamentoMensal não podem
// ser criados/editados/excluídos.

enum EstadoTalhao {
  ATIVO
  RECEPADO
  FORMACAO
  BAIXADO
}

enum FaseFenologica {
  REPOUSO
  INDUCAO_FLORAL
  FLORADA
  CHUMBINHO
  EXPANSAO
  GRANACAO
  MATURACAO_VERDE
  MATURACAO_CEREJA
  COLHEITA
  POS_COLHEITA
}

enum DominioCultural {
  FENOLOGIA
  FITOSSANIDADE
  NUTRICAO
  COLHEITA
}

enum TipoOperacao {
  ADUBACAO_SOLO
  ADUBACAO_FOLIAR
  CALAGEM
  GESSAGEM
  APLICACAO_FUNGICIDA
  APLICACAO_INSETICIDA
  APLICACAO_HERBICIDA
  ROCAGEM_MECANICA
  CAPINA_MANUAL
  PODA_RECEPA
  PODA_DECOTE
  PODA_ESQUELETAMENTO
  PODA_DESPONTE
  DESBROTA
  IRRIGACAO
  REPLANTIO
  AMOSTRAGEM_SOLO
  AMOSTRAGEM_FOLIAR
  MONITORAMENTO_MIP
}

enum PragaDoenca {
  FERRUGEM
  CERCOSPORIOSE
  BICHO_MINEIRO
  BROCA_DO_CAFE
  ACARO_VERMELHO
  NEMATOIDES
  ANTRACNOSE
  MANCHA_AUREOLADA
  FUMAGINA
  ROSELINIA
  COCHONILHAS
  OUTRA
}

enum MetodoColheita {
  DERRICA_PANO
  DERRICA_MECANIZADA
  SELETIVA
  VARRICAO
}

enum Bienalidade {
  POSITIVA
  NEGATIVA
}

// Variedade/cultivar do cafeeiro (Catuaí, Mundo Novo, Topázio, Acauã, etc).
model VariedadeCafe {
  id                 Int      @id @default(autoincrement())
  nome               String   @unique
  // Resistência genética a ferrugem (Hemileia vastatrix). Define se o talhão
  // entra ou não nas worklists de aplicação preventiva.
  resistenteFerrugem Boolean  @default(false)
  porte              String? // ex.: "baixo", "médio", "alto"
  cicloDias          Int? // dias da florada até maturação cereja
  observacao         String?
  talhoes            Talhao[]
}

// Lavoura = agrupador de talhões (espelha Grupo do rebanho).
model Lavoura {
  id              Int              @id @default(autoincrement())
  nome            String           @unique
  observacao      String?
  planoAdubacao   PlanoAdubacao?   @relation(fields: [planoAdubacaoId], references: [id])
  planoAdubacaoId Int?
  talhoes         Talhao[]
  tarefas         TarefaAgricola[]
  // Escopo de propriedade (Fatia 4B). Nullable + default principal.
  propriedade     Propriedade?     @relation(fields: [propriedadeId], references: [id])
  propriedadeId   Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([propriedadeId])
}

// Plano de adubação — receita NPK por safra (espelha Dieta do rebanho).
model PlanoAdubacao {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  descricao String?
  // Doses recomendadas em kg do nutriente por hectare por safra.
  nKgHa     Decimal?  @db.Decimal(7, 2)
  p2o5KgHa  Decimal?  @db.Decimal(7, 2)
  k2oKgHa   Decimal?  @db.Decimal(7, 2)
  // Número de parcelas no parcelamento; o calendário das datas é regional.
  parcelas  Int?
  ativo     Boolean   @default(true)
  lavouras  Lavoura[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// Talhão — unidade individual da lavoura. Espelha Animal do rebanho.
model Talhao {
  id               Int                  @id @default(autoincrement())
  codigo           String               @unique
  nome             String?
  variedade        VariedadeCafe        @relation(fields: [variedadeId], references: [id])
  variedadeId      Int
  lavoura          Lavoura?             @relation(fields: [lavouraId], references: [id])
  lavouraId        Int?
  // Espaçamento como string ("3,80 × 0,60 m") preserva a forma usada pelo
  // produtor; plantasHa é derivado mas guardado pra agilidade nos queries.
  espacamento      String?
  plantasHa        Int
  areaHa           Decimal              @db.Decimal(7, 2)
  anoPlantio       Int
  altitude         Int?
  exposicao        String?
  declive          Decimal?             @db.Decimal(4, 1)
  irrigado         Boolean              @default(false)
  estado           EstadoTalhao         @default(ATIVO)
  dataPlantio      DateTime             @db.Date
  ultimaRecepa     DateTime?            @db.Date
  dataBaixa        DateTime?            @db.Date
  motivoBaixa      String?
  observacao       String?
  resumo           ResumoTalhao?
  operacoes        OperacaoAgricola[]
  inspecoes        InspecaoMIP[]
  amostrasSolo     AmostraSolo[]
  amostrasFoliar   AmostraFoliar[]
  passadasColheita PassadaColheita[]
  safras           SafraTalhao[]
  tarefasAgricolas TarefaAgricola[]
  apontamentos     ApontamentoMaquina[]
  // Escopo de propriedade (Fatia 4B). Nullable + default principal.
  propriedade      Propriedade?         @relation(fields: [propriedadeId], references: [id])
  propriedadeId    Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([estado])
  @@index([lavouraId])
  @@index([propriedadeId])
}

// Read-model pré-computado por talhão — espelha ResumoAnimal.
// Cada campo é recalculado quando uma operação/inspeção é registrada.
model ResumoTalhao {
  talhao                Talhao         @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId              Int            @id
  fase                  FaseFenologica @default(REPOUSO)
  diasNaFase            Int?
  proximaOperacao       String?
  proximaOperacaoEm     DateTime?      @db.Date
  produtividadeEsperada Decimal?       @db.Decimal(6, 2) // sc/ha safra corrente
  produtividadeUltima   Decimal?       @db.Decimal(6, 2) // sc/ha safra anterior
  bienalidade           Bienalidade?
  maturacaoCereja       Decimal?       @db.Decimal(5, 2)
  maturacaoVerde        Decimal?       @db.Decimal(5, 2)
  maturacaoBoia         Decimal?       @db.Decimal(5, 2)
  ferrugem              Decimal?       @db.Decimal(5, 2)
  bichoMineiro          Decimal?       @db.Decimal(5, 2)
  broca                 Decimal?       @db.Decimal(5, 2)
  cercosporiose         Decimal?       @db.Decimal(5, 2)
  tendFerrugem          String?
  ultimaInspecaoData    DateTime?      @db.Date
  ultimaAnaliseSolo     DateTime?      @db.Date
  pH                    Decimal?       @db.Decimal(3, 1)
  v                     Decimal?       @db.Decimal(4, 1) // saturação por bases (%)
  mo                    Decimal?       @db.Decimal(4, 1) // matéria orgânica (g/dm³)
  fosforo               Decimal?       @db.Decimal(6, 2)
  potassio              Decimal?       @db.Decimal(6, 2)
  ultimaAnaliseFoliar   DateTime?      @db.Date
  nFoliar               Decimal?       @db.Decimal(4, 2)
  kFoliar               Decimal?       @db.Decimal(4, 2)
  atualizadoEm          DateTime       @updatedAt
}

// Safra do talhão — espelho de Lactacao (ciclo anual produtivo).
model SafraTalhao {
  id          Int               @id @default(autoincrement())
  talhao      Talhao            @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId    Int
  ano         Int // ex.: 2026 (safra concluída em jun-set/2026)
  sacasTotal  Decimal?          @db.Decimal(9, 2) // benefício consolidado
  sacasPorHa  Decimal?          @db.Decimal(6, 2)
  pctCereja   Decimal?          @db.Decimal(5, 2) // % cereja na média das passadas
  pctBoia     Decimal?          @db.Decimal(5, 2)
  bienalidade Bienalidade?
  fechada     Boolean           @default(false)
  observacao  String?
  passadas    PassadaColheita[]

  @@unique([talhaoId, ano])
  @@index([ano])
}

// Operação agrícola — adubação, calagem, poda, aplicação fito/herbicida,
// monitoramento. Espelho de EventoSanitario do rebanho.
model OperacaoAgricola {
  id             Int             @id @default(autoincrement())
  talhao         Talhao          @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId       Int
  dominio        DominioCultural
  tipo           TipoOperacao
  data           DateTime        @db.Date
  responsavel    String?
  observacao     String?
  // Aplicações/adubações: produto, dose, calda.
  produto        String?
  doseValor      Decimal?        @db.Decimal(10, 3)
  doseUnidade    String? // "L/ha", "kg/ha", "g/ha", "t/ha"
  volumeCaldaLha Decimal?        @db.Decimal(7, 2)
  // Adubação: NPK efetivamente entregue ao solo/folha.
  nKgHa          Decimal?        @db.Decimal(7, 2)
  p2o5KgHa       Decimal?        @db.Decimal(7, 2)
  k2oKgHa        Decimal?        @db.Decimal(7, 2)
  // Aplicação fito: praga/doença alvo.
  pragaAlvo      PragaDoenca?
  carenciaDias   Int?
  // Ponte com o financeiro (espelha Lancamento.movimentoEstoque).
  lancamentoId   Int?            @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([talhaoId, data])
  @@index([dominio, data])
}

// Inspeção MIP — amostragem de 25 plantas, 200 folhas por talhão
// (protocolo Embrapa). Guardar separado de OperacaoAgricola permite
// rastrear evolução das incidências sem misturar com aplicações.
model InspecaoMIP {
  id               Int      @id @default(autoincrement())
  talhao           Talhao   @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId         Int
  data             DateTime @db.Date
  responsavel      String?
  // Incidências em % (folhas ou frutos).
  ferrugem         Decimal? @db.Decimal(5, 2)
  bichoMineiro     Decimal? @db.Decimal(5, 2)
  broca            Decimal? @db.Decimal(5, 2)
  cercosporiose    Decimal? @db.Decimal(5, 2)
  acaroVermelho    Decimal? @db.Decimal(5, 2)
  antracnose       Decimal? @db.Decimal(5, 2)
  // Amostragem (n folhas/frutos avaliados).
  nFolhasAvaliadas Int?
  nFrutosAvaliados Int?
  observacao       String?
  createdAt        DateTime @default(now())

  @@index([talhaoId, data])
}

// Amostra de solo — resultado completo da análise.
model AmostraSolo {
  id           Int      @id @default(autoincrement())
  talhao       Talhao   @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId     Int
  data         DateTime @db.Date
  laboratorio  String?
  profundidade String? // "0-20 cm", "20-40 cm"
  pH           Decimal? @db.Decimal(3, 1)
  v            Decimal? @db.Decimal(4, 1)
  mo           Decimal? @db.Decimal(4, 1)
  fosforo      Decimal? @db.Decimal(6, 2)
  potassio     Decimal? @db.Decimal(6, 2)
  calcio       Decimal? @db.Decimal(5, 2)
  magnesio     Decimal? @db.Decimal(5, 2)
  aluminio     Decimal? @db.Decimal(5, 2)
  ctc          Decimal? @db.Decimal(5, 2)
  zinco        Decimal? @db.Decimal(5, 2)
  boro         Decimal? @db.Decimal(5, 2)
  observacao   String?
  arquivoUrl   String?
  createdAt    DateTime @default(now())

  @@index([talhaoId, data])
}

// Amostra foliar — coleta do 3º/4º par de folhas.
model AmostraFoliar {
  id          Int      @id @default(autoincrement())
  talhao      Talhao   @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId    Int
  data        DateTime @db.Date
  laboratorio String?
  // Concentrações em % do peso seco.
  nFoliar     Decimal? @db.Decimal(4, 2)
  pFoliar     Decimal? @db.Decimal(4, 2)
  kFoliar     Decimal? @db.Decimal(4, 2)
  caFoliar    Decimal? @db.Decimal(4, 2)
  mgFoliar    Decimal? @db.Decimal(4, 2)
  sFoliar     Decimal? @db.Decimal(4, 2)
  bFoliar     Decimal? @db.Decimal(5, 1) // ppm
  znFoliar    Decimal? @db.Decimal(5, 1)
  feFoliar    Decimal? @db.Decimal(5, 1)
  mnFoliar    Decimal? @db.Decimal(5, 1)
  cuFoliar    Decimal? @db.Decimal(5, 1)
  observacao  String?
  arquivoUrl  String?
  createdAt   DateTime @default(now())

  @@index([talhaoId, data])
}

// Passada de colheita — uma derriça por talhão por dia. Espelho de
// ControleLeiteiro do rebanho.
model PassadaColheita {
  id                Int            @id @default(autoincrement())
  talhao            Talhao         @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId          Int
  safra             SafraTalhao?   @relation(fields: [safraId], references: [id])
  safraId           Int?
  numero            Int // 1ª, 2ª passada
  data              DateTime       @db.Date
  metodo            MetodoColheita
  litrosCereja      Decimal        @db.Decimal(10, 2)
  rendimentoLPorSc  Decimal        @db.Decimal(6, 2)
  sacasBeneficiadas Decimal        @db.Decimal(8, 2)
  perdaPiso         Decimal?       @db.Decimal(7, 2)
  pctCereja         Decimal?       @db.Decimal(5, 2)
  pctVerde          Decimal?       @db.Decimal(5, 2)
  pctBoiaPassa      Decimal?       @db.Decimal(5, 2)
  responsavel       String?
  observacao        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([talhaoId, data])
}

// =============================================================================
// MÓDULO PLANTIO — Camada operacional (Ideagri): planejado × realizado
// =============================================================================
// Espelha o modelo agrícola do Ideagri (SAFRA → MANEJOAGRICOLATAREFA →
// HORAMAQUINAHOMEM) que o modelo café-fenológico não cobre: planejamento de
// tarefas com previsto×realizado (qtd/ha, total, data, custo) e apontamento de
// hora-máquina/hora-homem. Escopado por Safra, com ponte ao centro de custo.

enum StatusTarefa {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum TipoApontamento {
  MAQUINA
  HOMEM
}

// Safra agrícola — janela do ciclo produtivo (espelha SAFRA do Ideagri).
model Safra {
  id            Int                  @id @default(autoincrement())
  nome          String               @unique // ex.: "Safra 2026"
  dataInicio    DateTime             @db.Date
  dataFim       DateTime             @db.Date
  fechada       Boolean              @default(false)
  // Ponte com o financeiro: centro de custo do plantio (ex.: "Plantio Café").
  centroCusto   CentroCusto?         @relation(fields: [centroCustoId], references: [id])
  centroCustoId Int?
  tarefas       TarefaAgricola[]
  apontamentos  ApontamentoMaquina[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

// Tarefa agrícola planejada — coração do modelo Ideagri (MANEJOAGRICOLATAREFA):
// previsto × realizado de quantidade, data e custo, com insumo e responsável.
model TarefaAgricola {
  id            Int          @id @default(autoincrement())
  safra         Safra        @relation(fields: [safraId], references: [id], onDelete: Cascade)
  safraId       Int
  talhao        Talhao?      @relation(fields: [talhaoId], references: [id])
  talhaoId      Int? // null = aplica à lavoura/safra inteira
  lavoura       Lavoura?     @relation(fields: [lavouraId], references: [id])
  lavouraId     Int?
  tipo          TipoOperacao
  descricao     String
  responsavel   String?
  produto       String? // insumo
  unidade       String? // unidade da quantidade (kg/ha, L/ha, t/ha…)
  // Previsto
  qtdHaPrev     Decimal?     @db.Decimal(12, 3)
  qtdTotalPrev  Decimal?     @db.Decimal(14, 2)
  dataPrevista  DateTime?    @db.Date
  custoPrev     Decimal?     @db.Decimal(14, 2)
  // Realizado
  qtdHaReal     Decimal?     @db.Decimal(12, 3)
  qtdTotalReal  Decimal?     @db.Decimal(14, 2)
  dataRealizada DateTime?    @db.Date
  custoReal     Decimal?     @db.Decimal(14, 2)
  status        StatusTarefa @default(PLANEJADA)
  observacao    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([safraId])
  @@index([status])
  @@index([talhaoId])
}

// Apontamento de hora-máquina / hora-homem (Ideagri HORAMAQUINAHOMEM/USOMAQUINA):
// custo operacional de mecanização e mão-de-obra que o café-modelo não tinha.
model ApontamentoMaquina {
  id         Int             @id @default(autoincrement())
  safra      Safra?          @relation(fields: [safraId], references: [id])
  safraId    Int?
  talhao     Talhao?         @relation(fields: [talhaoId], references: [id])
  talhaoId   Int?
  data       DateTime        @db.Date
  tipo       TipoApontamento
  recurso    String // nome da máquina/implemento ou da pessoa
  operador   String?
  implemento String?
  horas      Decimal         @db.Decimal(8, 2)
  valorHora  Decimal?        @db.Decimal(10, 2)
  valorTotal Decimal?        @db.Decimal(14, 2)
  observacao String?
  createdAt  DateTime        @default(now())

  @@index([safraId])
  @@index([talhaoId, data])
}

model WhatsAppConfirmacaoPendente {
  id Int @id @default(autoincrement())

  telefone   String
  jid        String
  mensagemId String

  storageDriver String
  bucket        String?
  storageKey    String
  sha256        String  @unique
  mimeType      String
  tamanhoBytes  Int

  dadosExtraidos Json
  modeloIa       String
  tokensInput    Int?
  tokensOutput   Int?

  status       StatusConfirmacaoWA @default(AGUARDANDO)
  lancamentoId Int?
  lancamento   Lancamento?         @relation(fields: [lancamentoId], references: [id], onDelete: SetNull)

  criadoEm   DateTime  @default(now())
  expiraEm   DateTime
  decididoEm DateTime?

  @@index([telefone, status])
  @@index([status, expiraEm])
  @@index([mensagemId])
}

// =============================================================================
// MÓDULO CORTE — Gado de corte (cria-recria-terminação)
// =============================================================================
// A unidade primária é o LOTE (não a cabeça individual): manejo de gado de
// corte acontece por grupo. Cabeças individuais só são modeladas quando
// têm valor reprodutivo (matrizes/touros) — para os demais, o lote agrega
// peso médio + GMD + sanidade.
//
// Referencial: Embrapa Gado de Corte (Campo Grande/MS), Manual de Boas
// Práticas de Vacinação, cronograma 11 (calendário sanitário Sul de Minas),
// Cepea/B3 (preço da arroba). Decimais financeiros @db.Decimal(14,2); peso
// em kg @db.Decimal(7,2); percentuais @db.Decimal(5,2).
//
// Mesma regra de FechamentoMensal aplica: operações comerciais (venda) cuja
// data caia num mês fechado não podem ser editadas/excluídas.

enum CategoriaLote {
  VACA_MATRIZ
  TOURO
  BEZERRO_MAMA
  BEZERRA_MAMA
  BEZERRO_DESMAMA
  BEZERRA_DESMAMA
  GAROTE
  NOVILHA
  NOVILHO
  BOI_GORDO
  VACA_DESCARTE
}

enum FaseCiclo {
  CRIA
  RECRIA
  TERMINACAO
  REPRODUCAO
}

enum EstadoLote {
  ATIVO
  VENDIDO
  EXTINTO
}

enum EstadoPiquete {
  DISPONIVEL
  OCUPADO
  DESCANSO
  REFORMA
}

enum TipoSanitario {
  VACINA_AFTOSA
  VACINA_BRUCELOSE_B19
  VACINA_CLOSTRIDIOSE
  VACINA_RAIVA
  VACINA_CARBUNCULO
  VACINA_LEPTOSPIROSE
  VACINA_IBR_BVD
  VERMIFUGACAO_5811
  VERMIFUGACAO_ESTRATEGICA
  CONTROLE_CARRAPATO
  CONTROLE_MOSCA
  CONTROLE_BERNE
  MARCACAO
  DESCORNA
  CASTRACAO
  BRINCO_ELETRONICO
}

enum TipoSuplemento {
  MINERAL
  PROTEICO_SECA
  ENERGETICO_AGUAS
  RACAO_CONFINAMENTO
  SAL_BRANCO
}

enum TipoComercial {
  VENDA_ABATE
  VENDA_REPRODUCAO
  DESCARTE
  COMPRA
  TRANSFERENCIA_ATIVIDADE
}

enum MetodoPesagem {
  BALANCA_INDIVIDUAL
  BALANCA_LOTE
  FITA_TORACICA
  VISUAL_ESTIMADO
}

// Lote — unidade primária do gado de corte.
model LoteCorte {
  id                  Int                 @id @default(autoincrement())
  codigo              String              @unique
  nome                String
  categoria           CategoriaLote
  fase                FaseCiclo
  raca                String
  numCabecas          Int
  numCabecasEntrada   Int // mortalidade = (entrada - atual) / entrada
  dataFormacao        DateTime            @db.Date
  origem              String?
  piquete             Piquete?            @relation(fields: [piqueteId], references: [id])
  piqueteId           Int?
  // Escopo de propriedade (Fatia 4). Nullable + default principal.
  propriedade         Propriedade?        @relation(fields: [propriedadeId], references: [id])
  propriedadeId       Int?
  estado              EstadoLote          @default(ATIVO)
  observacao          String?
  resumo              ResumoLote?
  pesagens            PesagemLote[]
  manejosSanitarios   ManejoSanitario[]
  suplementacoes      Suplementacao[]
  operacoesComerciais OperacaoComercial[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([estado])
  @@index([categoria, fase])
  @@index([propriedadeId])
}

// Read-model pré-computado por lote.
model ResumoLote {
  lote                 LoteCorte @relation(fields: [loteId], references: [id], onDelete: Cascade)
  loteId               Int       @id
  pesoMedio            Decimal?  @db.Decimal(7, 2)
  pesoMedioEntrada     Decimal?  @db.Decimal(7, 2)
  gmd                  Decimal?  @db.Decimal(5, 3)
  gmdAcumulado         Decimal?  @db.Decimal(5, 3)
  ultimaPesagem        DateTime? @db.Date
  diasSemPesar         Int?
  ua                   Decimal?  @db.Decimal(8, 2)
  proximaVacina        String?
  proximoVermifugo     String?
  ultimoManejo         String?
  pesoAlvoVenda        Decimal?  @db.Decimal(7, 2)
  diasParaAlvo         Int?
  arrobasEstimadas     Decimal?  @db.Decimal(7, 2)
  mortalidadeAcumulada Decimal?  @db.Decimal(5, 2)
  proximaAcao          String?
  proximaAcaoEm        DateTime? @db.Date
  atualizadoEm         DateTime  @updatedAt
}

// Piquete = divisão física do pasto. Um lote ocupa um piquete por vez.
model Piquete {
  id            Int           @id @default(autoincrement())
  codigo        String        @unique
  nome          String
  capim         String // espécie + cultivar — armazenado como texto
  areaHa        Decimal       @db.Decimal(7, 2)
  lotacaoMaxUA  Decimal       @db.Decimal(6, 2)
  cercaTipo     String?
  ultimaReforma DateTime?     @db.Date
  estado        EstadoPiquete @default(DISPONIVEL)
  diasDescanso  Int?
  observacao    String?
  lotes         LoteCorte[]
  // Escopo de propriedade (Fatia 4). Nullable + default principal.
  propriedade   Propriedade?  @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([propriedadeId])
}

// Pesagem do lote — KPI central do corte.
model PesagemLote {
  id             Int           @id @default(autoincrement())
  lote           LoteCorte     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  loteId         Int
  data           DateTime      @db.Date
  pesoMedio      Decimal       @db.Decimal(7, 2)
  numCabecas     Int
  pesoTotal      Decimal       @db.Decimal(10, 2)
  metodo         MetodoPesagem
  responsavel    String?
  observacao     String?
  gmdDesdeUltima Decimal?      @db.Decimal(5, 3)
  createdAt      DateTime      @default(now())

  @@index([loteId, data])
}

// Manejo sanitário aplicado ao lote inteiro (ou parcial).
model ManejoSanitario {
  id           Int           @id @default(autoincrement())
  lote         LoteCorte     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  loteId       Int
  data         DateTime      @db.Date
  tipo         TipoSanitario
  produto      String?
  doseMl       Decimal?      @db.Decimal(7, 2)
  numCabecas   Int
  responsavel  String?
  carenciaDias Int?
  proximaDose  DateTime?     @db.Date
  observacao   String?
  // Ponte financeira opcional — compra do produto pode gerar Lancamento.
  lancamentoId Int?          @unique
  createdAt    DateTime      @default(now())

  @@index([loteId, data])
  @@index([tipo, data])
}

// Suplementação por período. Pode coexistir mais de uma simultânea
// (ex.: mineral + proteico) — dataFim null = ainda ativa.
model Suplementacao {
  id                Int            @id @default(autoincrement())
  lote              LoteCorte      @relation(fields: [loteId], references: [id], onDelete: Cascade)
  loteId            Int
  dataInicio        DateTime       @db.Date
  dataFim           DateTime?      @db.Date
  tipo              TipoSuplemento
  produto           String
  consumoCabecaDiaG Decimal        @db.Decimal(8, 2)
  custoKg           Decimal?       @db.Decimal(7, 2)
  observacao        String?
  createdAt         DateTime       @default(now())

  @@index([loteId, dataInicio])
}

// Operação comercial — venda, descarte, compra, transferência.
model OperacaoComercial {
  id           Int           @id @default(autoincrement())
  lote         LoteCorte?    @relation(fields: [loteId], references: [id])
  loteId       Int?
  data         DateTime      @db.Date
  tipo         TipoComercial
  numCabecas   Int
  pesoMedio    Decimal       @db.Decimal(7, 2)
  pesoTotal    Decimal       @db.Decimal(10, 2)
  arrobas      Decimal?      @db.Decimal(8, 2)
  precoArroba  Decimal?      @db.Decimal(8, 2)
  receitaTotal Decimal?      @db.Decimal(14, 2)
  comprador    String?
  observacao   String?
  lancamentoId Int?          @unique
  createdAt    DateTime      @default(now())

  @@index([loteId, data])
  @@index([tipo, data])
}

// =============================================================================
// MÓDULO EQUIPE & PONTO — funcionários, jornada e apuração de hora extra
// =============================================================================
// Admin-gerenciado: a pessoa do administrativo lança a jornada de cada
// funcionário. A folha cruza horas trabalhadas × salário para apurar extras.

enum TipoDiaPonto {
  UTIL
  DOMINGO
  FERIADO
  FOLGA
  FALTA
}

model Funcionario {
  id                 Int             @id @default(autoincrement())
  nome               String
  cargo              String?
  // Alocação operacional do funcionário (Curral/Ordenha/Bezerreiro/Recria/Café/
  // Milho/Geral…). String livre e opcional — espelha Animal.setor; setores de
  // pessoal são mais granulares que os do estoque e variam por fazenda (revenda).
  // Sem setor → "Geral" na exibição/agregação (borda). Não vira enum de propósito.
  setor              String?
  salarioMensal      Decimal         @db.Decimal(12, 2)
  cargaMensalHoras   Decimal         @default(220) @db.Decimal(6, 2) // carga contratada/mês
  jornadaDiariaHoras Decimal         @default(8) @db.Decimal(5, 2) // jornada normal/dia
  // Horário padrão (opcional): pré-preenche a grade do mês nos dias úteis.
  // Todos null = sem padrão → grade vazia (comportamento atual, admin lança à mão).
  horaEntradaPadrao  String? // "HH:MM"
  horaSaidaPadrao    String? // "HH:MM"
  intervaloPadraoMin Int? // almoço padrão, em minutos
  dataAdmissao       DateTime?       @db.Date
  cpf                String?
  chavePix           String?
  ativo              Boolean         @default(true)
  registros          RegistroPonto[]
  // Escopo de propriedade (Fatia 4C). Nullable + default principal.
  propriedade        Propriedade?    @relation(fields: [propriedadeId], references: [id])
  propriedadeId      Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([ativo])
  @@index([propriedadeId])
}

// Registro de jornada de um dia. entrada/saida em "HH:MM"; horas do dia =
// (saida - entrada) - intervaloMin. tipoDia define a regra de hora extra.
model RegistroPonto {
  id            Int          @id @default(autoincrement())
  funcionario   Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId Int
  data          DateTime     @db.Date
  entrada       String? // "HH:MM"
  saida         String? // "HH:MM"
  intervaloMin  Int          @default(60) // almoço, em minutos
  tipoDia       TipoDiaPonto @default(UTIL)
  observacao    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([funcionarioId, data])
  @@index([funcionarioId, data])
}

// ============================================================================
// Bot de WhatsApp — identidade (allowlist), histórico de conversa e rascunhos.
// Single-tenant por enquanto: quem está na allowlist (ativo) acessa toda a
// fazenda. Multi-fazenda real fica para uma fase futura.
// ============================================================================

enum DirecaoMensagem {
  IN // recebida do usuário
  OUT // enviada pelo bot
}

enum StatusRascunho {
  PENDENTE // aguardando confirmação do usuário
  CONFIRMADO // virou Lancamento
  CANCELADO
}

// Allowlist de telefones autorizados a usar o bot.
model UsuarioWhatsapp {
  id        Int                @id @default(autoincrement())
  // E.164 sem "+" (formato que a Meta entrega), ex.: "5531999999999"
  telefone  String             @unique
  nome      String
  ativo     Boolean            @default(true)
  conversas ConversaWhatsapp[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// Uma conversa por telefone; guarda o histórico para contexto multi-turno.
model ConversaWhatsapp {
  id              Int                @id @default(autoincrement())
  usuario         UsuarioWhatsapp?   @relation(fields: [usuarioId], references: [id])
  usuarioId       Int?
  telefone        String             @unique
  mensagens       MensagemWhatsapp[]
  ultimaAtividade DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model MensagemWhatsapp {
  id          Int              @id @default(autoincrement())
  conversa    ConversaWhatsapp @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  conversaId  Int
  // ID da mensagem na Meta (wamid...) — UNIQUE garante dedupe de reentregas.
  waMessageId String?          @unique
  direcao     DirecaoMensagem
  tipo        String           @default("text") // text | image | interactive | ...
  texto       String?
  createdAt   DateTime         @default(now())

  @@index([conversaId, createdAt])
}

// Rascunho de lançamento (pré-preenchido por formulário/OCR) até o usuário
// confirmar. Campos nullable: OCR pode preencher parcialmente.
model LancamentoRascunho {
  id       Int            @id @default(autoincrement())
  telefone String
  status   StatusRascunho @default(PENDENTE)

  natureza        Natureza?
  valor           Decimal?  @db.Decimal(14, 2)
  dataCompetencia DateTime? @db.Date
  dataVencimento  DateTime? @db.Date
  dataLiquidacao  DateTime? @db.Date
  situacao        Situacao?
  numeroDocumento String?
  descricao       String?

  categoriaId         Int?
  centroCustoId       Int?
  contaBancariaId     Int?
  clienteFornecedorId Int?

  // Extração crua do OCR/vision (auditoria + reprocessar se preciso).
  rawOcr       Json?
  // Lançamento criado quando confirmado.
  lancamentoId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([telefone, status])
}

// =============================================================================
// MÓDULO CULTIVO — culturas anuais (milho primeiro). Custo de safra operacional
// com duas saídas (grão/silagem) e silos. Crop-agnostic via `cultura`.
// =============================================================================

enum Cultura {
  MILHO
}

enum TipoCustoCultivo {
  ADUBACAO
  PREPARO_SOLO
  PLANTIO
  TRATOS
  COLHEITA
  TRANSPORTE
  MAO_DE_OBRA
  MAQUINA
  OUTRO
}

enum TipoProducao {
  GRAO
  SILAGEM
}

enum UnidadeProducao {
  SC
  TON
}

enum DestinoProducao {
  VENDA
  SILO
}

enum TipoSilo {
  GRAO
  SILAGEM
}

enum TipoMovimentoSilo {
  ENTRADA
  SAIDA
}

enum OrigemMovimentoSilo {
  COLHEITA
  NUTRICAO
  VENDA
  AJUSTE
}

model SafraCultivo {
  id            Int                 @id @default(autoincrement())
  cultura       Cultura
  nome          String
  ano           Int
  dataInicio    DateTime            @db.Date
  dataFim       DateTime?           @db.Date
  areaHaTotal   Decimal?            @db.Decimal(10, 2) // usado quando não há AreaCultivo
  fechada       Boolean             @default(false)
  observacao    String?
  areas         AreaCultivo[]
  custos        LancamentoCusto[]
  producoes     ProducaoCultivo[]
  resumo        ResumoSafraCultivo?
  // Escopo de propriedade (Fatia 4C). Nullable + default principal.
  propriedade   Propriedade?        @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([cultura, ano])
  @@index([propriedadeId])
}

model AreaCultivo {
  id             Int               @id @default(autoincrement())
  safraCultivo   SafraCultivo      @relation(fields: [safraCultivoId], references: [id], onDelete: Cascade)
  safraCultivoId Int
  codigo         String
  nome           String?
  areaHa         Decimal           @db.Decimal(10, 2)
  custos         LancamentoCusto[]
  producoes      ProducaoCultivo[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([safraCultivoId, codigo])
}

model LancamentoCusto {
  id             Int                    @id @default(autoincrement())
  safraCultivo   SafraCultivo           @relation(fields: [safraCultivoId], references: [id], onDelete: Cascade)
  safraCultivoId Int
  area           AreaCultivo?           @relation(fields: [areaCultivoId], references: [id])
  areaCultivoId  Int?
  tipo           TipoCustoCultivo
  classe         ClassificacaoCategoria @default(CUSTEIO)
  data           DateTime               @db.Date
  descricao      String
  valor          Decimal                @db.Decimal(14, 2)
  qtd            Decimal?               @db.Decimal(12, 3)
  unidade        String?
  horasMaquina   Decimal?               @db.Decimal(8, 2)
  numMaquinas    Int?
  numCaminhoes   Int?
  lancamentoId   Int?                   @unique // ponte financeira opcional (soft ref)
  observacao     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([safraCultivoId, data])
  @@index([classe])
}

model ProducaoCultivo {
  id             Int              @id @default(autoincrement())
  safraCultivo   SafraCultivo     @relation(fields: [safraCultivoId], references: [id], onDelete: Cascade)
  safraCultivoId Int
  area           AreaCultivo?     @relation(fields: [areaCultivoId], references: [id])
  areaCultivoId  Int?
  data           DateTime         @db.Date
  tipo           TipoProducao
  quantidade     Decimal          @db.Decimal(12, 3)
  unidade        UnidadeProducao
  destino        DestinoProducao?
  silo           Silo?            @relation(fields: [siloId], references: [id])
  siloId         Int?
  observacao     String?
  movimentos     MovimentoSilo[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([safraCultivoId, data])
}

model Silo {
  id            Int               @id @default(autoincrement())
  nome          String
  tipo          TipoSilo
  capacidade    Decimal?          @db.Decimal(12, 3)
  unidade       String
  saldoAtual    Decimal           @default(0) @db.Decimal(12, 3)
  ativo         Boolean           @default(true)
  movimentos    MovimentoSilo[]
  producoes     ProducaoCultivo[]
  // Escopo de propriedade (Fatia 4C). Nullable + default principal.
  propriedade   Propriedade?      @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([propriedadeId])
}

model MovimentoSilo {
  id                Int                 @id @default(autoincrement())
  silo              Silo                @relation(fields: [siloId], references: [id], onDelete: Cascade)
  siloId            Int
  data              DateTime            @db.Date
  tipo              TipoMovimentoSilo
  quantidade        Decimal             @db.Decimal(12, 3)
  origem            OrigemMovimentoSilo
  producaoCultivo   ProducaoCultivo?    @relation(fields: [producaoCultivoId], references: [id])
  producaoCultivoId Int?
  observacao        String?
  createdAt         DateTime            @default(now())

  @@index([siloId, data])
}

model ResumoSafraCultivo {
  id                 Int          @id @default(autoincrement())
  safraCultivo       SafraCultivo @relation(fields: [safraCultivoId], references: [id], onDelete: Cascade)
  safraCultivoId     Int          @unique
  custeioTotal       Decimal      @default(0) @db.Decimal(14, 2)
  investimentoTotal  Decimal      @default(0) @db.Decimal(14, 2)
  areaHa             Decimal      @default(0) @db.Decimal(10, 2)
  producaoGraoSc     Decimal      @default(0) @db.Decimal(12, 3)
  producaoSilagemTon Decimal      @default(0) @db.Decimal(12, 3)
  custoHa            Decimal?     @db.Decimal(14, 2)
  custoSaca          Decimal?     @db.Decimal(14, 2)
  custoTonelada      Decimal?     @db.Decimal(14, 2)
  horasMaquinaTotal  Decimal      @default(0) @db.Decimal(10, 2)
  atualizadoEm       DateTime     @updatedAt
}

// =============================================================================
// MÓDULO CAIXINHA — fundo fixo em dinheiro (pequeno caixa do financeiro)
// =============================================================================
// A pessoa do financeiro mantém um fundo fixo em espécie: toda entrada/saída é
// lançada e o saldo corrente fica pré-computado em `saldoAtual` (razão + saldo,
// mesmo shape de Silo/MovimentoSilo). Suporta N caixinhas (multi-fazenda);
// a Rio Novo usa 1. Mesma regra de FechamentoMensal do Lancamento: movimento
// cuja `data` caia num mês fechado não pode ser criado/excluído.

enum TipoMovimentoCaixinha {
  ENTRADA
  SAIDA
}

// Categoria do gasto do dia a dia da caixinha — usada só em SAIDA
// (ENTRADA/aporte fica sem categoria). Conjunto fixo.
enum CategoriaCaixinha {
  ALIMENTACAO
  COMBUSTIVEL
  MERCADO
  INSUMOS
  MANUTENCAO
  OUTROS
}

model Caixinha {
  id            Int                 @id @default(autoincrement())
  nome          String
  responsavel   String?
  saldoAtual    Decimal             @default(0) @db.Decimal(14, 2)
  ativo         Boolean             @default(true)
  movimentos    MovimentoCaixinha[]
  // Escopo de propriedade (Fatia 4C). Nullable + default principal.
  propriedade   Propriedade?        @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([propriedadeId])
}

model MovimentoCaixinha {
  id         Int                   @id @default(autoincrement())
  caixinha   Caixinha              @relation(fields: [caixinhaId], references: [id], onDelete: Cascade)
  caixinhaId Int
  data       DateTime              @db.Date
  tipo       TipoMovimentoCaixinha
  // categoria do gasto — só em SAIDA; ENTRADA (aporte) fica null
  categoria  CategoriaCaixinha?
  // valor sempre positivo — o sinal vem do tipo (convenção do Lancamento)
  valor      Decimal               @db.Decimal(14, 2)
  descricao  String
  observacao String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([caixinhaId, data])
}

enum StatusUsuario {
  PENDENTE
  ATIVO
  INATIVO
}

enum TipoToken {
  CONVITE
  RESET
}

model Usuario {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  senhaHash    String?
  papel        String
  abas         String[]
  areas        String[]      @default(["financeiro", "rebanho", "agricultura", "gado_corte", "equipe"])
  flags        String[]
  status       StatusUsuario @default(PENDENTE)
  dono         Boolean       @default(false)
  ultimoAcesso DateTime?
  sessoes      Sessao[]
  tokens       TokenAcesso[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId Int
  tokenHash String   @unique
  expiraEm  DateTime
  ultimoUso DateTime @default(now())
  userAgent String?
  criadaEm  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model TokenAcesso {
  id        String    @id @default(cuid())
  usuarioId Int
  tipo      TipoToken
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}
