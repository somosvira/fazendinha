// Modelo de dados — Plataforma de Gestão Rural
// O Financeiro separa o fato de negócio (Operacao), o valor pendente
// (CompromissoFinanceiro), o dinheiro realizado (TransacaoFinanceira /
// MovimentoConta) e o efeito físico (MovimentoEstoque).

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "pecuaria"]
}

enum TipoContaFinanceira {
  BANCO
  CAIXA
  APLICACAO

  @@schema("public")
}

enum TipoParceiro {
  CLIENTE
  FORNECEDOR
  AMBOS
  FUNCIONARIO
  PROPRIETARIO
  OUTRO

  @@schema("public")
}

enum PapelParceiro {
  CLIENTE
  FORNECEDOR
  PRESTADOR_SERVICO
  FUNCIONARIO
  PROPRIETARIO
  OUTRO

  @@schema("public")
}

enum TipoBancario {
  CORRENTE
  POUPANCA
  PAGAMENTO

  @@schema("public")
}

enum TipoOperacaoFinanceira {
  COMPRA_ESTOQUE
  COMPRA_CONSUMO_DIRETO
  SERVICO
  VENDA
  APORTE
  RETIRADA
  TRANSFERENCIA_FINANCEIRA
  AJUSTE_ESTOQUE
  TRANSFERENCIA_ESTOQUE
  INVENTARIO_INICIAL
  BONIFICACAO
  DEVOLUCAO
  PRODUCAO

  @@schema("public")
}

enum StatusOperacao {
  RASCUNHO
  CONFIRMADA
  CANCELADA

  @@schema("public")
}

enum TipoCompromisso {
  PAGAR
  RECEBER

  @@schema("public")
}

enum StatusCompromisso {
  PENDENTE
  PARCIAL
  LIQUIDADO
  CANCELADO

  @@schema("public")
}

enum TipoTransacaoFinanceira {
  PAGAMENTO
  RECEBIMENTO
  TRANSFERENCIA
  APORTE
  RETIRADA
  AJUSTE
  REVERSAO

  @@schema("public")
}

enum FormaPagamento {
  PIX
  TRANSFERENCIA_BANCARIA
  BOLETO
  DINHEIRO
  CARTAO
  CHEQUE
  DEBITO_AUTOMATICO
  OUTRO

  @@schema("public")
}

enum StatusTransacaoFinanceira {
  CONFIRMADA
  REVERTIDA

  @@schema("public")
}

enum DirecaoMovimentoConta {
  ENTRADA
  SAIDA

  @@schema("public")
}

enum TipoDocumentoFinanceiro {
  NOTA_FISCAL
  BOLETO
  CONTRATO
  RECIBO
  COMPROVANTE
  JUSTIFICATIVA
  OUTRO

  @@schema("public")
}

enum StatusPeriodoFinanceiro {
  ABERTO
  FECHADO

  @@schema("public")
}

// Área responsável pelo gasto: Pecuária, Agronomia, Equipe, Gestão.
model CentroCusto {
  id                String               @id @default(uuid())
  nome              String               @unique
  ativo             Boolean              @default(true)
  ordem             Int                  @default(0)
  operacoes         Operacao[]
  produtos          ProdutoCentroCusto[]
  itensOperacao     ItemOperacao[]
  movimentosEstoque MovimentoEstoque[]
  safras            Safra[]

  @@schema("public")
}

// Override gerencial da classificação de uma categoria (custeio × investimento).
// null = pendente (deriva da regra padrão); decidido pelo usuário no dashboard.
enum ClassificacaoCategoria {
  CUSTEIO
  INVESTIMENTO

  @@schema("public")
}

model Categoria {
  id            String                  @id @default(uuid())
  nome          String
  classificacao ClassificacaoCategoria?
  ativo         Boolean                 @default(true)
  ordem         Int                     @default(0)
  // Marcação de comportamento — agrícola: aplicável em talhão e alerta de
  // estoque do plantio. (As marcações sanitária e nutricional voltam com a v3
  // da pecuária.)
  usoAgricola   Boolean                 @default(false)
  // Genético: produtos que podem ser material genético (sêmen/embrião) da pecuária.
  usoGenetico   Boolean                 @default(false)
  operacoes     Operacao[]
  produtos      Produto[]
  itens         ItemOperacao[]

  @@unique([nome])
  @@schema("public")
}

model ContaFinanceira {
  id                  String              @id @default(uuid())
  nome                String
  tipo                TipoContaFinanceira
  instituicao         String?
  identificacao       String?
  tipoBancario        TipoBancario?
  agencia             String?
  numeroConta         String?
  digito              String?
  titular             String?
  local               String?
  responsavel         String?
  observacoes         String?
  ordem               Int                 @default(0)
  saldoAbertura       Decimal             @default(0) @db.Decimal(14, 2)
  dataSaldoAbertura   DateTime            @db.Date
  incluirNoSaldoGeral Boolean             @default(true)
  ativo               Boolean             @default(true)
  propriedade         Propriedade         @relation(fields: [propriedadeId], references: [id])
  propriedadeId       Int
  movimentos          MovimentoConta[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([propriedadeId, nome])
  @@index([propriedadeId, ativo])
  @@schema("public")
}

model Produto {
  id               String               @id @default(uuid())
  nome             String               @unique
  unidade          UnidadeMedida        @default(UN)
  minimoEstoque    Decimal?             @db.Decimal(12, 2)
  ativo            Boolean              @default(true)
  // Mapeamento contábil (ponte com o financeiro): categoria padrão que o item
  // de operação herda ao escolher este produto (classificação vem da categoria).
  // Obrigatória no cadastro (validada no service); a coluna segue nullable por
  // causa de produtos legados. Se o produto tem estoque não é atributo dele:
  // quem decide é o tipo da operação (ItemOperacao.estocavel).
  categoria        Categoria?           @relation(fields: [categoriaId], references: [id])
  categoriaId      String?
  // Centros de custo onde este produto pode ser usado (N:N). Um só → o item da
  // operação e a saída de estoque herdam automaticamente; vários → escolha na hora.
  centrosCusto     ProdutoCentroCusto[]
  movimentos       MovimentoEstoque[]
  itensOperacao    ItemOperacao[]
  fornecedores     ProdutoFornecedor[]
  aplicacoes       OperacaoAgricola[]
  materialGenetico MaterialGenetico?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@schema("public")
}

// Registro de chuva (pluviômetro) — mm por dia. Só o pluviômetro: sem estação meteorológica,
// sem API de clima, sem temperatura. Alimenta o acumulado mensal. Espelha "Clima / registro de
// chuva" (Análise) do IDEagri.
model RegistroChuva {
  id            Int          @id @default(autoincrement())
  data          DateTime     @db.Date
  mm            Decimal      @db.Decimal(6, 1) // milímetros de chuva no dia
  observacao    String?
  propriedade   Propriedade? @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([data])
  @@index([propriedadeId])
  @@schema("public")
}

model Parceiro {
  id                         String                  @id @default(uuid())
  nome                       String
  documento                  String?
  tipo                       TipoParceiro            @default(FORNECEDOR)
  telefone                   String?
  email                      String?
  nomeFantasia               String?
  pessoaContato              String?
  telefoneWhatsapp           Boolean                 @default(false)
  cep                        String?
  logradouro                 String?
  numero                     String?
  complemento                String?
  bairro                     String?
  cidade                     String?
  uf                         String?
  referencia                 String?
  observacoes                String?
  formaPagamentoPreferida    FormaPagamento?
  condicaoPagamentoPreferida String?
  prazosPagamento            Int[]                   @default([])
  papeis                     ParceiroPapel[]
  ativo                      Boolean                 @default(true)
  operacoes                  Operacao[]
  compromissos               CompromissoFinanceiro[]
  transacoes                 TransacaoFinanceira[]
  produtosFornecidos         ProdutoFornecedor[]
  genitoresExternos          GenitorExterno[]
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt

  @@unique([documento])
  @@index([nome])
  @@index([tipo, ativo])
  @@schema("public")
}

// Catálogo opcional de fornecedores usuais do produto. O fornecedor efetivo de
// cada entrada continua sendo o parceiro da Operacao que originou o movimento.
model ProdutoFornecedor {
  produto      Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId    String
  fornecedor   Parceiro @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  fornecedorId String
  createdAt    DateTime @default(now())

  @@id([produtoId, fornecedorId])
  @@index([fornecedorId])
  @@schema("public")
}

// Centros de custo onde o produto pode ser consumido. Substitui o antigo
// Produto.setor (enum fixo) e o Produto.centroCustoId (único).
model ProdutoCentroCusto {
  produto       Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId     String
  centroCusto   CentroCusto @relation(fields: [centroCustoId], references: [id], onDelete: Cascade)
  centroCustoId String
  createdAt     DateTime    @default(now())

  @@id([produtoId, centroCustoId])
  @@index([centroCustoId])
  @@schema("public")
}

model ParceiroPapel {
  parceiroId String
  papel      PapelParceiro
  parceiro   Parceiro      @relation(fields: [parceiroId], references: [id], onDelete: Cascade)

  @@id([parceiroId, papel])
  @@schema("public")
}

model PeriodoFinanceiro {
  id            String                  @id @default(uuid())
  propriedade   Propriedade             @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int
  ano           Int
  mes           Int
  status        StatusPeriodoFinanceiro @default(ABERTO)
  fechadoEm     DateTime?
  fechadoPor    Usuario?                @relation("PeriodoFechadoPor", fields: [fechadoPorId], references: [id])
  fechadoPorId  Int?
  observacao    String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([propriedadeId, ano, mes])
  @@schema("public")
}

model Operacao {
  categoriaNome      String?
  classificacao      ClassificacaoCategoria?
  id                 String                  @id @default(uuid())
  // Número sequencial exibido ao usuário (OP-0042) e critério de ordem de registro.
  numero             Int                     @unique @default(autoincrement())
  tipo               TipoOperacaoFinanceira
  status             StatusOperacao          @default(RASCUNHO)
  data               DateTime                @db.Date
  descricao          String?
  valorTotal         Decimal                 @db.Decimal(14, 2)
  propriedade        Propriedade             @relation(fields: [propriedadeId], references: [id])
  propriedadeId      Int
  parceiro           Parceiro?               @relation(fields: [parceiroId], references: [id])
  parceiroId         String?
  categoria          Categoria?              @relation(fields: [categoriaId], references: [id])
  categoriaId        String?
  centroCusto        CentroCusto?            @relation(fields: [centroCustoId], references: [id])
  centroCustoId      String?
  corrigeOperacao    Operacao?               @relation("CorrecaoOperacao", fields: [corrigeOperacaoId], references: [id])
  corrigeOperacaoId  String?
  correcoes          Operacao[]              @relation("CorrecaoOperacao")
  criadoPor          Usuario?                @relation("OperacaoCriador", fields: [criadoPorId], references: [id])
  criadoPorId        Int?
  itens              ItemOperacao[]
  compromissos       CompromissoFinanceiro[]
  transacoes         TransacaoFinanceira[]
  movimentosEstoque  MovimentoEstoque[]
  documentos         DocumentoFinanceiro[]
  operacoesAgricolas OperacaoAgricola[]
  custosCultivo      LancamentoCusto[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([propriedadeId, data])
  @@index([tipo, status])
  @@index([parceiroId])
  @@index([corrigeOperacaoId])
  @@schema("public")
}

// Estado temporario do formulario financeiro. Cada usuario possui no maximo
// um rascunho por propriedade; nenhum efeito contabil, financeiro ou fisico
// deriva desta entidade antes da confirmacao.
model RascunhoOperacao {
  id            String                @id @default(uuid())
  propriedade   Propriedade           @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  propriedadeId Int
  criadoPor     Usuario               @relation(fields: [criadoPorId], references: [id], onDelete: Cascade)
  criadoPorId   Int
  dados         Json
  versao        Int                   @default(1)
  documentos    DocumentoFinanceiro[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([propriedadeId, criadoPorId])
  @@index([criadoPorId, updatedAt])
  @@schema("public")
}

enum StatusRelatorioFinanceiro {
  PROCESSANDO
  CONCLUIDO
  FALHOU

  @@schema("public")
}

model RascunhoRelatorioFinanceiro {
  id            String      @id @default(uuid())
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Cascade)
  propriedadeId Int
  criadoPor     Usuario     @relation(fields: [criadoPorId], references: [id], onDelete: Cascade)
  criadoPorId   Int
  configuracao  Json
  versao        Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([propriedadeId, criadoPorId])
  @@schema("public")
}

model RelatorioFinanceiro {
  id            String                    @id @default(uuid())
  nome          String
  status        StatusRelatorioFinanceiro @default(PROCESSANDO)
  parametros    Json
  snapshot      Json?
  storageKey    String?                   @unique
  erro          String?
  propriedade   Propriedade               @relation(fields: [propriedadeId], references: [id], onDelete: Restrict)
  propriedadeId Int
  autor         Usuario?                  @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorId       Int?
  autorNome     String
  geradoEm      DateTime                  @default(now())
  concluidoEm   DateTime?

  @@index([propriedadeId, geradoEm])
  @@schema("public")
}

model ItemOperacao {
  categoria         Categoria?              @relation(fields: [categoriaId], references: [id])
  categoriaId       String?
  categoriaNome     String?
  classificacao     ClassificacaoCategoria?
  // Centro de custo do item. Null = herda Operacao.centroCustoId. Nome congelado
  // como snapshot, igual a categoriaNome.
  centroCusto       CentroCusto?            @relation(fields: [centroCustoId], references: [id], onDelete: SetNull)
  centroCustoId     String?
  centroCustoNome   String?
  id                String                  @id @default(uuid())
  // Posição do item dentro da operação (1, 2, 3…); decide a ordem do rateio.
  ordem             Int
  operacao          Operacao                @relation(fields: [operacaoId], references: [id], onDelete: Cascade)
  operacaoId        String
  produto           Produto?                @relation(fields: [produtoId], references: [id])
  produtoId         String?
  descricao         String
  quantidade        Decimal                 @db.Decimal(12, 3)
  unidade           String
  valorUnitario     Decimal                 @db.Decimal(14, 4)
  valorTotal        Decimal                 @db.Decimal(14, 2)
  estocavel         Boolean                 @default(false)
  movimentosEstoque MovimentoEstoque[]
  createdAt         DateTime                @default(now())

  @@unique([operacaoId, ordem])
  @@index([operacaoId])
  @@index([produtoId])
  @@index([centroCustoId])
  @@schema("public")
}

model CompromissoFinanceiro {
  id             String                @id @default(uuid())
  // Ordem de registro (desempate estável e rótulo "#N").
  seq            Int                   @unique @default(autoincrement())
  operacao       Operacao              @relation(fields: [operacaoId], references: [id])
  operacaoId     String
  tipo           TipoCompromisso
  status         StatusCompromisso     @default(PENDENTE)
  valorOriginal  Decimal               @db.Decimal(14, 2)
  dataVencimento DateTime              @db.Date
  numeroParcela  Int?
  totalParcelas  Int?
  parceiro       Parceiro?             @relation(fields: [parceiroId], references: [id])
  parceiroId     String?
  liquidacoes    Liquidacao[]
  documentos     DocumentoFinanceiro[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([tipo, status, dataVencimento])
  @@index([operacaoId])
  @@schema("public")
}

model TransacaoFinanceira {
  id             String                    @id @default(uuid())
  // Ordem de registro (desempate estável e rótulo "#N").
  seq            Int                       @unique @default(autoincrement())
  tipo           TipoTransacaoFinanceira
  status         StatusTransacaoFinanceira @default(CONFIRMADA)
  data           DateTime                  @db.Date
  valorTotal     Decimal                   @db.Decimal(14, 2)
  formaPagamento FormaPagamento?
  descricao      String?
  operacao       Operacao?                 @relation(fields: [operacaoId], references: [id])
  operacaoId     String?
  parceiro       Parceiro?                 @relation(fields: [parceiroId], references: [id])
  parceiroId     String?
  propriedade    Propriedade               @relation(fields: [propriedadeId], references: [id])
  propriedadeId  Int
  criadoPor      Usuario?                  @relation("TransacaoCriador", fields: [criadoPorId], references: [id])
  criadoPorId    Int?
  movimentos     MovimentoConta[]
  liquidacoes    Liquidacao[]
  documentos     DocumentoFinanceiro[]
  reversaoDe     TransacaoFinanceira?      @relation("ReversaoTransacao", fields: [reversaoDeId], references: [id])
  reversaoDeId   String?                   @unique
  revertidaPor   TransacaoFinanceira?      @relation("ReversaoTransacao")
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([propriedadeId, data])
  @@index([tipo, status])
  @@index([operacaoId])
  @@schema("public")
}

model MovimentoConta {
  id          String                @id @default(uuid())
  // Ordem de registro (desempate estável e rótulo "#N").
  seq         Int                   @unique @default(autoincrement())
  transacao   TransacaoFinanceira   @relation(fields: [transacaoId], references: [id], onDelete: Cascade)
  transacaoId String
  conta       ContaFinanceira       @relation(fields: [contaId], references: [id])
  contaId     String
  direcao     DirecaoMovimentoConta
  valor       Decimal               @db.Decimal(14, 2)
  createdAt   DateTime              @default(now())

  @@index([contaId, createdAt])
  @@index([transacaoId])
  @@schema("public")
}

model Liquidacao {
  id            String                @id @default(uuid())
  compromisso   CompromissoFinanceiro @relation(fields: [compromissoId], references: [id])
  compromissoId String
  transacao     TransacaoFinanceira   @relation(fields: [transacaoId], references: [id])
  transacaoId   String
  valor         Decimal               @db.Decimal(14, 2)
  createdAt     DateTime              @default(now())

  @@unique([compromissoId, transacaoId])
  @@index([transacaoId])
  @@schema("public")
}

model DocumentoFinanceiro {
  id            String                  @id @default(uuid())
  tipo          TipoDocumentoFinanceiro
  nome          String
  numero        String?
  storageDriver String?
  bucket        String?
  storageKey    String?                 @unique
  mimeType      String?
  tamanhoBytes  Int?
  sha256        String?                 @unique
  operacao      Operacao?               @relation(fields: [operacaoId], references: [id])
  operacaoId    String?
  transacao     TransacaoFinanceira?    @relation(fields: [transacaoId], references: [id])
  transacaoId   String?
  compromisso   CompromissoFinanceiro?  @relation(fields: [compromissoId], references: [id])
  compromissoId String?
  rascunho      RascunhoOperacao?       @relation(fields: [rascunhoId], references: [id], onDelete: Cascade)
  rascunhoId    String?
  createdAt     DateTime                @default(now())

  @@index([operacaoId])
  @@index([transacaoId])
  @@index([compromissoId])
  @@index([rascunhoId])
  @@schema("public")
}

model AuditoriaFinanceira {
  id              String   @id @default(uuid())
  entidade        String
  entidadeId      String
  acao            String
  motivo          String?
  estadoAnterior  Json?
  estadoPosterior Json?
  usuario         Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioId       Int?
  createdAt       DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([usuarioId, createdAt])
  @@schema("public")
}

// Sítio físico da fazenda-cliente (multi-propriedade). Default single-tenant: 1
// linha (principal). O mesmo seam serve de base p/ multi-tenant (Organizacao) depois.
model Propriedade {
  id                    Int                           @id @default(autoincrement())
  nome                  String                        @unique
  apelido               String? // rótulo curto p/ o seletor ("Sede", "Recria")
  cidade                String?
  uf                    String?
  principal             Boolean                       @default(false) // a default quando não há filtro
  ativo                 Boolean                       @default(true)
  ordem                 Int                           @default(0)
  movimentosEstoque     MovimentoEstoque[]
  contasFinanceiras     ContaFinanceira[]
  operacoesFinanceiras  Operacao[]
  rascunhosOperacoes    RascunhoOperacao[]
  relatoriosFinanceiros RelatorioFinanceiro[]
  rascunhosRelatorios   RascunhoRelatorioFinanceiro[]
  transacoesFinanceiras TransacaoFinanceira[]
  periodosFinanceiros   PeriodoFinanceiro[]
  talhoes               Talhao[]
  lavouras              Lavoura[]
  funcionarios          Funcionario[]
  safrasCultivo         SafraCultivo[]
  silos                 Silo[]
  registrosChuva        RegistroChuva[]
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  // Pecuária v1 (schema pecuaria)
  pecLotes               Lote[]
  pecLocalizacoes        LocalizacaoAnimal[]
  pecMovimentacoes       Movimentacao[]
  pecOrigensMovimentacao MovimentacaoAnimal[]

  @@schema("public")
}

enum TipoMovimento {
  ENTRADA
  SAIDA
  AJUSTE

  @@schema("public")
}

// Origem de uma SAIDA/movimento — distingue baixa automática (APLICACAO no
// talhão) de digitação manual, perda ou ajuste de inventário. Espelha
// OrigemMovimentoSilo. As origens de dieta e sanidade voltam com a v3 da pecuária.
enum OrigemMovimentoEstoque {
  COMPRA
  CONSUMO_DIRETO
  TRANSFERENCIA
  PRODUCAO
  DEVOLUCAO
  BONIFICACAO
  INVENTARIO_INICIAL
  APLICACAO
  PERDA
  AJUSTE_INVENTARIO

  @@schema("public")
}

enum StatusMovimentoEstoque {
  CONFIRMADO
  REVERTIDO

  @@schema("public")
}

model MovimentoEstoque {
  id               String                 @id @default(uuid())
  // Ordem de registro (desempate estável e rótulo "#N").
  seq              Int                    @unique @default(autoincrement())
  produto          Produto                @relation(fields: [produtoId], references: [id])
  produtoId        String
  tipo             TipoMovimento
  origem           OrigemMovimentoEstoque
  status           StatusMovimentoEstoque @default(CONFIRMADO)
  data             DateTime               @db.Date
  quantidade       Decimal                @db.Decimal(12, 3)
  custoUnitario    Decimal                @db.Decimal(14, 4)
  valorTotal       Decimal                @db.Decimal(14, 2)
  // Operações financeiras são a origem normal de entradas; consumos automáticos
  // podem ser justificados pelo evento operacional específico abaixo.
  operacao         Operacao?              @relation(fields: [operacaoId], references: [id])
  operacaoId       String?
  itemOperacao     ItemOperacao?          @relation(fields: [itemOperacaoId], references: [id])
  itemOperacaoId   String?
  // Escopo de propriedade (estoque físico é por sítio). Nullable + default principal.
  propriedade      Propriedade?           @relation(fields: [propriedadeId], references: [id])
  propriedadeId    Int?
  criadoPor        Usuario?               @relation("MovimentoEstoqueCriador", fields: [criadoPorId], references: [id])
  criadoPorId      Int?
  // Alocação operacional: para qual atividade o consumo foi (SAIDA). Não entra
  // nos relatórios financeiros — o custo financeiro é lido pela compra/item.
  centroCusto      CentroCusto?           @relation(fields: [centroCustoId], references: [id])
  centroCustoId    String?
  reversaoDe       MovimentoEstoque?      @relation("ReversaoEstoque", fields: [reversaoDeId], references: [id])
  reversaoDeId     String?                @unique
  revertidoPor     MovimentoEstoque?      @relation("ReversaoEstoque")
  // Operação agrícola (aplicação/adubação) que gerou esta SAIDA (origem APLICACAO).
  operacaoAgricola OperacaoAgricola?
  observacao       String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([produtoId, data])
  @@index([tipo, data])
  @@index([operacaoId])
  @@index([itemOperacaoId])
  @@index([propriedadeId])
  @@index([centroCustoId])
  @@schema("public")
}

// =============================================================================
// MÓDULO PLANTIO — Café arábica (Sul de Minas)
// =============================================================================
// Espelha 1-para-1 a arquitetura do Rebanho: Talhão é a "unidade individual"
// (como Animal), Lavoura é o agregador (como Grupo), PlanoAdubacao é a receita
// (como Dieta) e EventoCultural é o evento da timeline (como EventoSanitario).
//
// Referencial técnico: Embrapa Café (sistemas de produção arábica), Manual do
// Café (Emater-MG), Coleção SENAR 189/191, Conab (custos) e Cepea (preços).
// Decimais financeiros usam Decimal(14,2); percentuais fitossanitários e
// químicos usam Decimal(5,2). As regras do PeriodoFinanceiro também se aplicam:
// movimentos cuja data caia num mês fechado não podem
// ser criados/editados/excluídos.

enum EstadoTalhao {
  ATIVO
  RECEPADO
  FORMACAO
  BAIXADO

  @@schema("public")
}

enum FaseFenologica {
  REPOUSO
  INDUCAO_FLORAL
  FLORADA
  CHUMBINHO
  EXPANSAO
  GRANACAO
  MATURACAO_VERDE
  MATURACAO_CEREJA
  COLHEITA
  POS_COLHEITA

  @@schema("public")
}

enum DominioCultural {
  FENOLOGIA
  FITOSSANIDADE
  NUTRICAO
  COLHEITA

  @@schema("public")
}

enum TipoOperacao {
  ADUBACAO_SOLO
  ADUBACAO_FOLIAR
  CALAGEM
  GESSAGEM
  APLICACAO_FUNGICIDA
  APLICACAO_INSETICIDA
  APLICACAO_HERBICIDA
  ROCAGEM_MECANICA
  CAPINA_MANUAL
  PODA_RECEPA
  PODA_DECOTE
  PODA_ESQUELETAMENTO
  PODA_DESPONTE
  DESBROTA
  IRRIGACAO
  REPLANTIO
  AMOSTRAGEM_SOLO
  AMOSTRAGEM_FOLIAR
  MONITORAMENTO_MIP

  @@schema("public")
}

enum PragaDoenca {
  FERRUGEM
  CERCOSPORIOSE
  BICHO_MINEIRO
  BROCA_DO_CAFE
  ACARO_VERMELHO
  NEMATOIDES
  ANTRACNOSE
  MANCHA_AUREOLADA
  FUMAGINA
  ROSELINIA
  COCHONILHAS
  OUTRA

  @@schema("public")
}

enum MetodoColheita {
  DERRICA_PANO
  DERRICA_MECANIZADA
  SELETIVA
  VARRICAO

  @@schema("public")
}

enum Bienalidade {
  POSITIVA
  NEGATIVA

  @@schema("public")
}

// Variedade/cultivar do cafeeiro (Catuaí, Mundo Novo, Topázio, Acauã, etc).
model VariedadeCafe {
  id                 Int      @id @default(autoincrement())
  nome               String   @unique
  // Resistência genética a ferrugem (Hemileia vastatrix). Define se o talhão
  // entra ou não nas worklists de aplicação preventiva.
  resistenteFerrugem Boolean  @default(false)
  porte              String? // ex.: "baixo", "médio", "alto"
  cicloDias          Int? // dias da florada até maturação cereja
  observacao         String?
  talhoes            Talhao[]

  @@schema("public")
}

// Lavoura = agrupador de talhões (espelha Grupo do rebanho).
model Lavoura {
  id              Int              @id @default(autoincrement())
  nome            String           @unique
  observacao      String?
  planoAdubacao   PlanoAdubacao?   @relation(fields: [planoAdubacaoId], references: [id])
  planoAdubacaoId Int?
  talhoes         Talhao[]
  tarefas         TarefaAgricola[]
  // Escopo de propriedade (Fatia 4B). Nullable + default principal.
  propriedade     Propriedade?     @relation(fields: [propriedadeId], references: [id])
  propriedadeId   Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([propriedadeId])
  @@schema("public")
}

// Plano de adubação — receita NPK por safra (espelha Dieta do rebanho).
model PlanoAdubacao {
  id        Int       @id @default(autoincrement())
  nome      String    @unique
  descricao String?
  // Doses recomendadas em kg do nutriente por hectare por safra.
  nKgHa     Decimal?  @db.Decimal(7, 2)
  p2o5KgHa  Decimal?  @db.Decimal(7, 2)
  k2oKgHa   Decimal?  @db.Decimal(7, 2)
  // Número de parcelas no parcelamento; o calendário das datas é regional.
  parcelas  Int?
  ativo     Boolean   @default(true)
  lavouras  Lavoura[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@schema("public")
}

// Talhão — unidade individual da lavoura. Espelha Animal do rebanho.
model Talhao {
  id               Int                  @id @default(autoincrement())
  codigo           String               @unique
  nome             String?
  variedade        VariedadeCafe        @relation(fields: [variedadeId], references: [id])
  variedadeId      Int
  lavoura          Lavoura?             @relation(fields: [lavouraId], references: [id])
  lavouraId        Int?
  // Espaçamento como string ("3,80 × 0,60 m") preserva a forma usada pelo
  // produtor; plantasHa é derivado mas guardado pra agilidade nos queries.
  espacamento      String?
  plantasHa        Int
  areaHa           Decimal              @db.Decimal(7, 2)
  anoPlantio       Int
  altitude         Int?
  exposicao        String?
  declive          Decimal?             @db.Decimal(4, 1)
  irrigado         Boolean              @default(false)
  estado           EstadoTalhao         @default(ATIVO)
  dataPlantio      DateTime             @db.Date
  ultimaRecepa     DateTime?            @db.Date
  dataBaixa        DateTime?            @db.Date
  motivoBaixa      String?
  observacao       String?
  resumo           ResumoTalhao?
  operacoes        OperacaoAgricola[]
  inspecoes        InspecaoMIP[]
  amostrasSolo     AmostraSolo[]
  amostrasFoliar   AmostraFoliar[]
  passadasColheita PassadaColheita[]
  safras           SafraTalhao[]
  tarefasAgricolas TarefaAgricola[]
  apontamentos     ApontamentoMaquina[]
  // Escopo de propriedade (Fatia 4B). Nullable + default principal.
  propriedade      Propriedade?         @relation(fields: [propriedadeId], references: [id])
  propriedadeId    Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([estado])
  @@index([lavouraId])
  @@index([propriedadeId])
  @@schema("public")
}

// Read-model pré-computado por talhão — espelha ResumoAnimal.
// Cada campo é recalculado quando uma operação/inspeção é registrada.
model ResumoTalhao {
  talhao                Talhao         @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId              Int            @id
  fase                  FaseFenologica @default(REPOUSO)
  diasNaFase            Int?
  proximaOperacao       String?
  proximaOperacaoEm     DateTime?      @db.Date
  produtividadeEsperada Decimal?       @db.Decimal(6, 2) // sc/ha safra corrente
  produtividadeUltima   Decimal?       @db.Decimal(6, 2) // sc/ha safra anterior
  bienalidade           Bienalidade?
  maturacaoCereja       Decimal?       @db.Decimal(5, 2)
  maturacaoVerde        Decimal?       @db.Decimal(5, 2)
  maturacaoBoia         Decimal?       @db.Decimal(5, 2)
  ferrugem              Decimal?       @db.Decimal(5, 2)
  bichoMineiro          Decimal?       @db.Decimal(5, 2)
  broca                 Decimal?       @db.Decimal(5, 2)
  cercosporiose         Decimal?       @db.Decimal(5, 2)
  tendFerrugem          String?
  ultimaInspecaoData    DateTime?      @db.Date
  ultimaAnaliseSolo     DateTime?      @db.Date
  pH                    Decimal?       @db.Decimal(3, 1)
  v                     Decimal?       @db.Decimal(4, 1) // saturação por bases (%)
  mo                    Decimal?       @db.Decimal(4, 1) // matéria orgânica (g/dm³)
  fosforo               Decimal?       @db.Decimal(6, 2)
  potassio              Decimal?       @db.Decimal(6, 2)
  ultimaAnaliseFoliar   DateTime?      @db.Date
  nFoliar               Decimal?       @db.Decimal(4, 2)
  kFoliar               Decimal?       @db.Decimal(4, 2)
  atualizadoEm          DateTime       @updatedAt

  @@schema("public")
}

// Safra do talhão — espelho de Lactacao (ciclo anual produtivo).
model SafraTalhao {
  id          Int               @id @default(autoincrement())
  talhao      Talhao            @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId    Int
  ano         Int // ex.: 2026 (safra concluída em jun-set/2026)
  sacasTotal  Decimal?          @db.Decimal(9, 2) // benefício consolidado
  sacasPorHa  Decimal?          @db.Decimal(6, 2)
  pctCereja   Decimal?          @db.Decimal(5, 2) // % cereja na média das passadas
  pctBoia     Decimal?          @db.Decimal(5, 2)
  bienalidade Bienalidade?
  fechada     Boolean           @default(false)
  observacao  String?
  passadas    PassadaColheita[]

  @@unique([talhaoId, ano])
  @@index([ano])
  @@schema("public")
}

// Operação agrícola — adubação, calagem, poda, aplicação fito/herbicida,
// monitoramento. Espelho de EventoSanitario do rebanho.
model OperacaoAgricola {
  id                   Int               @id @default(autoincrement())
  talhao               Talhao            @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId             Int
  dominio              DominioCultural
  tipo                 TipoOperacao
  data                 DateTime          @db.Date
  responsavel          String?
  observacao           String?
  // Aplicações/adubações: produto, dose, calda. `produto` é o rótulo livre legado;
  // `produtoRef` liga ao estoque e, com quantidadeTotal (dose × área), gera a
  // SAIDA automática (movimentoEstoque, origem APLICACAO).
  produto              String?
  produtoRef           Produto?          @relation(fields: [produtoId], references: [id])
  produtoId            String?
  quantidadeTotal      Decimal?          @db.Decimal(12, 3)
  movimentoEstoque     MovimentoEstoque? @relation(fields: [movimentoEstoqueId], references: [id])
  movimentoEstoqueId   String?           @unique
  doseValor            Decimal?          @db.Decimal(10, 3)
  doseUnidade          String? // "L/ha", "kg/ha", "g/ha", "t/ha"
  volumeCaldaLha       Decimal?          @db.Decimal(7, 2)
  // Adubação: NPK efetivamente entregue ao solo/folha.
  nKgHa                Decimal?          @db.Decimal(7, 2)
  p2o5KgHa             Decimal?          @db.Decimal(7, 2)
  k2oKgHa              Decimal?          @db.Decimal(7, 2)
  // Aplicação fito: praga/doença alvo.
  pragaAlvo            PragaDoenca?
  carenciaDias         Int?
  // Referência lógica opcional à operação financeira que originou o custo.
  operacaoFinanceira   Operacao?         @relation(fields: [operacaoFinanceiraId], references: [id])
  operacaoFinanceiraId String?           @unique
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([talhaoId, data])
  @@index([dominio, data])
  @@index([produtoId])
  @@schema("public")
}

// Inspeção MIP — amostragem de 25 plantas, 200 folhas por talhão
// (protocolo Embrapa). Guardar separado de OperacaoAgricola permite
// rastrear evolução das incidências sem misturar com aplicações.
model InspecaoMIP {
  id               Int      @id @default(autoincrement())
  talhao           Talhao   @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId         Int
  data             DateTime @db.Date
  responsavel      String?
  // Incidências em % (folhas ou frutos).
  ferrugem         Decimal? @db.Decimal(5, 2)
  bichoMineiro     Decimal? @db.Decimal(5, 2)
  broca            Decimal? @db.Decimal(5, 2)
  cercosporiose    Decimal? @db.Decimal(5, 2)
  acaroVermelho    Decimal? @db.Decimal(5, 2)
  antracnose       Decimal? @db.Decimal(5, 2)
  // Amostragem (n folhas/frutos avaliados).
  nFolhasAvaliadas Int?
  nFrutosAvaliados Int?
  observacao       String?
  createdAt        DateTime @default(now())

  @@index([talhaoId, data])
  @@schema("public")
}

// Amostra de solo — resultado completo da análise.
model AmostraSolo {
  id           Int      @id @default(autoincrement())
  talhao       Talhao   @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId     Int
  data         DateTime @db.Date
  laboratorio  String?
  profundidade String? // "0-20 cm", "20-40 cm"
  pH           Decimal? @db.Decimal(3, 1)
  v            Decimal? @db.Decimal(4, 1)
  mo           Decimal? @db.Decimal(4, 1)
  fosforo      Decimal? @db.Decimal(6, 2)
  potassio     Decimal? @db.Decimal(6, 2)
  calcio       Decimal? @db.Decimal(5, 2)
  magnesio     Decimal? @db.Decimal(5, 2)
  aluminio     Decimal? @db.Decimal(5, 2)
  ctc          Decimal? @db.Decimal(5, 2)
  zinco        Decimal? @db.Decimal(5, 2)
  boro         Decimal? @db.Decimal(5, 2)
  observacao   String?
  arquivoUrl   String?
  createdAt    DateTime @default(now())

  @@index([talhaoId, data])
  @@schema("public")
}

// Amostra foliar — coleta do 3º/4º par de folhas.
model AmostraFoliar {
  id          Int      @id @default(autoincrement())
  talhao      Talhao   @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId    Int
  data        DateTime @db.Date
  laboratorio String?
  // Concentrações em % do peso seco.
  nFoliar     Decimal? @db.Decimal(4, 2)
  pFoliar     Decimal? @db.Decimal(4, 2)
  kFoliar     Decimal? @db.Decimal(4, 2)
  caFoliar    Decimal? @db.Decimal(4, 2)
  mgFoliar    Decimal? @db.Decimal(4, 2)
  sFoliar     Decimal? @db.Decimal(4, 2)
  bFoliar     Decimal? @db.Decimal(5, 1) // ppm
  znFoliar    Decimal? @db.Decimal(5, 1)
  feFoliar    Decimal? @db.Decimal(5, 1)
  mnFoliar    Decimal? @db.Decimal(5, 1)
  cuFoliar    Decimal? @db.Decimal(5, 1)
  observacao  String?
  arquivoUrl  String?
  createdAt   DateTime @default(now())

  @@index([talhaoId, data])
  @@schema("public")
}

// Passada de colheita — uma derriça por talhão por dia. Espelho de
// ControleLeiteiro do rebanho.
model PassadaColheita {
  id                Int            @id @default(autoincrement())
  talhao            Talhao         @relation(fields: [talhaoId], references: [id], onDelete: Cascade)
  talhaoId          Int
  safra             SafraTalhao?   @relation(fields: [safraId], references: [id])
  safraId           Int?
  numero            Int // 1ª, 2ª passada
  data              DateTime       @db.Date
  metodo            MetodoColheita
  litrosCereja      Decimal        @db.Decimal(10, 2)
  rendimentoLPorSc  Decimal        @db.Decimal(6, 2)
  sacasBeneficiadas Decimal        @db.Decimal(8, 2)
  perdaPiso         Decimal?       @db.Decimal(7, 2)
  pctCereja         Decimal?       @db.Decimal(5, 2)
  pctVerde          Decimal?       @db.Decimal(5, 2)
  pctBoiaPassa      Decimal?       @db.Decimal(5, 2)
  responsavel       String?
  observacao        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([talhaoId, data])
  @@schema("public")
}

// =============================================================================
// MÓDULO PLANTIO — Camada operacional (Ideagri): planejado × realizado
// =============================================================================
// Espelha o modelo agrícola do Ideagri (SAFRA → MANEJOAGRICOLATAREFA →
// HORAMAQUINAHOMEM) que o modelo café-fenológico não cobre: planejamento de
// tarefas com previsto×realizado (qtd/ha, total, data, custo) e apontamento de
// hora-máquina/hora-homem. Escopado por Safra, com ponte ao centro de custo.

enum StatusTarefa {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA

  @@schema("public")
}

enum TipoApontamento {
  MAQUINA
  HOMEM

  @@schema("public")
}

// Safra agrícola — janela do ciclo produtivo (espelha SAFRA do Ideagri).
model Safra {
  id            Int                  @id @default(autoincrement())
  nome          String               @unique // ex.: "Safra 2026"
  dataInicio    DateTime             @db.Date
  dataFim       DateTime             @db.Date
  fechada       Boolean              @default(false)
  // Ponte com o financeiro: centro de custo do plantio (ex.: "Plantio Café").
  centroCusto   CentroCusto?         @relation(fields: [centroCustoId], references: [id])
  centroCustoId String?
  tarefas       TarefaAgricola[]
  apontamentos  ApontamentoMaquina[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@schema("public")
}

// Tarefa agrícola planejada — coração do modelo Ideagri (MANEJOAGRICOLATAREFA):
// previsto × realizado de quantidade, data e custo, com insumo e responsável.
model TarefaAgricola {
  id            Int          @id @default(autoincrement())
  safra         Safra        @relation(fields: [safraId], references: [id], onDelete: Cascade)
  safraId       Int
  talhao        Talhao?      @relation(fields: [talhaoId], references: [id])
  talhaoId      Int? // null = aplica à lavoura/safra inteira
  lavoura       Lavoura?     @relation(fields: [lavouraId], references: [id])
  lavouraId     Int?
  tipo          TipoOperacao
  descricao     String
  responsavel   String?
  produto       String? // insumo
  unidade       String? // unidade da quantidade (kg/ha, L/ha, t/ha…)
  // Previsto
  qtdHaPrev     Decimal?     @db.Decimal(12, 3)
  qtdTotalPrev  Decimal?     @db.Decimal(14, 2)
  dataPrevista  DateTime?    @db.Date
  custoPrev     Decimal?     @db.Decimal(14, 2)
  // Realizado
  qtdHaReal     Decimal?     @db.Decimal(12, 3)
  qtdTotalReal  Decimal?     @db.Decimal(14, 2)
  dataRealizada DateTime?    @db.Date
  custoReal     Decimal?     @db.Decimal(14, 2)
  status        StatusTarefa @default(PLANEJADA)
  observacao    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([safraId])
  @@index([status])
  @@index([talhaoId])
  @@schema("public")
}

// Apontamento de hora-máquina / hora-homem (Ideagri HORAMAQUINAHOMEM/USOMAQUINA):
// custo operacional de mecanização e mão-de-obra que o café-modelo não tinha.
model ApontamentoMaquina {
  id         Int             @id @default(autoincrement())
  safra      Safra?          @relation(fields: [safraId], references: [id])
  safraId    Int?
  talhao     Talhao?         @relation(fields: [talhaoId], references: [id])
  talhaoId   Int?
  data       DateTime        @db.Date
  tipo       TipoApontamento
  recurso    String // nome da máquina/implemento ou da pessoa
  operador   String?
  implemento String?
  horas      Decimal         @db.Decimal(8, 2)
  valorHora  Decimal?        @db.Decimal(10, 2)
  valorTotal Decimal?        @db.Decimal(14, 2)
  observacao String?
  createdAt  DateTime        @default(now())

  @@index([safraId])
  @@index([talhaoId, data])
  @@schema("public")
}

// =============================================================================
// MÓDULO EQUIPE & PONTO — funcionários, jornada e apuração de hora extra
// =============================================================================
// Admin-gerenciado: a pessoa do administrativo lança a jornada de cada
// funcionário. A folha cruza horas trabalhadas × salário para apurar extras.

enum TipoDiaPonto {
  UTIL
  DOMINGO
  FERIADO
  FOLGA
  FALTA

  @@schema("public")
}

model Funcionario {
  id                 Int             @id @default(autoincrement())
  nome               String
  cargo              String?
  // Alocação operacional do funcionário (Curral/Ordenha/Bezerreiro/Recria/Café/
  // Milho/Geral…). String livre e opcional — espelha Animal.setor; setores de
  // pessoal são mais granulares que os do estoque e variam por fazenda (revenda).
  // Sem setor → "Geral" na exibição/agregação (borda). Não vira enum de propósito.
  setor              String?
  salarioMensal      Decimal         @db.Decimal(12, 2)
  cargaMensalHoras   Decimal         @default(220) @db.Decimal(6, 2) // carga contratada/mês
  jornadaDiariaHoras Decimal         @default(8) @db.Decimal(5, 2) // jornada normal/dia
  // Horário padrão (opcional): pré-preenche a grade do mês nos dias úteis.
  // Todos null = sem padrão → grade vazia (comportamento atual, admin lança à mão).
  horaEntradaPadrao  String? // "HH:MM"
  horaSaidaPadrao    String? // "HH:MM"
  intervaloPadraoMin Int? // almoço padrão, em minutos
  dataAdmissao       DateTime?       @db.Date
  cpf                String?
  chavePix           String?
  ativo              Boolean         @default(true)
  registros          RegistroPonto[]
  // Escopo de propriedade (Fatia 4C). Nullable + default principal.
  propriedade        Propriedade?    @relation(fields: [propriedadeId], references: [id])
  propriedadeId      Int?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([ativo])
  @@index([propriedadeId])
  @@schema("public")
}

// Registro de jornada de um dia. entrada/saida em "HH:MM"; horas do dia =
// (saida - entrada) - intervaloMin. tipoDia define a regra de hora extra.
model RegistroPonto {
  id            Int          @id @default(autoincrement())
  funcionario   Funcionario  @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  funcionarioId Int
  data          DateTime     @db.Date
  entrada       String? // "HH:MM"
  saida         String? // "HH:MM"
  intervaloMin  Int          @default(60) // almoço, em minutos
  tipoDia       TipoDiaPonto @default(UTIL)
  observacao    String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([funcionarioId, data])
  @@index([funcionarioId, data])
  @@schema("public")
}

// ============================================================================
// Bot de WhatsApp — identidade (allowlist), histórico de conversa e rascunhos.
// Single-tenant por enquanto: quem está na allowlist (ativo) acessa toda a
// fazenda. Multi-fazenda real fica para uma fase futura.
// ============================================================================

enum DirecaoMensagem {
  IN // recebida do usuário
  OUT // enviada pelo bot

  @@schema("public")
}

// Allowlist de telefones autorizados a usar o bot.
model UsuarioWhatsapp {
  id        Int                @id @default(autoincrement())
  // E.164 sem "+" (formato que a Meta entrega), ex.: "5531999999999"
  telefone  String             @unique
  nome      String
  ativo     Boolean            @default(true)
  conversas ConversaWhatsapp[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@schema("public")
}

// Uma conversa por telefone; guarda o histórico para contexto multi-turno.
model ConversaWhatsapp {
  id              Int                @id @default(autoincrement())
  usuario         UsuarioWhatsapp?   @relation(fields: [usuarioId], references: [id])
  usuarioId       Int?
  telefone        String             @unique
  mensagens       MensagemWhatsapp[]
  ultimaAtividade DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@schema("public")
}

model MensagemWhatsapp {
  id          Int              @id @default(autoincrement())
  conversa    ConversaWhatsapp @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  conversaId  Int
  // ID da mensagem na Meta (wamid...) — UNIQUE garante dedupe de reentregas.
  waMessageId String?          @unique
  direcao     DirecaoMensagem
  tipo        String           @default("text") // text | image | interactive | ...
  texto       String?
  createdAt   DateTime         @default(now())

  @@index([conversaId, createdAt])
  @@schema("public")
}

// =============================================================================
// MÓDULO CULTIVO — culturas anuais (milho primeiro). Custo de safra operacional
// com duas saídas (grão/silagem) e silos. Crop-agnostic via `cultura`.
// =============================================================================

enum Cultura {
  MILHO

  @@schema("public")
}

enum TipoCustoCultivo {
  ADUBACAO
  PREPARO_SOLO
  PLANTIO
  TRATOS
  COLHEITA
  TRANSPORTE
  MAO_DE_OBRA
  MAQUINA
  OUTRO

  @@schema("public")
}

enum TipoProducao {
  GRAO
  SILAGEM

  @@schema("public")
}

enum UnidadeProducao {
  SC
  TON

  @@schema("public")
}

enum DestinoProducao {
  VENDA
  SILO

  @@schema("public")
}

// Unidade de medida do estoque (Produto). Conversão entre unidades da mesma
// base em services/estoque/unidades.ts — não confundir com
// ItemOperacao.unidade/OperacaoAgricola.doseUnidade, que são texto (rótulo
// gravado no momento, snapshot legível/histórico).
enum UnidadeMedida {
  UN
  KG
  G
  T
  L
  ML
  SC
  DOSE
  CX
  M
  HA

  @@schema("public")
}

enum TipoSilo {
  GRAO
  SILAGEM

  @@schema("public")
}

enum TipoMovimentoSilo {
  ENTRADA
  SAIDA

  @@schema("public")
}

enum OrigemMovimentoSilo {
  COLHEITA
  NUTRICAO
  VENDA
  AJUSTE

  @@schema("public")
}

model SafraCultivo {
  id            Int                 @id @default(autoincrement())
  cultura       Cultura
  nome          String
  ano           Int
  dataInicio    DateTime            @db.Date
  dataFim       DateTime?           @db.Date
  areaHaTotal   Decimal?            @db.Decimal(10, 2) // usado quando não há AreaCultivo
  fechada       Boolean             @default(false)
  observacao    String?
  areas         AreaCultivo[]
  custos        LancamentoCusto[]
  producoes     ProducaoCultivo[]
  resumo        ResumoSafraCultivo?
  // Escopo de propriedade (Fatia 4C). Nullable + default principal.
  propriedade   Propriedade?        @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([cultura, ano])
  @@index([propriedadeId])
  @@schema("public")
}

model AreaCultivo {
  id             Int               @id @default(autoincrement())
  safraCultivo   SafraCultivo      @relation(fields: [safraCultivoId], references: [id], onDelete: Cascade)
  safraCultivoId Int
  codigo         String
  nome           String?
  areaHa         Decimal           @db.Decimal(10, 2)
  custos         LancamentoCusto[]
  producoes      ProducaoCultivo[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([safraCultivoId, codigo])
  @@schema("public")
}

model LancamentoCusto {
  id                   Int                    @id @default(autoincrement())
  safraCultivo         SafraCultivo           @relation(fields: [safraCultivoId], references: [id], onDelete: Cascade)
  safraCultivoId       Int
  area                 AreaCultivo?           @relation(fields: [areaCultivoId], references: [id])
  areaCultivoId        Int?
  tipo                 TipoCustoCultivo
  classe               ClassificacaoCategoria @default(CUSTEIO)
  data                 DateTime               @db.Date
  descricao            String
  valor                Decimal                @db.Decimal(14, 2)
  qtd                  Decimal?               @db.Decimal(12, 3)
  unidade              String?
  horasMaquina         Decimal?               @db.Decimal(8, 2)
  numMaquinas          Int?
  numCaminhoes         Int?
  operacaoFinanceira   Operacao?              @relation(fields: [operacaoFinanceiraId], references: [id])
  operacaoFinanceiraId String?                @unique
  observacao           String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([safraCultivoId, data])
  @@index([classe])
  @@schema("public")
}

model ProducaoCultivo {
  id             Int              @id @default(autoincrement())
  safraCultivo   SafraCultivo     @relation(fields: [safraCultivoId], references: [id], onDelete: Cascade)
  safraCultivoId Int
  area           AreaCultivo?     @relation(fields: [areaCultivoId], references: [id])
  areaCultivoId  Int?
  data           DateTime         @db.Date
  tipo           TipoProducao
  quantidade     Decimal          @db.Decimal(12, 3)
  unidade        UnidadeProducao
  destino        DestinoProducao?
  silo           Silo?            @relation(fields: [siloId], references: [id])
  siloId         Int?
  observacao     String?
  movimentos     MovimentoSilo[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([safraCultivoId, data])
  @@schema("public")
}

model Silo {
  id            Int               @id @default(autoincrement())
  nome          String
  tipo          TipoSilo
  capacidade    Decimal?          @db.Decimal(12, 3)
  unidade       String
  saldoAtual    Decimal           @default(0) @db.Decimal(12, 3)
  ativo         Boolean           @default(true)
  movimentos    MovimentoSilo[]
  producoes     ProducaoCultivo[]
  // Escopo de propriedade (Fatia 4C). Nullable + default principal.
  propriedade   Propriedade?      @relation(fields: [propriedadeId], references: [id])
  propriedadeId Int?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([propriedadeId])
  @@schema("public")
}

model MovimentoSilo {
  id                Int                 @id @default(autoincrement())
  silo              Silo                @relation(fields: [siloId], references: [id], onDelete: Cascade)
  siloId            Int
  data              DateTime            @db.Date
  tipo              TipoMovimentoSilo
  quantidade        Decimal             @db.Decimal(12, 3)
  origem            OrigemMovimentoSilo
  producaoCultivo   ProducaoCultivo?    @relation(fields: [producaoCultivoId], references: [id])
  producaoCultivoId Int?
  observacao        String?
  createdAt         DateTime            @default(now())

  @@index([siloId, data])
  @@schema("public")
}

model ResumoSafraCultivo {
  id                 Int          @id @default(autoincrement())
  safraCultivo       SafraCultivo @relation(fields: [safraCultivoId], references: [id], onDelete: Cascade)
  safraCultivoId     Int          @unique
  custeioTotal       Decimal      @default(0) @db.Decimal(14, 2)
  investimentoTotal  Decimal      @default(0) @db.Decimal(14, 2)
  areaHa             Decimal      @default(0) @db.Decimal(10, 2)
  producaoGraoSc     Decimal      @default(0) @db.Decimal(12, 3)
  producaoSilagemTon Decimal      @default(0) @db.Decimal(12, 3)
  custoHa            Decimal?     @db.Decimal(14, 2)
  custoSaca          Decimal?     @db.Decimal(14, 2)
  custoTonelada      Decimal?     @db.Decimal(14, 2)
  horasMaquinaTotal  Decimal      @default(0) @db.Decimal(10, 2)
  atualizadoEm       DateTime     @updatedAt

  @@schema("public")
}

enum StatusUsuario {
  PENDENTE
  ATIVO
  INATIVO

  @@schema("public")
}

enum TipoToken {
  CONVITE
  RESET

  @@schema("public")
}

model Usuario {
  id                       Int                           @id @default(autoincrement())
  nome                     String
  email                    String                        @unique
  senhaHash                String?
  papel                    String
  abas                     String[]
  areas                    String[]                      @default(["financeiro", "rebanho", "agricultura", "gado_corte", "equipe"])
  flags                    String[]
  status                   StatusUsuario                 @default(PENDENTE)
  dono                     Boolean                       @default(false)
  ultimoAcesso             DateTime?
  sessoes                  Sessao[]
  tokens                   TokenAcesso[]
  operacoesCriadas         Operacao[]                    @relation("OperacaoCriador")
  rascunhosOperacoes       RascunhoOperacao[]
  relatoriosFinanceiros    RelatorioFinanceiro[]
  rascunhosRelatorios      RascunhoRelatorioFinanceiro[]
  transacoesCriadas        TransacaoFinanceira[]         @relation("TransacaoCriador")
  movimentosEstoqueCriados MovimentoEstoque[]            @relation("MovimentoEstoqueCriador")
  auditoriasFinanceiras    AuditoriaFinanceira[]
  periodosFechados         PeriodoFinanceiro[]           @relation("PeriodoFechadoPor")
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  // Pecuária v1 (schema pecuaria)
  pecAnimaisCriados           Animal[]                @relation("AnimalCriadoPor")
  pecRacasCriadas             Raca[]                  @relation("RacaCriadoPor")
  pecComposicoesCriadas       ComposicaoRacial[]      @relation("ComposicaoRacialCriadoPor")
  pecLotesCriados             Lote[]                  @relation("LoteCriadoPor")
  pecLocalizacoesCriadas      LocalizacaoAnimal[]     @relation("LocalizacaoAnimalCriadoPor")
  pecMovimentacoesCriadas     Movimentacao[]          @relation("MovimentacaoCriadoPor")
  pecCategoriasCriadas        CategoriaAnimal[]       @relation("CategoriaAnimalCriadoPor")
  pecCategoriasManuaisCriadas CategoriaManualAnimal[] @relation("CategoriaManualAnimalCriadoPor")
  pecDestinosCriados          DestinoAnimal[]         @relation("DestinoAnimalCriadoPor")
  pecBaixasCriadas            BaixaAnimal[]           @relation("BaixaAnimalCriadoPor")
  pecMotivosBaixaCriados      MotivoBaixa[]           @relation("MotivoBaixaCriadoPor")
  pecPesagensCriadas          Pesagem[]               @relation("PesagemCriadoPor")
  pecAuditoriasCriadas        AuditoriaPecuaria[]     @relation("AuditoriaPecuariaCriadoPor")
  pecAuditoriasAutor          AuditoriaPecuaria[]     @relation("AuditoriaPecuariaUsuario")
  // Pecuária v2 (genética)
  pecGenitoresCriados         GenitorExterno[]        @relation("GenitorExternoCriadoPor")
  pecMateriaisCriados         MaterialGenetico[]      @relation("MaterialGeneticoCriadoPor")

  @@schema("public")
}

model Sessao {
  id        String   @id @default(cuid())
  usuarioId Int
  tokenHash String   @unique
  expiraEm  DateTime
  ultimoUso DateTime @default(now())
  userAgent String?
  criadaEm  DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@schema("public")
}

model TokenAcesso {
  id        String    @id @default(cuid())
  usuarioId Int
  tipo      TipoToken
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@schema("public")
}

// =============================================================================
// PECUÁRIA v1 — REBANHO (schema Postgres `pecuaria`)
// Substitui o módulo legado de rebanho/corte (removido do schema `public`).
// Nada faz cascade a partir do animal.
// =============================================================================

enum SexoBovino {
  F
  M

  @@schema("pecuaria")
}

enum OrigemAnimal {
  NASCIDO
  COMPRADO

  @@schema("pecuaria")
}

enum AptidaoAnimal {
  LEITE
  CORTE

  @@schema("pecuaria")
}

enum PapelReprodutivo {
  NENHUM
  RECEPTORA
  DOADORA

  @@schema("pecuaria")
}

// O que aconteceu com o animal (fixo). O porquê fica no MotivoBaixa, classificado por ClasseMotivoBaixa.
// CADASTRO_INDEVIDO é interno: só o "excluir cadastro" usa.
enum TipoBaixa {
  VENDA
  ABATE
  MORTE
  DOACAO
  EXTRAVIO
  CADASTRO_INDEVIDO

  @@schema("pecuaria")
}

// Classe do motivo de baixa (equivale ao TIPOBAIXA do IDEAGRI). Venda/abate/doação aceitam os
// descartes; morte aceita MORTE; extravio e cadastro indevido não aceitam motivo (baixa.calc.ts).
enum ClasseMotivoBaixa {
  DESCARTE_VOLUNTARIO
  DESCARTE_INVOLUNTARIO
  MORTE

  @@schema("pecuaria")
}

enum TipoPesagem {
  NASCIMENTO
  ENTRADA
  DESMAMA
  ROTINA
  SAIDA

  @@schema("pecuaria")
}

enum OrigemPesagem {
  MANUAL
  BALANCA

  @@schema("pecuaria")
}

// Critério de partos de uma regra de categoria.
enum CriterioPartos {
  QUALQUER
  SEM
  COM

  @@schema("pecuaria")
}

enum OrigemComposicao {
  INFORMADA
  CALCULADA

  @@schema("pecuaria")
}

// Quem o animal é: identidade estável. Onde está, para que serve e se teve baixa
// vivem em tabelas de histórico próprias (Localizacao/Destino/Baixa).
model Animal {
  id                   String          @id @default(uuid())
  ideagriId            Int?            @unique
  brinco               String
  nome                 String?
  brincoEletronico     String?         @unique
  sisbov               String?         @unique
  sexo                 SexoBovino
  dataNascimento       DateTime        @db.Date
  nascimentoEstimado   Boolean         @default(false)
  origem               OrigemAnimal
  // = dataNascimento quando origem NASCIDO
  dataEntrada          DateTime        @db.Date
  partosAntesDaEntrada Int             @default(0)
  observacao           String?
  // Filiação (v2): cada lado aponta para um animal nosso OU para um genitor externo, nunca
  // os dois (CHECK na migration). Filiação é identidade, não histórico.
  maeId                String?
  mae                  Animal?         @relation("AnimalMae", fields: [maeId], references: [id], onDelete: Restrict)
  paiId                String?
  pai                  Animal?         @relation("AnimalPai", fields: [paiId], references: [id], onDelete: Restrict)
  maeExternaId         String?
  maeExterna           GenitorExterno? @relation("AnimalMaeExterna", fields: [maeExternaId], references: [id], onDelete: Restrict)
  paiExternoId         String?
  paiExterno           GenitorExterno? @relation("AnimalPaiExterno", fields: [paiExternoId], references: [id], onDelete: Restrict)
  criadoEm             DateTime        @default(now())
  criadoPorId          Int?
  criadoPor            Usuario?        @relation("AnimalCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm         DateTime        @updatedAt

  composicao           ComposicaoRacial[]
  localizacoes         LocalizacaoAnimal[]
  destinos             DestinoAnimal[]
  baixas               BaixaAnimal[]
  pesagens             Pesagem[]
  movimentacoes        MovimentacaoAnimal[]
  categoriasManuais    CategoriaManualAnimal[]
  filhosComoMae        Animal[]                @relation("AnimalMae")
  filhosComoPai        Animal[]                @relation("AnimalPai")
  materiaisComoTouro   MaterialGenetico[]      @relation("MaterialTouro")
  materiaisComoDoadora MaterialGenetico[]      @relation("MaterialDoadora")

  @@index([brinco])
  @@index([maeId])
  @@index([paiId])
  @@index([maeExternaId])
  @@index([paiExternoId])
  @@schema("pecuaria")
}

enum TipoMaterialGenetico {
  SEMEN
  EMBRIAO

  @@schema("pecuaria")
}

enum TipoSemen {
  CONVENCIONAL
  SEXADO_FEMEA
  SEXADO_MACHO

  @@schema("pecuaria")
}

// Genitor que não é animal da fazenda: touro de central (M) ou doadora de outra fazenda (F).
// Só dado genético — sem brinco, lote, peso ou baixa. Animal nosso é genitor pela própria ficha.
model GenitorExterno {
  id           String     @id @default(uuid())
  ideagriId    Int?       @unique
  sexo         SexoBovino
  nome         String
  codigo       String?
  fornecedor   String?
  fornecedorId String?
  fornecedorParceiro Parceiro? @relation(fields: [fornecedorId], references: [id], onDelete: SetNull)
  ativo        Boolean    @default(true)
  observacao   String?
  criadoEm     DateTime   @default(now())
  criadoPorId  Int?
  criadoPor    Usuario?   @relation("GenitorExternoCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm DateTime   @updatedAt

  composicao           ComposicaoGenitorExterno[]
  filhosComoMae        Animal[]                   @relation("AnimalMaeExterna")
  filhosComoPai        Animal[]                   @relation("AnimalPaiExterno")
  materiaisComoTouro   MaterialGenetico[]         @relation("MaterialTouroExterno")
  materiaisComoDoadora MaterialGenetico[]         @relation("MaterialDoadoraExterna")

  @@index([sexo, nome])
  @@index([fornecedorId])
  @@schema("pecuaria")
}

// Grau de sangue do genitor externo em 64 avos (espelho de ComposicaoRacial).
model ComposicaoGenitorExterno {
  id        String         @id @default(uuid())
  genitorId String
  genitor   GenitorExterno @relation(fields: [genitorId], references: [id], onDelete: Cascade)
  racaId    String
  raca      Raca           @relation(fields: [racaId], references: [id], onDelete: Restrict)
  fracao64  Int

  @@unique([genitorId, racaId])
  @@index([racaId])
  @@schema("pecuaria")
}

// Identidade genética de um produto do estoque (sêmen ou embrião). O produto diz quanto
// tem, quanto custou e onde está; esta linha diz de quem é. Consumo (IA/TE) entra na v4.
model MaterialGenetico {
  id               String               @id @default(uuid())
  tipo             TipoMaterialGenetico
  tipoSemen        TipoSemen?
  touroId          String?
  touro            Animal?              @relation("MaterialTouro", fields: [touroId], references: [id], onDelete: Restrict)
  touroExternoId   String?
  touroExterno     GenitorExterno?      @relation("MaterialTouroExterno", fields: [touroExternoId], references: [id], onDelete: Restrict)
  doadoraId        String?
  doadora          Animal?              @relation("MaterialDoadora", fields: [doadoraId], references: [id], onDelete: Restrict)
  doadoraExternaId String?
  doadoraExterna   GenitorExterno?      @relation("MaterialDoadoraExterna", fields: [doadoraExternaId], references: [id], onDelete: Restrict)
  produtoId        String               @unique
  produto          Produto              @relation(fields: [produtoId], references: [id], onDelete: Restrict)
  observacao       String?
  criadoEm         DateTime             @default(now())
  criadoPorId      Int?
  criadoPor        Usuario?             @relation("MaterialGeneticoCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm     DateTime             @updatedAt

  @@index([touroId])
  @@index([touroExternoId])
  @@index([doadoraId])
  @@index([doadoraExternaId])
  @@schema("pecuaria")
}

// Categoria do animal, configurável pela fazenda. Uma categoria "automática" tem regra
// (sexo + faixa de idade + partos) avaliada em `ordem` — a primeira que casa vence; uma não
// automática só é atribuída manualmente (CategoriaManualAnimal). Os itens de fábrica são as
// categorias do IDEAGRI (`ideagriId` 1–7) e guardam `chavePadrao` para "Restaurar padrões".
// A categoria nunca é gravada no Animal — ver categoria.calc.ts (inclui a nota das dimensões futuras).
model CategoriaAnimal {
  id            String         @id @default(uuid())
  ideagriId     Int?           @unique
  chavePadrao   String?        @unique
  nome          String
  sexo          SexoBovino
  automatica    Boolean        @default(true)
  idadeMinMeses Int?
  // exclusivo: idade < idadeMaxMeses
  idadeMaxMeses Int?
  partos        CriterioPartos @default(QUALQUER)
  ordem         Int            @default(0)
  ativo         Boolean        @default(true)
  criadoEm      DateTime       @default(now())
  criadoPorId   Int?
  criadoPor     Usuario?       @relation("CategoriaAnimalCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm  DateTime       @updatedAt

  manuais CategoriaManualAnimal[]

  @@unique([sexo, nome])
  @@schema("pecuaria")
}

// Categoria forçada manualmente, com histórico: a linha com `ate` nulo vale sobre o cálculo
// (no máximo uma aberta por animal — índice parcial na migration). Voltar ao automático fecha a linha.
model CategoriaManualAnimal {
  id                 String          @id @default(uuid())
  animalId           String
  animal             Animal          @relation(fields: [animalId], references: [id], onDelete: Restrict)
  categoriaId        String
  categoria          CategoriaAnimal @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  desde              DateTime        @db.Date
  ate                DateTime?       @db.Date
  motivo             String
  motivoEncerramento String?
  criadoEm           DateTime        @default(now())
  criadoPorId        Int?
  criadoPor          Usuario?        @relation("CategoriaManualAnimalCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm       DateTime        @updatedAt

  @@index([animalId, ate])
  @@index([categoriaId, ate])
  @@schema("pecuaria")
}

// Catálogo de raças. Composta (ex.: Girolando) só entra na composição quando o
// grau de sangue é desconhecido.
model Raca {
  id           String   @id @default(uuid())
  ideagriId    Int?     @unique
  nome         String
  sigla        String
  base         Boolean  @default(true)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  criadoPorId  Int?
  criadoPor    Usuario? @relation("RacaCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm DateTime @updatedAt

  composicoes          ComposicaoRacial[]
  composicoesGenitores ComposicaoGenitorExterno[]

  @@schema("pecuaria")
}

// Grau de sangue do animal em 64 avos por raça. Soma ≤ 64; o resto é desconhecido.
model ComposicaoRacial {
  id           String           @id @default(uuid())
  animalId     String
  animal       Animal           @relation(fields: [animalId], references: [id], onDelete: Restrict)
  racaId       String
  raca         Raca             @relation(fields: [racaId], references: [id], onDelete: Restrict)
  fracao64     Int
  // Parcela herdada dos genitores dentro de fracao64; o restante foi informado.
  fracaoCalculada64 Int @default(0)
  origem       OrigemComposicao
  criadoEm     DateTime         @default(now())
  criadoPorId  Int?
  criadoPor    Usuario?         @relation("ComposicaoRacialCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm DateTime         @updatedAt

  @@unique([animalId, racaId])
  @@index([racaId])
  @@schema("pecuaria")
}

// Cadastro do lote (GRUPOANIMAL do IDEAGRI). Pertence a um sítio.
model Lote {
  id            String      @id @default(uuid())
  ideagriId     Int?        @unique
  nome          String
  propriedadeId Int
  propriedade   Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Restrict)
  ativo         Boolean     @default(true)
  observacao    String?
  criadoEm      DateTime    @default(now())
  criadoPorId   Int?
  criadoPor     Usuario?    @relation("LoteCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm  DateTime    @updatedAt

  localizacoes       LocalizacaoAnimal[]
  movimentacoes      Movimentacao[]
  saidasMovimentacao MovimentacaoAnimal[]

  @@unique([propriedadeId, nome])
  @@schema("pecuaria")
}

// Onde o animal está (sítio + lote opcional), com histórico. Linha com `ate`
// nulo = localização atual; no máximo uma aberta por animal (índice parcial na migration).
model LocalizacaoAnimal {
  id                String              @id @default(uuid())
  animalId          String
  animal            Animal              @relation(fields: [animalId], references: [id], onDelete: Restrict)
  propriedadeId     Int
  propriedade       Propriedade         @relation(fields: [propriedadeId], references: [id], onDelete: Restrict)
  loteId            String?
  lote              Lote?               @relation(fields: [loteId], references: [id], onDelete: Restrict)
  desde             DateTime            @db.Date
  ate               DateTime?           @db.Date
  // movimentação que abriu esta linha (1 ou N animais); vazio = linha inicial do cadastro/carga
  movimentacaoId    String?
  movimentacao      Movimentacao?       @relation(fields: [movimentacaoId], references: [id], onDelete: Restrict)
  criadoEm          DateTime            @default(now())
  criadoPorId       Int?
  criadoPor         Usuario?            @relation("LocalizacaoAnimalCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm      DateTime            @updatedAt
  baixasQueFecharam BaixaAnimal[]       @relation("BaixaLocalizacaoFechada")
  itemMovimentacao  MovimentacaoAnimal?

  @@index([animalId, ate])
  @@index([propriedadeId, ate])
  @@index([loteId, ate])
  @@index([movimentacaoId])
  @@schema("pecuaria")
}

// Uma movimentação: 1 ou N animais levados ao mesmo destino na mesma data. Cada animal
// ganha uma LocalizacaoAnimal apontando para cá. Desfazer remove essas linhas, reabre as
// anteriores e marca `desfeitaEm` — a movimentação fica como histórico, como um estorno.
model Movimentacao {
  id                   String      @id @default(uuid())
  data                 DateTime    @db.Date
  propriedadeDestinoId Int
  propriedadeDestino   Propriedade @relation(fields: [propriedadeDestinoId], references: [id], onDelete: Restrict)
  loteDestinoId        String?
  loteDestino          Lote?       @relation(fields: [loteDestinoId], references: [id], onDelete: Restrict)
  motivo               String?
  // quantos animais foram movidos (fixo; desfazer animal a animal não altera)
  quantidade           Int
  desfeitaEm           DateTime?
  desfeitaMotivo       String?
  criadoEm             DateTime    @default(now())
  criadoPorId          Int?
  criadoPor            Usuario?    @relation("MovimentacaoCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm         DateTime    @updatedAt

  localizacoes LocalizacaoAnimal[]
  animais      MovimentacaoAnimal[]

  @@index([loteDestinoId, data])
  @@index([propriedadeDestinoId, data])
  @@index([data])
  @@schema("pecuaria")
}

// Itens da movimentação: um por animal movido, com a origem (onde estava) gravada. Nunca é
// apagado — desfazer marca `desfeitoEm`, e `localizacaoId` fica nulo quando a linha aberta pela
// movimentação é removida. É o registro permanente de quem foi movido, de onde e para onde.
model MovimentacaoAnimal {
  id                  String             @id @default(uuid())
  movimentacaoId      String
  movimentacao        Movimentacao       @relation(fields: [movimentacaoId], references: [id], onDelete: Restrict)
  animalId            String
  animal              Animal             @relation(fields: [animalId], references: [id], onDelete: Restrict)
  origemPropriedadeId Int?
  origemPropriedade   Propriedade?       @relation(fields: [origemPropriedadeId], references: [id], onDelete: Restrict)
  origemLoteId        String?
  origemLote          Lote?              @relation(fields: [origemLoteId], references: [id], onDelete: Restrict)
  localizacaoId       String?            @unique
  localizacao         LocalizacaoAnimal? @relation(fields: [localizacaoId], references: [id], onDelete: SetNull)
  desfeitoEm          DateTime?
  criadoEm            DateTime           @default(now())

  @@unique([movimentacaoId, animalId])
  @@index([animalId])
  @@index([origemLoteId])
  @@index([origemPropriedadeId])
  @@schema("pecuaria")
}

// Para que o animal serve (aptidão + papel reprodutivo), com histórico. Mudar
// qualquer um fecha a linha e abre outra.
model DestinoAnimal {
  id               String           @id @default(uuid())
  animalId         String
  animal           Animal           @relation(fields: [animalId], references: [id], onDelete: Restrict)
  aptidao          AptidaoAnimal
  papelReprodutivo PapelReprodutivo @default(NENHUM)
  desde            DateTime         @db.Date
  ate              DateTime?        @db.Date
  criadoEm         DateTime         @default(now())
  criadoPorId      Int?
  criadoPor        Usuario?         @relation("DestinoAnimalCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm     DateTime         @updatedAt

  baixasQueFecharam BaixaAnimal[] @relation("BaixaDestinoFechado")

  @@index([animalId, ate])
  @@schema("pecuaria")
}

// Baixa do rebanho. Baixa não estornada = animal inativo; estorno preserva a linha.
model BaixaAnimal {
  id                   String             @id @default(uuid())
  ideagriId            Int?               @unique
  animalId             String
  animal               Animal             @relation(fields: [animalId], references: [id], onDelete: Restrict)
  data                 DateTime           @db.Date
  tipo                 TipoBaixa
  motivoId             String?
  motivo               MotivoBaixa?       @relation(fields: [motivoId], references: [id], onDelete: Restrict)
  observacao           String?
  estornadaEm          DateTime?
  estornoMotivo        String?
  // linhas de histórico que ESTA baixa fechou — o estorno reabre exatamente essas
  // (não dá para deduzir pela data: uma movimentação no mesmo dia também fecha linha com o mesmo `ate`).
  // SetNull: a baixa ativa é protegida pelo app (desfazer recusa); a estornada perde o vínculo
  // quando a linha é apagada por um desfazer posterior (a auditoria guarda o antes).
  localizacaoFechadaId String?
  localizacaoFechada   LocalizacaoAnimal? @relation("BaixaLocalizacaoFechada", fields: [localizacaoFechadaId], references: [id], onDelete: SetNull)
  destinoFechadoId     String?
  destinoFechado       DestinoAnimal?     @relation("BaixaDestinoFechado", fields: [destinoFechadoId], references: [id], onDelete: SetNull)
  criadoEm             DateTime           @default(now())
  criadoPorId          Int?
  criadoPor            Usuario?           @relation("BaixaAnimalCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm         DateTime           @updatedAt

  @@index([animalId])
  @@index([data])
  @@index([localizacaoFechadaId])
  @@index([destinoFechadoId])
  @@schema("pecuaria")
}

// Catálogo de motivos de baixa (o porquê), classificado por classe — não por tipo:
// o mesmo motivo de descarte serve para venda, abate ou doação.
model MotivoBaixa {
  id           String            @id @default(uuid())
  ideagriId    Int?              @unique
  nome         String
  classe       ClasseMotivoBaixa
  ativo        Boolean           @default(true)
  criadoEm     DateTime          @default(now())
  criadoPorId  Int?
  criadoPor    Usuario?          @relation("MotivoBaixaCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm DateTime          @updatedAt

  baixas BaixaAnimal[]

  @@schema("pecuaria")
}

// Pesagem individual. GMD e peso atual são calculados, não armazenados.
model Pesagem {
  id           String        @id @default(uuid())
  ideagriId    Int?          @unique
  animalId     String
  animal       Animal        @relation(fields: [animalId], references: [id], onDelete: Restrict)
  data         DateTime      @db.Date
  pesoKg       Decimal       @db.Decimal(7, 2)
  tipo         TipoPesagem
  origem       OrigemPesagem @default(MANUAL)
  observacao   String?
  criadoEm     DateTime      @default(now())
  criadoPorId  Int?
  criadoPor    Usuario?      @relation("PesagemCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm DateTime      @updatedAt

  @@index([animalId, data])
  @@schema("pecuaria")
}

// Trilha de toda mutação da pecuária (padrão de AuditoriaFinanceira).
model AuditoriaPecuaria {
  id           String   @id @default(uuid())
  entidade     String
  entidadeId   String
  // Animal a que o registro se refere (também para linhas já apagadas: pesagem excluída,
  // movimentação desfeita), para a trilha do animal não depender da linha ainda existir.
  animalId     String?
  acao         String
  antes        Json?
  depois       Json?
  usuarioId    Int?
  usuario      Usuario? @relation("AuditoriaPecuariaUsuario", fields: [usuarioId], references: [id])
  em           DateTime @default(now())
  criadoEm     DateTime @default(now())
  criadoPorId  Int?
  criadoPor    Usuario? @relation("AuditoriaPecuariaCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoEm DateTime @updatedAt

  @@index([entidade, entidadeId])
  @@index([animalId, em])
  @@index([em])
  @@schema("pecuaria")
}
